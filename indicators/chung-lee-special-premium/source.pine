//@version=5
indicator(title="Chung Lee Special Premium", shorttitle="Chung Lee Special Premium", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=4000)

//=================================================================================================================
// SECTION 0 – UNIVERSAL TIMEFRAME VARIABLES
//=================================================================================================================
isLowTimeframe1         = timeframe.isintraday and timeframe.multiplier <= 1
isLowTimeframe1_1       = timeframe.isintraday and timeframe.multiplier > 0
isLowTimeframe3         = timeframe.isintraday and timeframe.multiplier <= 3
isLowTimeframe3_3       = timeframe.isintraday and timeframe.multiplier > 3
isLowTimeframe5         = timeframe.isintraday and timeframe.multiplier <= 5
isLowTimeframe5_5       = timeframe.isintraday and timeframe.multiplier > 5
isLowTimeframe15        = timeframe.isintraday and timeframe.multiplier <= 15
isLowTimeframe15_15     = timeframe.isintraday and timeframe.multiplier > 15
isLowTimeframe30        = timeframe.isintraday and timeframe.multiplier <= 30
isLowTimeframe30_30     = timeframe.isintraday and timeframe.multiplier > 30
isLowTimeframe60        = timeframe.isintraday and timeframe.multiplier <= 60
isLowTimeframe60_60     = timeframe.isintraday and timeframe.multiplier > 60
isLowTimeframe120       = timeframe.isintraday and timeframe.multiplier <= 120
isLowTimeframe120_120   = timeframe.isintraday and timeframe.multiplier > 120
isLowTimeframe180       = timeframe.isintraday and timeframe.multiplier <= 180
isLowTimeframe180_180   = timeframe.isintraday and timeframe.multiplier > 180
isLowTimeframe240       = timeframe.isintraday and timeframe.multiplier <= 240
isLowTimeframe240_240   = timeframe.isintraday and timeframe.multiplier > 240
isLowTimeframe720       = timeframe.isintraday and timeframe.multiplier <= 720
isLowTimeframe720_720   = timeframe.isintraday and timeframe.multiplier > 720
isLowTimeframe1440      = timeframe.isdaily and timeframe.multiplier <= 1
isLowTimeframe1440_1440 = timeframe.isdaily and timeframe.multiplier > 1
isLowTimeframeWeek      = timeframe.isweekly
isLowTimeframeMonth     = timeframe.ismonthly
isLowTimeframe3M        = timeframe.ismonthly and timeframe.multiplier <= 3

//=================================================================================================================
// SECTION 0.5 – CENTRALIZED CHART TIMEFRAME FILTERING
//=================================================================================================================
chartTimeframeMinutes = timeframe.in_seconds(timeframe.period) / 60.0
isChart1to5   = chartTimeframeMinutes >= 1 and chartTimeframeMinutes <= 5
isChart6to15  = chartTimeframeMinutes >= 6 and chartTimeframeMinutes <= 15
isChart16Plus = chartTimeframeMinutes >= 16

f_overlay_window_ok(selection) =>
    selection == "1-5 min" ? isChart1to5 :
     selection == "6-15 min" ? isChart6to15 :
     selection == "16 min+" ? isChart16Plus :
     selection == "1-15 min" ? (isChart1to5 or isChart6to15) :
     selection == "All chart timeframes" ? true : false

//=================================================================================================================
// SECTION 1 – INPUTS & MENU SETTINGS
//=================================================================================================================
groupOverlays    = "HTF Candle Overlays"
groupLabels      = "Overlay Labels"
groupMA          = "Moving Average Suite"
groupFA          = "MA Fill and Cross Alerts"
groupBB          = "Bollinger Bands"
groupSessions    = "Session Highlighting"
groupFutures     = "Futures Value Panel"
groupStackZones  = "Daily / 4H Stack Zones"
groupWeeklyStackZones = "Weekly / Daily Stack Zones"
groupMonthlyStackZones = "Monthly / Daily Stack Zones"
groupH1GapZones  = "H1 Sweep Gap Zones"
groupZoneAlerts  = "Zone Alerts"
groupHtfDistanceTable = "HTF Distance Table"

showHourlyOverlay   = input.bool(true, "Show 1H Overlay", group=groupOverlays, inline="ov1", tooltip="Higher-timeframe candle overlays.\n\nUse the master toggles to enable 1H / 4H / Daily overlays.\nUse the timeframe filters to decide which chart timeframes each overlay can appear on.\nOverlay Lookback limits how far back closed and live overlay objects are allowed to draw.")
showFourHourOverlay = input.bool(true, "Show 4H Overlay", group=groupOverlays, inline="ov2")
showDailyOverlay    = input.bool(true, "Show Daily Overlay", group=groupOverlays, inline="ov3")

hourlyFilterEnabled   = input.bool(true, "Enable timeframe filter", group=groupOverlays, inline="flt1")
hourlyWindow          = input.string("1-15 min", "Show this overlay on", options=["1-5 min", "6-15 min", "1-15 min", "16 min+", "All chart timeframes"], group=groupOverlays, inline="flt1")
fourHourFilterEnabled = input.bool(true, "Enable timeframe filter", group=groupOverlays, inline="flt2")
fourHourWindow        = input.string("1-15 min", "Show this overlay on", options=["1-5 min", "6-15 min", "1-15 min", "16 min+", "All chart timeframes"], group=groupOverlays, inline="flt2")
dailyFilterEnabled    = input.bool(true, "Enable timeframe filter", group=groupOverlays, inline="flt3")
dailyWindow           = input.string("1-15 min", "Show this overlay on", options=["1-5 min", "6-15 min", "1-15 min", "16 min+", "All chart timeframes"], group=groupOverlays, inline="flt3")

overlayLookbackDays = input.int(250, "Overlay Lookback (Days)", group=groupOverlays, inline="lb1")
codedLookbackTime   = 1000 * 60 * 60 * 24 * (overlayLookbackDays + 1)
AllowedTime         = time >= timenow - codedLookbackTime

BullishCandleColor       = input.color(#b49c0025, "Bull Candle Fill", group=groupOverlays, inline="clr1")
BearishCandleColor       = input.color(#acacac25, "Bear Candle Fill", group=groupOverlays, inline="clr1")
