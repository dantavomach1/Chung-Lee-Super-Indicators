    if clShowH1GapLabels
        clUpperH1GapLabel := f_update_zone_label(clUpperH1GapLabel, clZoneRightTime, (h1UpperGapTop + h1UpperGapBottom) / 2.0, "Upper H1 Sweep Gap", clH1GapLabelTextColor, f_zone_label_size(clH1GapLabelSizeInput))
    else
        if not na(clUpperH1GapLabel)
            label.delete(clUpperH1GapLabel)
