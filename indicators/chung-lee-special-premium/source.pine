        lowerStackPointsY = clBreakoutZoneFittedMode ? (clPreviousDayLow + lowerStackFittedTop) / 2.0 : (lowerStackTop + lowerStackBottom) / 2.0
        clLowerStackPointsLabel := f_update_points_label(clLowerStackPointsLabel, lowerStackPointsX, lowerStackPointsY, f_zone_points_text(clBreakoutZoneFittedMode ? lowerStackFittedTop : lowerStackTop, clBreakoutZoneFittedMode ? clPreviousDayLow : lowerStackBottom, "daily"), clPointsTillBreakLabelTextColor, f_zone_label_size(clPointsTillBreakLabelSizeInput))
    else
        if not na(clLowerStackPointsLabel)
            label.delete(clLowerStackPointsLabel)
            clLowerStackPointsLabel := na
    if clShowStackAnchorMarkers
        clPrevDayLowAnchorLabel := f_update_anchor_label(clPrevDayLowAnchorLabel, clPreviousDayLowTime, clPreviousDayLow, "Prior Day Low point", clStackLabelTextColor, label.style_label_up)
        clClosed4HLowAnchorLabel := f_update_anchor_label(clClosed4HLowAnchorLabel, clLatestClosed4HLowTime, clLatestClosed4HLow, "Latest Closed 4H Low point", clStackLabelTextColor, label.style_label_up)
    else
        if not na(clPrevDayLowAnchorLabel)
            label.delete(clPrevDayLowAnchorLabel)
            clPrevDayLowAnchorLabel := na
        if not na(clClosed4HLowAnchorLabel)
            label.delete(clClosed4HLowAnchorLabel)
            clClosed4HLowAnchorLabel := na
else
    if not na(clLowerStackBox)
        box.delete(clLowerStackBox)
        clLowerStackBox := na
    if not na(clLowerStackLabel)
        label.delete(clLowerStackLabel)
        clLowerStackLabel := na
    if not na(clLowerStackPointsLabel)
        label.delete(clLowerStackPointsLabel)
        clLowerStackPointsLabel := na
    if not na(clPrevDayLowAnchorLabel)
        label.delete(clPrevDayLowAnchorLabel)
        clPrevDayLowAnchorLabel := na
    if not na(clClosed4HLowAnchorLabel)
        label.delete(clClosed4HLowAnchorLabel)
        clClosed4HLowAnchorLabel := na

if weeklyUpperStackActive
    if clBreakoutZoneFittedMode
        if not na(clWeeklyUpperStackBox)
            box.delete(clWeeklyUpperStackBox)
            clWeeklyUpperStackBox := na
    else if clBreakoutZoneFloatingMode
        clWeeklyUpperStackBox := f_update_zone_box_index(clWeeklyUpperStackBox, bar_index - clFloatingWindowBarsBack, bar_index + clFloatingWindowBarsForward, weeklyUpperStackTop, weeklyUpperStackBottom, clWeeklyStackUpperBg, clWeeklyStackBorder, clWeeklyDailyStackBorderWidth)
    else if clBreakoutZoneAnchoredMode
        clWeeklyUpperStackBox := f_update_zone_box(clWeeklyUpperStackBox, weeklyUpperLeftTime, weeklyUpperRightTime, weeklyUpperStackTop, weeklyUpperStackBottom, clWeeklyStackUpperBg, clWeeklyStackBorder, clWeeklyDailyStackBorderWidth, clExtendWeeklyDailyStackZonesRight)
    if clShowWeeklyDailyStackLabels
        clWeeklyUpperStackLabel := f_update_zone_label(clWeeklyUpperStackLabel, clZoneRightTime, (weeklyUpperStackTop + weeklyUpperStackBottom) / 2.0, "Upper Weekly Breakout", clWeeklyDailyStackLabelTextColor, f_zone_label_size(clWeeklyDailyStackLabelSizeInput))
    else
        if not na(clWeeklyUpperStackLabel)
            label.delete(clWeeklyUpperStackLabel)
            clWeeklyUpperStackLabel := na
    if clShowPointsTillBreakLabels
        weeklyUpperPointsX = clBreakoutZoneFloatingMode ? f_floating_points_label_x() : f_points_label_x(weeklyUpperLeftBarIndex, weeklyUpperRightBarIndex, clExtendWeeklyDailyStackZonesRight)
        weeklyUpperPointsY = clBreakoutZoneFittedMode ? (clPreviousWeekHigh + weeklyUpperFittedBottom) / 2.0 : (weeklyUpperStackTop + weeklyUpperStackBottom) / 2.0
        clWeeklyUpperStackPointsLabel := f_update_points_label(clWeeklyUpperStackPointsLabel, weeklyUpperPointsX, weeklyUpperPointsY, f_zone_points_text(clBreakoutZoneFittedMode ? clPreviousWeekHigh : weeklyUpperStackTop, clBreakoutZoneFittedMode ? weeklyUpperFittedBottom : weeklyUpperStackBottom, "weekly"), clPointsTillBreakLabelTextColor, f_zone_label_size(clPointsTillBreakLabelSizeInput))
    else
        if not na(clWeeklyUpperStackPointsLabel)
            label.delete(clWeeklyUpperStackPointsLabel)
            clWeeklyUpperStackPointsLabel := na
else
    if not na(clWeeklyUpperStackBox)
        box.delete(clWeeklyUpperStackBox)
        clWeeklyUpperStackBox := na
    if not na(clWeeklyUpperStackLabel)
        label.delete(clWeeklyUpperStackLabel)
        clWeeklyUpperStackLabel := na
    if not na(clWeeklyUpperStackPointsLabel)
