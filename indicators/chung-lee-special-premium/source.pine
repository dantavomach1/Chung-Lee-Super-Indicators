var box clRetainedLowerH1GapBox = na
var box clRetainedUpperFourHourBreakoutBox = na
var box clRetainedLowerFourHourBreakoutBox = na

var box[] clUpperStackFillBoxes = array.new_box()
var box[] clLowerStackFillBoxes = array.new_box()
var box[] clWeeklyUpperStackFillBoxes = array.new_box()
var box[] clWeeklyLowerStackFillBoxes = array.new_box()
