    else if clBreakoutZoneFloatingMode
        clMonthlyLowerStackBox := f_update_zone_box_index(clMonthlyLowerStackBox, bar_index - clFloatingWindowBarsBack, bar_index + clFloatingWindowBarsForward, monthlyLowerStackTop, monthlyLowerStackBottom, clMonthlyStackLowerBg, clMonthlyStackBorder, clMonthlyDailyStackBorderWidth)
    else if clBreakoutZoneAnchoredMode
        clMonthlyLowerStackBox := f_update_zone_box(clMonthlyLowerStackBox, monthlyLowerLeftTime, monthlyLowerRightTime, monthlyLowerStackTop, monthlyLowerStackBottom, clMonthlyStackLowerBg, clMonthlyStackBorder, clMonthlyDailyStackBorderWidth, clExtendMonthlyDailyStackZonesRight)
    if clShowMonthlyDailyStackLabels
        clMonthlyLowerStackLabel := f_update_zone_label(clMonthlyLowerStackLabel, clZoneRightTime, (monthlyLowerStackTop + monthlyLowerStackBottom) / 2.0, "Lower Monthly Breakout", clMonthlyDailyStackLabelTextColor, f_zone_label_size(clMonthlyDailyStackLabelSizeInput))
    else
        if not na(clMonthlyLowerStackLabel)
            label.delete(clMonthlyLowerStackLabel)
            clMonthlyLowerStackLabel := na
    if clShowPointsTillBreakLabels
        monthlyLowerPointsX = clBreakoutZoneFloatingMode ? f_floating_points_label_x() : f_points_label_x(monthlyLowerLeftBarIndex, monthlyLowerRightBarIndex, clExtendMonthlyDailyStackZonesRight)
        monthlyLowerPointsY = clBreakoutZoneFittedMode ? (clPreviousMonthLow + monthlyLowerFittedTop) / 2.0 : (monthlyLowerStackTop + monthlyLowerStackBottom) / 2.0
        clMonthlyLowerStackPointsLabel := f_update_points_label(clMonthlyLowerStackPointsLabel, monthlyLowerPointsX, monthlyLowerPointsY, f_zone_points_text(clBreakoutZoneFittedMode ? monthlyLowerFittedTop : monthlyLowerStackTop, clBreakoutZoneFittedMode ? clPreviousMonthLow : monthlyLowerStackBottom, "monthly"), clPointsTillBreakLabelTextColor, f_zone_label_size(clPointsTillBreakLabelSizeInput))
    else
        if not na(clMonthlyLowerStackPointsLabel)
            label.delete(clMonthlyLowerStackPointsLabel)
            clMonthlyLowerStackPointsLabel := na
else
    if not na(clMonthlyLowerStackBox)
        box.delete(clMonthlyLowerStackBox)
        clMonthlyLowerStackBox := na
    if not na(clMonthlyLowerStackLabel)
        label.delete(clMonthlyLowerStackLabel)
        clMonthlyLowerStackLabel := na
    if not na(clMonthlyLowerStackPointsLabel)
        label.delete(clMonthlyLowerStackPointsLabel)
        clMonthlyLowerStackPointsLabel := na

if clUpperH1GapVisible
    if clBreakoutZoneFittedMode
        if not na(clUpperH1GapBox)
            box.delete(clUpperH1GapBox)
            clUpperH1GapBox := na
    else if clBreakoutZoneFloatingMode
        clUpperH1GapBox := f_update_zone_box_index(clUpperH1GapBox, bar_index - clFloatingWindowBarsBack, bar_index + clFloatingWindowBarsForward, h1UpperGapTop, h1UpperGapBottom, clH1UpperBg, clH1Border, clH1GapBorderWidth)
    else if clBreakoutZoneAnchoredMode
        clUpperH1GapBox := f_update_zone_box(clUpperH1GapBox, clH1GapLeftTime, clZoneRightTime, h1UpperGapTop, h1UpperGapBottom, clH1UpperBg, clH1Border, clH1GapBorderWidth, clExtendH1GapsRight)
    if clShowH1GapLabels
        clUpperH1GapLabel := f_update_zone_label(clUpperH1GapLabel, clZoneRightTime, (h1UpperGapTop + h1UpperGapBottom) / 2.0, "Upper Hourly Breakout", clH1GapLabelTextColor, f_zone_label_size(clH1GapLabelSizeInput))
    else
        if not na(clUpperH1GapLabel)
            label.delete(clUpperH1GapLabel)
            clUpperH1GapLabel := na
    if clShowPointsTillBreakLabels
        h1UpperPointsX = clBreakoutZoneFloatingMode ? f_floating_points_label_x() : f_points_label_x(h1GapLeftBarIndex, bar_index, clExtendH1GapsRight)
        h1UpperPointsY = clBreakoutZoneFittedMode ? (clPreviousHourHigh + h1UpperFittedBottom) / 2.0 : (h1UpperGapTop + h1UpperGapBottom) / 2.0
        clUpperH1GapPointsLabel := f_update_points_label(clUpperH1GapPointsLabel, h1UpperPointsX, h1UpperPointsY, f_zone_points_text(clBreakoutZoneFittedMode ? clPreviousHourHigh : h1UpperGapTop, clBreakoutZoneFittedMode ? h1UpperFittedBottom : h1UpperGapBottom, "hourly"), clPointsTillBreakLabelTextColor, f_zone_label_size(clPointsTillBreakLabelSizeInput))
    else
        if not na(clUpperH1GapPointsLabel)
            label.delete(clUpperH1GapPointsLabel)
            clUpperH1GapPointsLabel := na
else
    if not na(clUpperH1GapBox)
        box.delete(clUpperH1GapBox)
        clUpperH1GapBox := na
    if not na(clUpperH1GapLabel)
        label.delete(clUpperH1GapLabel)
        clUpperH1GapLabel := na
    if not na(clUpperH1GapPointsLabel)
        label.delete(clUpperH1GapPointsLabel)
        clUpperH1GapPointsLabel := na

if clLowerH1GapVisible
    if clBreakoutZoneFittedMode
        if not na(clLowerH1GapBox)
            box.delete(clLowerH1GapBox)
            clLowerH1GapBox := na
    else if clBreakoutZoneFloatingMode
        clLowerH1GapBox := f_update_zone_box_index(clLowerH1GapBox, bar_index - clFloatingWindowBarsBack, bar_index + clFloatingWindowBarsForward, h1LowerGapTop, h1LowerGapBottom, clH1LowerBg, clH1Border, clH1GapBorderWidth)
    else if clBreakoutZoneAnchoredMode
        clLowerH1GapBox := f_update_zone_box(clLowerH1GapBox, clH1GapLeftTime, clZoneRightTime, h1LowerGapTop, h1LowerGapBottom, clH1LowerBg, clH1Border, clH1GapBorderWidth, clExtendH1GapsRight)
    if clShowH1GapLabels
        clLowerH1GapLabel := f_update_zone_label(clLowerH1GapLabel, clZoneRightTime, (h1LowerGapTop + h1LowerGapBottom) / 2.0, "Lower Hourly Breakout", clH1GapLabelTextColor, f_zone_label_size(clH1GapLabelSizeInput))
    else
        if not na(clLowerH1GapLabel)
            label.delete(clLowerH1GapLabel)
            clLowerH1GapLabel := na
    if clShowPointsTillBreakLabels
        h1LowerPointsX = clBreakoutZoneFloatingMode ? f_floating_points_label_x() : f_points_label_x(h1GapLeftBarIndex, bar_index, clExtendH1GapsRight)
        h1LowerPointsY = clBreakoutZoneFittedMode ? (clPreviousHourLow + h1LowerFittedTop) / 2.0 : (h1LowerGapTop + h1LowerGapBottom) / 2.0
        clLowerH1GapPointsLabel := f_update_points_label(clLowerH1GapPointsLabel, h1LowerPointsX, h1LowerPointsY, f_zone_points_text(clBreakoutZoneFittedMode ? h1LowerFittedTop : h1LowerGapTop, clBreakoutZoneFittedMode ? clPreviousHourLow : h1LowerGapBottom, "hourly"), clPointsTillBreakLabelTextColor, f_zone_label_size(clPointsTillBreakLabelSizeInput))
    else
        if not na(clLowerH1GapPointsLabel)
            label.delete(clLowerH1GapPointsLabel)
            clLowerH1GapPointsLabel := na
else
    if not na(clLowerH1GapBox)
        box.delete(clLowerH1GapBox)
        clLowerH1GapBox := na
    if not na(clLowerH1GapLabel)
        label.delete(clLowerH1GapLabel)
        clLowerH1GapLabel := na
    if not na(clLowerH1GapPointsLabel)
        label.delete(clLowerH1GapPointsLabel)
        clLowerH1GapPointsLabel := na

if clUpperFourHourBreakoutVisible
    if clBreakoutZoneFittedMode
        if not na(clUpperFourHourBreakoutBox)
            box.delete(clUpperFourHourBreakoutBox)
            clUpperFourHourBreakoutBox := na
    else if clBreakoutZoneFloatingMode
        clUpperFourHourBreakoutBox := f_update_zone_box_index(clUpperFourHourBreakoutBox, bar_index - clFloatingWindowBarsBack, bar_index + clFloatingWindowBarsForward, fourHourUpperBreakoutTop, fourHourUpperBreakoutBottom, clUpperBreakoutBg, clBreakoutBorder, clBreakoutBorderWidth)
    else if clBreakoutZoneAnchoredMode
        clUpperFourHourBreakoutBox := f_update_zone_box(clUpperFourHourBreakoutBox, clFourHourBreakoutLeftTime, clZoneRightTime, fourHourUpperBreakoutTop, fourHourUpperBreakoutBottom, clUpperBreakoutBg, clBreakoutBorder, clBreakoutBorderWidth, clExtendBreakoutZonesRight)
    if clShowBreakoutLabels
        clUpperFourHourBreakoutLabel := f_update_zone_label(clUpperFourHourBreakoutLabel, clZoneRightTime, (fourHourUpperBreakoutTop + fourHourUpperBreakoutBottom) / 2.0, "Upper Four Hour Breakout", clBreakoutLabelTextColor, f_zone_label_size(clBreakoutLabelSizeInput))
    else
        if not na(clUpperFourHourBreakoutLabel)
            label.delete(clUpperFourHourBreakoutLabel)
            clUpperFourHourBreakoutLabel := na
    if clShowPointsTillBreakLabels
        fourHourUpperPointsX = clBreakoutZoneFloatingMode ? f_floating_points_label_x() : f_points_label_x(fourHourBreakoutLeftBarIndex, bar_index, clExtendBreakoutZonesRight)
        fourHourUpperPointsY = clBreakoutZoneFittedMode ? (clLatestClosed4HHigh + fourHourUpperFittedBottom) / 2.0 : (fourHourUpperBreakoutTop + fourHourUpperBreakoutBottom) / 2.0
        clUpperFourHourBreakoutPointsLabel := f_update_points_label(clUpperFourHourBreakoutPointsLabel, fourHourUpperPointsX, fourHourUpperPointsY, f_zone_points_text(clBreakoutZoneFittedMode ? clLatestClosed4HHigh : fourHourUpperBreakoutTop, clBreakoutZoneFittedMode ? fourHourUpperFittedBottom : fourHourUpperBreakoutBottom, "four hour"), clPointsTillBreakLabelTextColor, f_zone_label_size(clPointsTillBreakLabelSizeInput))
    else
        if not na(clUpperFourHourBreakoutPointsLabel)
            label.delete(clUpperFourHourBreakoutPointsLabel)
            clUpperFourHourBreakoutPointsLabel := na
else
    if not na(clUpperFourHourBreakoutBox)
        box.delete(clUpperFourHourBreakoutBox)
        clUpperFourHourBreakoutBox := na
    if not na(clUpperFourHourBreakoutLabel)
        label.delete(clUpperFourHourBreakoutLabel)
        clUpperFourHourBreakoutLabel := na
    if not na(clUpperFourHourBreakoutPointsLabel)
        label.delete(clUpperFourHourBreakoutPointsLabel)
        clUpperFourHourBreakoutPointsLabel := na

if clLowerFourHourBreakoutVisible
    if clBreakoutZoneFittedMode
        if not na(clLowerFourHourBreakoutBox)
            box.delete(clLowerFourHourBreakoutBox)
            clLowerFourHourBreakoutBox := na
    else if clBreakoutZoneFloatingMode
        clLowerFourHourBreakoutBox := f_update_zone_box_index(clLowerFourHourBreakoutBox, bar_index - clFloatingWindowBarsBack, bar_index + clFloatingWindowBarsForward, fourHourLowerBreakoutTop, fourHourLowerBreakoutBottom, clLowerBreakoutBg, clBreakoutBorder, clBreakoutBorderWidth)
    else if clBreakoutZoneAnchoredMode
        clLowerFourHourBreakoutBox := f_update_zone_box(clLowerFourHourBreakoutBox, clFourHourBreakoutLeftTime, clZoneRightTime, fourHourLowerBreakoutTop, fourHourLowerBreakoutBottom, clLowerBreakoutBg, clBreakoutBorder, clBreakoutBorderWidth, clExtendBreakoutZonesRight)
    if clShowBreakoutLabels
        clLowerFourHourBreakoutLabel := f_update_zone_label(clLowerFourHourBreakoutLabel, clZoneRightTime, (fourHourLowerBreakoutTop + fourHourLowerBreakoutBottom) / 2.0, "Lower Four Hour Breakout", clBreakoutLabelTextColor, f_zone_label_size(clBreakoutLabelSizeInput))
    else
        if not na(clLowerFourHourBreakoutLabel)
            label.delete(clLowerFourHourBreakoutLabel)
            clLowerFourHourBreakoutLabel := na
    if clShowPointsTillBreakLabels
        fourHourLowerPointsX = clBreakoutZoneFloatingMode ? f_floating_points_label_x() : f_points_label_x(fourHourBreakoutLeftBarIndex, bar_index, clExtendBreakoutZonesRight)
        fourHourLowerPointsY = clBreakoutZoneFittedMode ? (clLatestClosed4HLow + fourHourLowerFittedTop) / 2.0 : (fourHourLowerBreakoutTop + fourHourLowerBreakoutBottom) / 2.0
        clLowerFourHourBreakoutPointsLabel := f_update_points_label(clLowerFourHourBreakoutPointsLabel, fourHourLowerPointsX, fourHourLowerPointsY, f_zone_points_text(clBreakoutZoneFittedMode ? fourHourLowerFittedTop : fourHourLowerBreakoutTop, clBreakoutZoneFittedMode ? clLatestClosed4HLow : fourHourLowerBreakoutBottom, "four hour"), clPointsTillBreakLabelTextColor, f_zone_label_size(clPointsTillBreakLabelSizeInput))
    else
        if not na(clLowerFourHourBreakoutPointsLabel)
            label.delete(clLowerFourHourBreakoutPointsLabel)
            clLowerFourHourBreakoutPointsLabel := na
else
    if not na(clLowerFourHourBreakoutBox)
        box.delete(clLowerFourHourBreakoutBox)
        clLowerFourHourBreakoutBox := na
    if not na(clLowerFourHourBreakoutLabel)
        label.delete(clLowerFourHourBreakoutLabel)
        clLowerFourHourBreakoutLabel := na
    if not na(clLowerFourHourBreakoutPointsLabel)
        label.delete(clLowerFourHourBreakoutPointsLabel)
        clLowerFourHourBreakoutPointsLabel := na

//=================================================================================================================================================================================
// SECTION 7 – MOVING AVERAGE SUITE
//=================================================================================================================================================================================
isLowTF = timeframe.isintraday and timeframe.multiplier <= 30

maTooltip = "Moving average stack.\n\nOne shared type, source, color, and width applies across up to ten lines. Each line keeps its own visibility, length, and price offset."
enableMA = input.bool(false, "Enable", group=groupMA, inline="ma-core", tooltip=maTooltip)
maType    = input.string("SMA", "Type", options=["SMA","EMA","SMMA (RMA)","WMA","VWMA"], group=groupMA, inline="ma-core")
maSource  = input.source(close, "Source", group=groupMA, display=menuDisplay)
maColor   = input.color(#a58700, "Color", group=groupMA, inline="ma-style")
lineWidth = input.int(1, "Width", minval=1, maxval=5, group=groupMA, inline="ma-style", display=menuDisplay)

showLine1  = input.bool(true, "MA 1", group=groupMA, inline="ma1a", tooltip="Each row controls one MA line: show, length, and price offset.")
length1    = input.int(200, "Length", group=groupMA, inline="ma1a", display=menuDisplay)
offset1    = input.int(1, "Offset", group=groupMA, inline="ma1a", display=menuDisplay)

showLine2  = input.bool(true, "MA 2", group=groupMA, inline="ma2a")
length2    = input.int(200, "Length", group=groupMA, inline="ma2a", display=menuDisplay)
offset2    = input.int(2, "Offset", group=groupMA, inline="ma2a", display=menuDisplay)

showLine3  = input.bool(true, "MA 3", group=groupMA, inline="ma3a")
length3    = input.int(200, "Length", group=groupMA, inline="ma3a", display=menuDisplay)
offset3    = input.int(3, "Offset", group=groupMA, inline="ma3a", display=menuDisplay)

showLine4  = input.bool(true, "MA 4", group=groupMA, inline="ma4a")
length4    = input.int(200, "Length", group=groupMA, inline="ma4a", display=menuDisplay)
offset4    = input.int(4, "Offset", group=groupMA, inline="ma4a", display=menuDisplay)

showLine5  = input.bool(true, "MA 5", group=groupMA, inline="ma5a")
length5    = input.int(200, "Length", group=groupMA, inline="ma5a", display=menuDisplay)
offset5    = input.int(5, "Offset", group=groupMA, inline="ma5a", display=menuDisplay)

showLine6  = input.bool(true, "MA 6", group=groupMA, inline="ma6a")
length6    = input.int(200, "Length", group=groupMA, inline="ma6a", display=menuDisplay)
offset6    = input.int(6, "Offset", group=groupMA, inline="ma6a", display=menuDisplay)

showLine7  = input.bool(true, "MA 7", group=groupMA, inline="ma7a")
length7    = input.int(200, "Length", group=groupMA, inline="ma7a", display=menuDisplay)
offset7    = input.int(7, "Offset", group=groupMA, inline="ma7a", display=menuDisplay)

showLine8  = input.bool(true, "MA 8", group=groupMA, inline="ma8a")
length8    = input.int(200, "Length", group=groupMA, inline="ma8a", display=menuDisplay)
offset8    = input.int(8, "Offset", group=groupMA, inline="ma8a", display=menuDisplay)

showLine9  = input.bool(true, "MA 9", group=groupMA, inline="ma9a")
length9    = input.int(200, "Length", group=groupMA, inline="ma9a", display=menuDisplay)
offset9    = input.int(9, "Offset", group=groupMA, inline="ma9a", display=menuDisplay)

showLine10 = input.bool(true, "MA 10", group=groupMA, inline="ma10a")
length10   = input.int(200, "Length", group=groupMA, inline="ma10a", display=menuDisplay)
offset10   = input.int(10, "Offset", group=groupMA, inline="ma10a", display=menuDisplay)

fillEnable  = input.bool(false, "Show Fill", group=groupMAFill, tooltip="Visual fill between MA 1 and MA 2.")
fillColor   = input.color(color.new(#a58700, 80), "Fill", group=groupMAFill)

f_ma(src, len) =>
    var float res = na
    if maType == "EMA"
        res := ta.ema(src, len)
    else if maType == "SMMA (RMA)"
        res := ta.rma(src, len)
    else if maType == "WMA"
        res := ta.wma(src, len)
    else if maType == "VWMA"
        res := ta.vwma(src, len)
    else
        res := ta.sma(src, len)
    res

ma1  = enableMA and isLowTF ? f_ma(maSource, length1) : na
ma2  = enableMA and isLowTF ? f_ma(maSource, length2) : na
ma3  = enableMA and isLowTF ? f_ma(maSource, length3) : na
ma4  = enableMA and isLowTF ? f_ma(maSource, length4) : na
ma5  = enableMA and isLowTF ? f_ma(maSource, length5) : na
ma6  = enableMA and isLowTF ? f_ma(maSource, length6) : na
ma7  = enableMA and isLowTF ? f_ma(maSource, length7) : na
ma8  = enableMA and isLowTF ? f_ma(maSource, length8) : na
ma9  = enableMA and isLowTF ? f_ma(maSource, length9) : na
ma10 = enableMA and isLowTF ? f_ma(maSource, length10) : na

p1  = plot(showLine1 ? ma1 + offset1 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 1")
p2  = plot(showLine2 ? ma2 + offset2 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 2")
p3  = plot(showLine3 ? ma3 + offset3 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 3")
p4  = plot(showLine4 ? ma4 + offset4 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 4")
p5  = plot(showLine5 ? ma5 + offset5 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 5")
p6  = plot(showLine6 ? ma6 + offset6 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 6")
p7  = plot(showLine7 ? ma7 + offset7 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 7")
p8  = plot(showLine8 ? ma8 + offset8 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 8")
p9  = plot(showLine9 ? ma9 + offset9 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 9")
p10 = plot(showLine10 ? ma10 + offset10 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 10")

fill(p1, p2, color=fillEnable ? fillColor : na)

//=================================================================================================================================================================================
// SECTION 8 – BOLLINGER BANDS
//=================================================================================================================================================================================
bbTooltip = "Bollinger Band controls.\n\nUses the selected basis type, source, length, and standard deviation multiplier. Visual colors only affect the band plots and fill."
showBollingerBand = input.bool(true, "Enable", group=groupBB, tooltip=bbTooltip)
bbLength = input.int(1380, minval=1, title="Length", group=groupBB, inline="bb-core", display=menuDisplay)
maType2  = input.string("SMA", title="Type", options=["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group=groupBB, inline="bb-core")
src2     = input.source(close, title="Source", group=groupBB, inline="bb-core", display=menuDisplay)
mult     = input.float(2.0, minval=0.001, maxval=50, title="StdDev", group=groupBB, inline="bb-dev", display=menuDisplay)
offsetBB = input.int(0, "Offset", minval=-500, maxval=500, group=groupBB, inline="bb-dev", display=menuDisplay)

bbBasisColor = input.color(color.new(#986300, 0), "Basis", group=groupBB, inline="bb-colors")
bbUpperColor = input.color(color.new(color.black, 100), "Upper", group=groupBB, inline="bb-colors")
bbLowerColor = input.color(color.new(color.black, 100), "Lower", group=groupBB, inline="bb-colors")
bbFillColor  = input.color(color.rgb(183, 183, 183, 97), "Fill", group=groupBB)

ma_calc(_src, _len, _type) =>
    switch _type
        "SMA"        => ta.sma(_src, _len)
        "EMA"        => ta.ema(_src, _len)
        "SMMA (RMA)" => ta.rma(_src, _len)
        "WMA"        => ta.wma(_src, _len)
        "VWMA"       => ta.vwma(_src, _len)

basis = showBollingerBand ? ma_calc(src2, bbLength, maType2) : na
dev   = showBollingerBand ? mult * ta.stdev(src2, bbLength) : na
upper = showBollingerBand ? basis + dev : na
lower = showBollingerBand ? basis - dev : na

plot(basis, "BB Basis", color=bbBasisColor, offset=offsetBB)
pUpper = plot(upper, "BB Upper", color=bbUpperColor, linewidth=1, offset=offsetBB)
pLower = plot(lower, "BB Lower", color=bbLowerColor, linewidth=1, offset=offsetBB)
fill(pUpper, pLower, title="BB Fill", color=bbFillColor)

//=================================================================================================================================================================================
// SECTION 9 – SESSION HIGHLIGHTING
//=================================================================================================================================================================================
sessionTooltip = "World session highlighting.\n\nShow Sessions enables the feature. Use High/Low Fill to shade the tracked session range instead of the chart background."
sessionFillTooltip = "When enabled, the script fills between each session's tracked high and low plots. When disabled, it uses background highlighting."
ShowSessions = input.bool(false, "Show Sessions", group=groupSessions, inline="sess-core", tooltip=sessionTooltip)
bgColorToggle = input.bool(false, "High/Low Fill", group=groupSessions, inline="sess-core", tooltip=sessionFillTooltip)

resSession = input.timeframe("D", "Resolution", options=["D", "W", "M"], group=groupSessions, display=menuDisplay)

LondonEnabled = input.bool(true, "London", group=groupSessions, inline="sess-london")
LondonColor = input.color(color.new(color.green, 90), "Color", group=groupSessions, inline="sess-london")
NYEnabled = input.bool(true, "New York", group=groupSessions, inline="sess-ny")
NYColor = input.color(color.new(color.red, 90), "Color", group=groupSessions, inline="sess-ny")
TokyoEnabled = input.bool(true, "Tokyo / Asia", group=groupSessions, inline="sess-tokyo")
AsiaColor = input.color(color.new(color.yellow, 90), "Color", group=groupSessions, inline="sess-tokyo")
SydneyEnabled = input.bool(true, "Sydney", group=groupSessions, inline="sess-sydney")
SydneyColor = input.color(color.new(color.blue, 90), "Color", group=groupSessions, inline="sess-sydney")

londonSessionStr = input.session("0300-1200:1234567", "London Hours", group=groupSessions, display=menuDisplay)
nySessionStr     = input.session("0800-1700:1234567", "New York Hours", group=groupSessions, display=menuDisplay)
tokyoSessionStr  = input.session("2000-0400:1234567", "Tokyo Hours", group=groupSessions, display=menuDisplay)
sydneySessionStr = input.session("1700-0200:1234567", "Sydney Hours", group=groupSessions, display=menuDisplay)

is_newbar(sess) =>
    t = time(resSession, sess, "America/New_York")
    (na(t[1]) and not na(t)) or (t[1] < t)

is_session(sess) =>
    not na(time(timeframe.period, sess, "America/New_York"))

var float londonLow  = na
var float londonHigh = na
var float nyLow      = na
var float nyHigh     = na
var float tokyoLow   = na
var float tokyoHigh  = na
var float sydneyLow  = na
var float sydneyHigh = na

if is_session(londonSessionStr)
    if is_newbar(londonSessionStr)
        londonLow := low
        londonHigh := high
    else
        londonLow := math.min(londonLow[1], low)
        londonHigh := math.max(londonHigh[1], high)

if is_session(nySessionStr)
    if is_newbar(nySessionStr)
        nyLow := low
        nyHigh := high
    else
        nyLow := math.min(nyLow[1], low)
        nyHigh := math.max(nyHigh[1], high)

if is_session(tokyoSessionStr)
    if is_newbar(tokyoSessionStr)
        tokyoLow := low
        tokyoHigh := high
    else
        tokyoLow := math.min(tokyoLow[1], low)
        tokyoHigh := math.max(tokyoHigh[1], high)

if is_session(sydneySessionStr)
    if is_newbar(sydneySessionStr)
        sydneyLow := low
        sydneyHigh := high
    else
        sydneyLow := math.min(sydneyLow[1], low)
        sydneyHigh := math.max(sydneyHigh[1], high)

pLondonLow  = plot(londonLow, color=color.new(color.black, 100), title="London Low")
pLondonHigh = plot(londonHigh, color=color.new(color.black, 100), title="London High")
pNYLow      = plot(nyLow, color=color.new(color.black, 100), title="NY Low")
pNYHigh     = plot(nyHigh, color=color.new(color.black, 100), title="NY High")
pTokyoLow   = plot(tokyoLow, color=color.new(color.black, 100), title="Tokyo Low")
pTokyoHigh  = plot(tokyoHigh, color=color.new(color.black, 100), title="Tokyo High")
pSydneyLow  = plot(sydneyLow, color=color.new(color.black, 100), title="Sydney Low")
pSydneyHigh = plot(sydneyHigh, color=color.new(color.black, 100), title="Sydney High")

fill(pLondonLow, pLondonHigh, color=(is_session(londonSessionStr) and LondonEnabled and bgColorToggle and ShowSessions) ? LondonColor : na)
fill(pNYLow, pNYHigh, color=(is_session(nySessionStr) and NYEnabled and bgColorToggle and ShowSessions) ? NYColor : na)
fill(pTokyoLow, pTokyoHigh, color=(is_session(tokyoSessionStr) and TokyoEnabled and bgColorToggle and ShowSessions) ? AsiaColor : na)
fill(pSydneyLow, pSydneyHigh, color=(is_session(sydneySessionStr) and SydneyEnabled and bgColorToggle and ShowSessions) ? SydneyColor : na)

bgcolor((is_session(londonSessionStr) and LondonEnabled and not bgColorToggle and ShowSessions and isLowTimeframe240) ? LondonColor : na)
bgcolor((is_session(nySessionStr) and NYEnabled and not bgColorToggle and ShowSessions and isLowTimeframe240) ? NYColor : na)
bgcolor((is_session(tokyoSessionStr) and TokyoEnabled and not bgColorToggle and ShowSessions and isLowTimeframe240) ? AsiaColor : na)
bgcolor((is_session(sydneySessionStr) and SydneyEnabled and not bgColorToggle and ShowSessions and isLowTimeframe240) ? SydneyColor : na)

//=================================================================================================================
// SECTION 10 – FUTURES VALUE PANEL DATA
//=================================================================================================================
futuresPanelTooltip = "Futures value reference panel.\n\nShows dollars per tick and/or dollars per point for curated futures contracts plus the current chart symbol."
futuresCustomTooltip = "Optional comma-separated list of supported roots to show after the current symbol row.\n\nExample: ES,NQ,CL,GC,BTC,MBT,SI,HG\n\nIf left blank, the panel uses the curated default list. TradingView Pine cannot read your platform watchlist directly."
showFuturesValuePanel = input.bool(true, "Show Panel", group=groupFutures, inline="fp-core", tooltip=futuresPanelTooltip)
futuresPanelLocation = input.string("Top Right", "Location", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=groupFutures, inline="fp-core", display=menuDisplay)

futuresDisplayMode = input.string("Both", "Mode", options=["$ / Tick", "$ / Point", "Both"], group=groupFutures, inline="fp-mode")
futuresTextSizeInput = input.string("Small", "Text Size", options=["Tiny", "Small", "Normal"], group=groupFutures, inline="fp-mode", display=menuDisplay)

highlightCurrentSymbol = input.bool(true, "Highlight Current", group=groupFutures, inline="fp-toggles")
compactFuturesMode = input.bool(false, "Compact", group=groupFutures, inline="fp-toggles")
futuresCustomList = input.string("", "Custom Symbols", group=groupFutures, tooltip=futuresCustomTooltip, display=menuDisplay)

futuresPanelBgColor = input.color(color.new(color.black, 80), "Background", group=groupFutures, inline="fp-colors")
futuresHeaderBgColor = input.color(color.new(#a58700, 10), "Header", group=groupFutures, inline="fp-colors")
futuresBorderColor = input.color(color.new(color.white, 60), "Border", group=groupFutures, inline="fp-style")
futuresPanelTextColor = input.color(color.white, "Text", group=groupFutures, inline="fp-style")

var futuresSymbols = array.from("MNQ","NQ","MES","ES","M2K","RTY","MYM","YM","BTC","MBT","ETH","MET","MGC","GC","SIL","SI","PA","PL","HG","MCL","CL","QM","NG","QG","RB","HO","ZN","ZB","ZF","ZT","UB","6E","M6E","6J","M6J","6B","M6B","6A","M6A","6C","6S")
var futuresTickVals = array.from(0.50,5.00,1.25,12.50,0.50,5.00,0.50,5.00,5.00,0.10,0.50,0.05,1.00,10.00,5.00,25.00,10.00,5.00,12.50,1.00,10.00,12.50,10.00,25.00,4.20,4.20,15.625,31.25,7.8125,15.625,31.25,6.25,1.25,6.25,1.25,6.25,1.25,10.00,1.00,10.00,12.50)
var futuresPointVals = array.from(2.00,20.00,5.00,50.00,5.00,50.00,0.50,5.00,5.00,0.10,0.50,0.05,10.00,100.00,1000.00,5000.00,100.00,50.00,25000.00,100.00,1000.00,12500.00,10000.00,25000.00,42000.00,42000.00,1000.00,1000.00,1000.00,1000.00,1000.00,125000.00,25000.00,125000.00,25000.00,62500.00,12500.00,100000.00,10000.00,100000.00,125000.00)
var compactCoreSymbols = array.from("MNQ","NQ","MES","ES","RTY","YM","BTC","MBT","MGC","GC","SI","HG","MCL","CL","NG")
var futuresTable = table.new(position.top_right, 3, 44, bgcolor=color.new(color.black, 100), frame_color=color.new(color.black, 100), frame_width=0, border_color=color.new(color.black, 100), border_width=0)

f_find_symbol_index(_symbol) =>
    int idx = -1
    for i = 0 to array.size(futuresSymbols) - 1
        if array.get(futuresSymbols, i) == _symbol
            idx := i
    idx

f_is_compact_symbol(_symbol) =>
    bool keep = false
    for i = 0 to array.size(compactCoreSymbols) - 1
        if array.get(compactCoreSymbols, i) == _symbol
            keep := true
    keep

f_symbol_in_custom_list(_symbol, _customList) =>
    bool found = false
    if _customList != ""
        tokenArray = str.split(_customList, ",")
        for i = 0 to array.size(tokenArray) - 1
            if f_normalize_token(array.get(tokenArray, i)) == _symbol
                found := true
    found

//=================================================================================================================
// SECTION 11 – FUTURES VALUE PANEL RENDERING
//=================================================================================================================
if barstate.islast
    panelTextSize = f_panel_text_size(futuresTextSizeInput)
    hiddenColor = color.new(color.black, 100)
    table.set_position(futuresTable, f_panel_position(futuresPanelLocation))

    if showFuturesValuePanel
        table.set_bgcolor(futuresTable, futuresPanelBgColor)
        table.set_frame_color(futuresTable, futuresBorderColor)
        table.set_frame_width(futuresTable, 1)
        table.set_border_color(futuresTable, futuresBorderColor)
        table.set_border_width(futuresTable, 1)
    else
        table.set_bgcolor(futuresTable, hiddenColor)
        table.set_frame_color(futuresTable, hiddenColor)
        table.set_frame_width(futuresTable, 0)
        table.set_border_color(futuresTable, hiddenColor)
        table.set_border_width(futuresTable, 0)

    for clearRow = 0 to 43
        table.cell(futuresTable, 0, clearRow, "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=hiddenColor)
        table.cell(futuresTable, 1, clearRow, "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=hiddenColor)
        table.cell(futuresTable, 2, clearRow, "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=hiddenColor)

    if showFuturesValuePanel
        currentRoot = f_symbol_root()
        currentTickValue = syminfo.mintick * syminfo.pointvalue
        currentPointValue = syminfo.pointvalue
        currentIsMapped = f_find_symbol_index(currentRoot) != -1
        showTickCol = futuresDisplayMode == "$ / Tick" or futuresDisplayMode == "Both"
        showPointCol = futuresDisplayMode == "$ / Point" or futuresDisplayMode == "Both"

        table.cell(futuresTable, 0, 0, "Symbol", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresHeaderBgColor)
        table.cell(futuresTable, 1, 0, showTickCol ? "$/Tick" : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresHeaderBgColor)
        table.cell(futuresTable, 2, 0, showPointCol ? "$/Point" : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresHeaderBgColor)

        row = 1
        currentRowBg = highlightCurrentSymbol ? color.new(#a58700, 75) : futuresPanelBgColor

        table.cell(futuresTable, 0, row, currentRoot + (currentIsMapped ? " (Current)" : " (Current*)"), text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=currentRowBg)
        table.cell(futuresTable, 1, row, showTickCol ? f_money(currentTickValue) : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=currentRowBg)
        table.cell(futuresTable, 2, row, showPointCol ? f_money(currentPointValue) : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=currentRowBg)
        row += 1

        for i = 0 to array.size(futuresSymbols) - 1
            if row <= 43
                sym = array.get(futuresSymbols, i)
                includeByCustom = futuresCustomList != "" ? f_symbol_in_custom_list(sym, futuresCustomList) : true
                includeByCompact = compactFuturesMode ? f_is_compact_symbol(sym) : true
                includeRow = includeByCustom and includeByCompact and sym != currentRoot
                if includeRow
                    tickVal = array.get(futuresTickVals, i)
                    pointVal = array.get(futuresPointVals, i)
                    table.cell(futuresTable, 0, row, sym, text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresPanelBgColor)
                    table.cell(futuresTable, 1, row, showTickCol ? f_money(tickVal) : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresPanelBgColor)
                    table.cell(futuresTable, 2, row, showPointCol ? f_money(pointVal) : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresPanelBgColor)
                    row += 1
