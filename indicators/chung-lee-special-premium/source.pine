        clUpperFourHourBreakoutBox := na
    if not na(clLowerFourHourBreakoutBox)
        box.delete(clLowerFourHourBreakoutBox)
        clLowerFourHourBreakoutBox := na
    f_clear_zone_fill_boxes(clUpperStackFillBoxes)
    f_clear_zone_fill_boxes(clLowerStackFillBoxes)
    f_clear_zone_fill_boxes(clWeeklyUpperStackFillBoxes)
    f_clear_zone_fill_boxes(clWeeklyLowerStackFillBoxes)
    f_clear_zone_fill_boxes(clMonthlyUpperStackFillBoxes)
    f_clear_zone_fill_boxes(clMonthlyLowerStackFillBoxes)
    f_clear_zone_fill_boxes(clUpperH1GapFillBoxes)
    f_clear_zone_fill_boxes(clLowerH1GapFillBoxes)
    f_clear_zone_fill_boxes(clUpperFourHourBreakoutFillBoxes)
    f_clear_zone_fill_boxes(clLowerFourHourBreakoutFillBoxes)
    if not na(clUpperStackFittedExtensionBox)
        box.delete(clUpperStackFittedExtensionBox)
        clUpperStackFittedExtensionBox := na
    if not na(clLowerStackFittedExtensionBox)
        box.delete(clLowerStackFittedExtensionBox)
        clLowerStackFittedExtensionBox := na
    if not na(clWeeklyUpperStackFittedExtensionBox)
        box.delete(clWeeklyUpperStackFittedExtensionBox)
        clWeeklyUpperStackFittedExtensionBox := na
    if not na(clWeeklyLowerStackFittedExtensionBox)
        box.delete(clWeeklyLowerStackFittedExtensionBox)
        clWeeklyLowerStackFittedExtensionBox := na
    if not na(clMonthlyUpperStackFittedExtensionBox)
        box.delete(clMonthlyUpperStackFittedExtensionBox)
        clMonthlyUpperStackFittedExtensionBox := na
    if not na(clMonthlyLowerStackFittedExtensionBox)
        box.delete(clMonthlyLowerStackFittedExtensionBox)
        clMonthlyLowerStackFittedExtensionBox := na
    if not na(clUpperH1GapFittedExtensionBox)
        box.delete(clUpperH1GapFittedExtensionBox)
        clUpperH1GapFittedExtensionBox := na
    if not na(clLowerH1GapFittedExtensionBox)
        box.delete(clLowerH1GapFittedExtensionBox)
        clLowerH1GapFittedExtensionBox := na
    if not na(clUpperFourHourBreakoutFittedExtensionBox)
        box.delete(clUpperFourHourBreakoutFittedExtensionBox)
        clUpperFourHourBreakoutFittedExtensionBox := na
    if not na(clLowerFourHourBreakoutFittedExtensionBox)
        box.delete(clLowerFourHourBreakoutFittedExtensionBox)
        clLowerFourHourBreakoutFittedExtensionBox := na
    clLastBreakoutZoneDisplayMode := clBreakoutZoneDisplayMode

upperStackFittedVisible = upperStackActive and clBreakoutZoneFittedMode and time >= upperStackLeftTime
lowerStackFittedVisible = lowerStackActive and clBreakoutZoneFittedMode and time >= lowerStackLeftTime
weeklyUpperFittedVisible = weeklyUpperStackActive and clBreakoutZoneFittedMode and time >= weeklyUpperLeftTime
weeklyLowerFittedVisible = weeklyLowerStackActive and clBreakoutZoneFittedMode and time >= weeklyLowerLeftTime
monthlyUpperFittedVisible = monthlyUpperStackActive and clBreakoutZoneFittedMode and time >= monthlyUpperLeftTime
monthlyLowerFittedVisible = monthlyLowerStackActive and clBreakoutZoneFittedMode and time >= monthlyLowerLeftTime
h1UpperFittedVisible = clUpperH1GapVisible and clBreakoutZoneFittedMode and time >= clH1GapLeftTime
h1LowerFittedVisible = clLowerH1GapVisible and clBreakoutZoneFittedMode and time >= clH1GapLeftTime
fourHourUpperFittedVisible = clUpperFourHourBreakoutVisible and clBreakoutZoneFittedMode and time >= clFourHourBreakoutLeftTime
fourHourLowerFittedVisible = clLowerFourHourBreakoutVisible and clBreakoutZoneFittedMode and time >= clFourHourBreakoutLeftTime

clFittedBodyRightTime = time + clBarMs
clFittedExtensionRightTime = clZoneRightTime + clBarMs * clFittedBreakoutExtensionBars
clFittedExtensionVisible = clFittedBreakoutExtendRight and clFittedBreakoutExtensionBars > 0

upperStackFittedBottom = math.min(high, clPreviousDayHigh)
lowerStackFittedTop = math.max(low, clPreviousDayLow)
weeklyUpperFittedBottom = math.min(high, clPreviousWeekHigh)
weeklyLowerFittedTop = math.max(low, clPreviousWeekLow)
monthlyUpperFittedBottom = math.min(high, clPreviousMonthHigh)
monthlyLowerFittedTop = math.max(low, clPreviousMonthLow)
h1UpperFittedBottom = math.min(high, clPreviousHourHigh)
h1LowerFittedTop = math.max(low, clPreviousHourLow)
fourHourUpperFittedBottom = math.min(high, clLatestClosed4HHigh)
fourHourLowerFittedTop = math.max(low, clLatestClosed4HLow)

upperStackFittedReset = upperStackFittedVisible and (not nz(upperStackFittedVisible[1], false) or nz(ta.change(clPreviousDayHigh)) != 0 or nz(ta.change(upperStackLeftTime)) != 0)
upperStackFittedNewSegment = upperStackFittedVisible and (upperStackFittedReset or barstate.isnew)
lowerStackFittedReset = lowerStackFittedVisible and (not nz(lowerStackFittedVisible[1], false) or nz(ta.change(clPreviousDayLow)) != 0 or nz(ta.change(lowerStackLeftTime)) != 0)
lowerStackFittedNewSegment = lowerStackFittedVisible and (lowerStackFittedReset or barstate.isnew)
weeklyUpperFittedReset = weeklyUpperFittedVisible and (not nz(weeklyUpperFittedVisible[1], false) or nz(ta.change(clPreviousWeekHigh)) != 0 or nz(ta.change(weeklyUpperLeftTime)) != 0)
weeklyUpperFittedNewSegment = weeklyUpperFittedVisible and (weeklyUpperFittedReset or barstate.isnew)
weeklyLowerFittedReset = weeklyLowerFittedVisible and (not nz(weeklyLowerFittedVisible[1], false) or nz(ta.change(clPreviousWeekLow)) != 0 or nz(ta.change(weeklyLowerLeftTime)) != 0)
weeklyLowerFittedNewSegment = weeklyLowerFittedVisible and (weeklyLowerFittedReset or barstate.isnew)
monthlyUpperFittedReset = monthlyUpperFittedVisible and (not nz(monthlyUpperFittedVisible[1], false) or nz(ta.change(clPreviousMonthHigh)) != 0 or nz(ta.change(monthlyUpperLeftTime)) != 0)
monthlyUpperFittedNewSegment = monthlyUpperFittedVisible and (monthlyUpperFittedReset or barstate.isnew)
monthlyLowerFittedReset = monthlyLowerFittedVisible and (not nz(monthlyLowerFittedVisible[1], false) or nz(ta.change(clPreviousMonthLow)) != 0 or nz(ta.change(monthlyLowerLeftTime)) != 0)
monthlyLowerFittedNewSegment = monthlyLowerFittedVisible and (monthlyLowerFittedReset or barstate.isnew)
h1UpperFittedReset = h1UpperFittedVisible and (not nz(h1UpperFittedVisible[1], false) or nz(ta.change(clPreviousHourHigh)) != 0 or nz(ta.change(clH1GapLeftTime)) != 0)
h1UpperFittedNewSegment = h1UpperFittedVisible and (h1UpperFittedReset or barstate.isnew)
h1LowerFittedReset = h1LowerFittedVisible and (not nz(h1LowerFittedVisible[1], false) or nz(ta.change(clPreviousHourLow)) != 0 or nz(ta.change(clH1GapLeftTime)) != 0)
h1LowerFittedNewSegment = h1LowerFittedVisible and (h1LowerFittedReset or barstate.isnew)
fourHourUpperFittedReset = fourHourUpperFittedVisible and (not nz(fourHourUpperFittedVisible[1], false) or nz(ta.change(clLatestClosed4HHigh)) != 0 or nz(ta.change(clFourHourBreakoutLeftTime)) != 0)
fourHourUpperFittedNewSegment = fourHourUpperFittedVisible and (fourHourUpperFittedReset or barstate.isnew)
fourHourLowerFittedReset = fourHourLowerFittedVisible and (not nz(fourHourLowerFittedVisible[1], false) or nz(ta.change(clLatestClosed4HLow)) != 0 or nz(ta.change(clFourHourBreakoutLeftTime)) != 0)
fourHourLowerFittedNewSegment = fourHourLowerFittedVisible and (fourHourLowerFittedReset or barstate.isnew)

f_update_fitted_zone_boxes(clUpperStackFillBoxes, upperStackFittedVisible, upperStackFittedReset, upperStackFittedNewSegment, time, clFittedBodyRightTime, clPreviousDayHigh, upperStackFittedBottom, clStackUpperBg, clMaxFittedBreakoutSegments)
f_update_fitted_zone_boxes(clLowerStackFillBoxes, lowerStackFittedVisible, lowerStackFittedReset, lowerStackFittedNewSegment, time, clFittedBodyRightTime, lowerStackFittedTop, clPreviousDayLow, clStackLowerBg, clMaxFittedBreakoutSegments)
f_update_fitted_zone_boxes(clWeeklyUpperStackFillBoxes, weeklyUpperFittedVisible, weeklyUpperFittedReset, weeklyUpperFittedNewSegment, time, clFittedBodyRightTime, clPreviousWeekHigh, weeklyUpperFittedBottom, clWeeklyStackUpperBg, clMaxFittedBreakoutSegments)
f_update_fitted_zone_boxes(clWeeklyLowerStackFillBoxes, weeklyLowerFittedVisible, weeklyLowerFittedReset, weeklyLowerFittedNewSegment, time, clFittedBodyRightTime, weeklyLowerFittedTop, clPreviousWeekLow, clWeeklyStackLowerBg, clMaxFittedBreakoutSegments)
f_update_fitted_zone_boxes(clMonthlyUpperStackFillBoxes, monthlyUpperFittedVisible, monthlyUpperFittedReset, monthlyUpperFittedNewSegment, time, clFittedBodyRightTime, clPreviousMonthHigh, monthlyUpperFittedBottom, clMonthlyStackUpperBg, clMaxFittedBreakoutSegments)
f_update_fitted_zone_boxes(clMonthlyLowerStackFillBoxes, monthlyLowerFittedVisible, monthlyLowerFittedReset, monthlyLowerFittedNewSegment, time, clFittedBodyRightTime, monthlyLowerFittedTop, clPreviousMonthLow, clMonthlyStackLowerBg, clMaxFittedBreakoutSegments)
f_update_fitted_zone_boxes(clUpperH1GapFillBoxes, h1UpperFittedVisible, h1UpperFittedReset, h1UpperFittedNewSegment, time, clFittedBodyRightTime, clPreviousHourHigh, h1UpperFittedBottom, clH1UpperBg, clMaxFittedBreakoutSegments)
f_update_fitted_zone_boxes(clLowerH1GapFillBoxes, h1LowerFittedVisible, h1LowerFittedReset, h1LowerFittedNewSegment, time, clFittedBodyRightTime, h1LowerFittedTop, clPreviousHourLow, clH1LowerBg, clMaxFittedBreakoutSegments)
f_update_fitted_zone_boxes(clUpperFourHourBreakoutFillBoxes, fourHourUpperFittedVisible, fourHourUpperFittedReset, fourHourUpperFittedNewSegment, time, clFittedBodyRightTime, clLatestClosed4HHigh, fourHourUpperFittedBottom, clUpperBreakoutBg, clMaxFittedBreakoutSegments)
f_update_fitted_zone_boxes(clLowerFourHourBreakoutFillBoxes, fourHourLowerFittedVisible, fourHourLowerFittedReset, fourHourLowerFittedNewSegment, time, clFittedBodyRightTime, fourHourLowerFittedTop, clLatestClosed4HLow, clLowerBreakoutBg, clMaxFittedBreakoutSegments)

clUpperStackFittedExtensionBox := f_update_fitted_breakout_extension_box(clUpperStackFittedExtensionBox, upperStackFittedVisible and clFittedExtensionVisible, clZoneRightTime, clFittedExtensionRightTime, clPreviousDayHigh, upperStackFittedBottom, true, clStackUpperBg)
clLowerStackFittedExtensionBox := f_update_fitted_breakout_extension_box(clLowerStackFittedExtensionBox, lowerStackFittedVisible and clFittedExtensionVisible, clZoneRightTime, clFittedExtensionRightTime, clPreviousDayLow, lowerStackFittedTop, false, clStackLowerBg)
clWeeklyUpperStackFittedExtensionBox := f_update_fitted_breakout_extension_box(clWeeklyUpperStackFittedExtensionBox, weeklyUpperFittedVisible and clFittedExtensionVisible, clZoneRightTime, clFittedExtensionRightTime, clPreviousWeekHigh, weeklyUpperFittedBottom, true, clWeeklyStackUpperBg)
clWeeklyLowerStackFittedExtensionBox := f_update_fitted_breakout_extension_box(clWeeklyLowerStackFittedExtensionBox, weeklyLowerFittedVisible and clFittedExtensionVisible, clZoneRightTime, clFittedExtensionRightTime, clPreviousWeekLow, weeklyLowerFittedTop, false, clWeeklyStackLowerBg)
clMonthlyUpperStackFittedExtensionBox := f_update_fitted_breakout_extension_box(clMonthlyUpperStackFittedExtensionBox, monthlyUpperFittedVisible and clFittedExtensionVisible, clZoneRightTime, clFittedExtensionRightTime, clPreviousMonthHigh, monthlyUpperFittedBottom, true, clMonthlyStackUpperBg)
clMonthlyLowerStackFittedExtensionBox := f_update_fitted_breakout_extension_box(clMonthlyLowerStackFittedExtensionBox, monthlyLowerFittedVisible and clFittedExtensionVisible, clZoneRightTime, clFittedExtensionRightTime, clPreviousMonthLow, monthlyLowerFittedTop, false, clMonthlyStackLowerBg)
clUpperH1GapFittedExtensionBox := f_update_fitted_breakout_extension_box(clUpperH1GapFittedExtensionBox, h1UpperFittedVisible and clFittedExtensionVisible, clZoneRightTime, clFittedExtensionRightTime, clPreviousHourHigh, h1UpperFittedBottom, true, clH1UpperBg)
clLowerH1GapFittedExtensionBox := f_update_fitted_breakout_extension_box(clLowerH1GapFittedExtensionBox, h1LowerFittedVisible and clFittedExtensionVisible, clZoneRightTime, clFittedExtensionRightTime, clPreviousHourLow, h1LowerFittedTop, false, clH1LowerBg)
clUpperFourHourBreakoutFittedExtensionBox := f_update_fitted_breakout_extension_box(clUpperFourHourBreakoutFittedExtensionBox, fourHourUpperFittedVisible and clFittedExtensionVisible, clZoneRightTime, clFittedExtensionRightTime, clLatestClosed4HHigh, fourHourUpperFittedBottom, true, clUpperBreakoutBg)
clLowerFourHourBreakoutFittedExtensionBox := f_update_fitted_breakout_extension_box(clLowerFourHourBreakoutFittedExtensionBox, fourHourLowerFittedVisible and clFittedExtensionVisible, clZoneRightTime, clFittedExtensionRightTime, clLatestClosed4HLow, fourHourLowerFittedTop, false, clLowerBreakoutBg)

clHourlyAnchorChanged = nz(ta.change(clPreviousHourStartTime), 0) != 0
clFourHourUpperAnchorChanged = nz(ta.change(clLatestClosed4HHighTime), 0) != 0
clFourHourLowerAnchorChanged = nz(ta.change(clLatestClosed4HLowTime), 0) != 0
clDailyUpperAnchorChanged = nz(ta.change(clPreviousDayHighTime), 0) != 0
clDailyLowerAnchorChanged = nz(ta.change(clPreviousDayLowTime), 0) != 0
clWeeklyUpperAnchorChanged = nz(ta.change(clPreviousWeekHighTime), 0) != 0
clWeeklyLowerAnchorChanged = nz(ta.change(clPreviousWeekLowTime), 0) != 0
clMonthlyUpperAnchorChanged = nz(ta.change(clPreviousMonthHighTime), 0) != 0
clMonthlyLowerAnchorChanged = nz(ta.change(clPreviousMonthLowTime), 0) != 0

if not clKeepClearedHourlyActive or clHourlyAnchorChanged
    clRetainedUpperH1GapBox := f_delete_zone_box(clRetainedUpperH1GapBox)
    clRetainedLowerH1GapBox := f_delete_zone_box(clRetainedLowerH1GapBox)
if not clKeepClearedFourHourActive or clFourHourUpperAnchorChanged
    clRetainedUpperFourHourBreakoutBox := f_delete_zone_box(clRetainedUpperFourHourBreakoutBox)
if not clKeepClearedFourHourActive or clFourHourLowerAnchorChanged
    clRetainedLowerFourHourBreakoutBox := f_delete_zone_box(clRetainedLowerFourHourBreakoutBox)
if not clKeepClearedDailyActive or clDailyUpperAnchorChanged
    clRetainedUpperStackBox := f_delete_zone_box(clRetainedUpperStackBox)
if not clKeepClearedDailyActive or clDailyLowerAnchorChanged
    clRetainedLowerStackBox := f_delete_zone_box(clRetainedLowerStackBox)
if not clKeepClearedWeeklyActive or clWeeklyUpperAnchorChanged
    clRetainedWeeklyUpperStackBox := f_delete_zone_box(clRetainedWeeklyUpperStackBox)
if not clKeepClearedWeeklyActive or clWeeklyLowerAnchorChanged
    clRetainedWeeklyLowerStackBox := f_delete_zone_box(clRetainedWeeklyLowerStackBox)
if not clKeepClearedMonthlyActive or clMonthlyUpperAnchorChanged
    clRetainedMonthlyUpperStackBox := f_delete_zone_box(clRetainedMonthlyUpperStackBox)
if not clKeepClearedMonthlyActive or clMonthlyLowerAnchorChanged
    clRetainedMonthlyLowerStackBox := f_delete_zone_box(clRetainedMonthlyLowerStackBox)

upperStackCleared = clKeepClearedDailyActive and not clDailyUpperAnchorChanged and nz(upperStackActive[1], false) and not upperStackActive and (clPrevDayHighTakenToday or (clUpperStackDataReady and clLatestClosed4HHigh >= clPreviousDayHigh))
lowerStackCleared = clKeepClearedDailyActive and not clDailyLowerAnchorChanged and nz(lowerStackActive[1], false) and not lowerStackActive and (clPrevDayLowTakenToday or (clLowerStackDataReady and clLatestClosed4HLow <= clPreviousDayLow))
weeklyUpperStackCleared = clKeepClearedWeeklyActive and not clWeeklyUpperAnchorChanged and nz(weeklyUpperStackActive[1], false) and not weeklyUpperStackActive and (clPrevWeekHighTakenThisWeek or (weeklyUpperStackDataReady and clLatestClosedDailyHigh >= clPreviousWeekHigh))
weeklyLowerStackCleared = clKeepClearedWeeklyActive and not clWeeklyLowerAnchorChanged and nz(weeklyLowerStackActive[1], false) and not weeklyLowerStackActive and (clPrevWeekLowTakenThisWeek or (weeklyLowerStackDataReady and clLatestClosedDailyLow <= clPreviousWeekLow))
monthlyUpperStackCleared = clKeepClearedMonthlyActive and not clMonthlyUpperAnchorChanged and nz(monthlyUpperStackActive[1], false) and not monthlyUpperStackActive and (clPrevMonthHighTakenThisMonth or (monthlyUpperStackDataReady and clLatestClosedDailyHigh >= clPreviousMonthHigh))
monthlyLowerStackCleared = clKeepClearedMonthlyActive and not clMonthlyLowerAnchorChanged and nz(monthlyLowerStackActive[1], false) and not monthlyLowerStackActive and (clPrevMonthLowTakenThisMonth or (monthlyLowerStackDataReady and clLatestClosedDailyLow <= clPreviousMonthLow))
h1UpperGapCleared = clKeepClearedHourlyActive and not clHourlyAnchorChanged and nz(clUpperH1GapVisible[1], false) and not clUpperH1GapVisible and not na(clCurrentHourHigh) and not na(clPreviousHourHigh) and clCurrentHourHigh >= clPreviousHourHigh
h1LowerGapCleared = clKeepClearedHourlyActive and not clHourlyAnchorChanged and nz(clLowerH1GapVisible[1], false) and not clLowerH1GapVisible and not na(clCurrentHourLow) and not na(clPreviousHourLow) and clCurrentHourLow <= clPreviousHourLow
fourHourUpperBreakoutCleared = clKeepClearedFourHourActive and not clFourHourUpperAnchorChanged and nz(clUpperFourHourBreakoutVisible[1], false) and not clUpperFourHourBreakoutVisible and fourHourUpperBreakoutDataReady and clCur4HHigh >= clLatestClosed4HHigh
fourHourLowerBreakoutCleared = clKeepClearedFourHourActive and not clFourHourLowerAnchorChanged and nz(clLowerFourHourBreakoutVisible[1], false) and not clLowerFourHourBreakoutVisible and fourHourLowerBreakoutDataReady and clCur4HLow <= clLatestClosed4HLow

if upperStackCleared
    clRetainedUpperStackBox := f_update_retained_zone_box(clRetainedUpperStackBox, true, upperStackLeftTime[1], clZoneRightTime, clBreakoutZoneFittedMode ? clPreviousDayHigh[1] : upperStackTop[1], clBreakoutZoneFittedMode ? upperStackFittedBottom[1] : upperStackBottom[1], clRetainedUpperBreakoutBg, clRetainedBreakoutBorder, clStackBorderWidth)
if lowerStackCleared
    clRetainedLowerStackBox := f_update_retained_zone_box(clRetainedLowerStackBox, true, lowerStackLeftTime[1], clZoneRightTime, clBreakoutZoneFittedMode ? lowerStackFittedTop[1] : lowerStackTop[1], clBreakoutZoneFittedMode ? clPreviousDayLow[1] : lowerStackBottom[1], clRetainedLowerBreakoutBg, clRetainedBreakoutBorder, clStackBorderWidth)
if weeklyUpperStackCleared
    clRetainedWeeklyUpperStackBox := f_update_retained_zone_box(clRetainedWeeklyUpperStackBox, true, weeklyUpperLeftTime[1], clZoneRightTime, clBreakoutZoneFittedMode ? clPreviousWeekHigh[1] : weeklyUpperStackTop[1], clBreakoutZoneFittedMode ? weeklyUpperFittedBottom[1] : weeklyUpperStackBottom[1], clRetainedUpperBreakoutBg, clRetainedBreakoutBorder, clWeeklyDailyStackBorderWidth)
if weeklyLowerStackCleared
    clRetainedWeeklyLowerStackBox := f_update_retained_zone_box(clRetainedWeeklyLowerStackBox, true, weeklyLowerLeftTime[1], clZoneRightTime, clBreakoutZoneFittedMode ? weeklyLowerFittedTop[1] : weeklyLowerStackTop[1], clBreakoutZoneFittedMode ? clPreviousWeekLow[1] : weeklyLowerStackBottom[1], clRetainedLowerBreakoutBg, clRetainedBreakoutBorder, clWeeklyDailyStackBorderWidth)
if monthlyUpperStackCleared
    clRetainedMonthlyUpperStackBox := f_update_retained_zone_box(clRetainedMonthlyUpperStackBox, true, monthlyUpperLeftTime[1], clZoneRightTime, clBreakoutZoneFittedMode ? clPreviousMonthHigh[1] : monthlyUpperStackTop[1], clBreakoutZoneFittedMode ? monthlyUpperFittedBottom[1] : monthlyUpperStackBottom[1], clRetainedUpperBreakoutBg, clRetainedBreakoutBorder, clMonthlyDailyStackBorderWidth)
if monthlyLowerStackCleared
    clRetainedMonthlyLowerStackBox := f_update_retained_zone_box(clRetainedMonthlyLowerStackBox, true, monthlyLowerLeftTime[1], clZoneRightTime, clBreakoutZoneFittedMode ? monthlyLowerFittedTop[1] : monthlyLowerStackTop[1], clBreakoutZoneFittedMode ? clPreviousMonthLow[1] : monthlyLowerStackBottom[1], clRetainedLowerBreakoutBg, clRetainedBreakoutBorder, clMonthlyDailyStackBorderWidth)
if h1UpperGapCleared
    clRetainedUpperH1GapBox := f_update_retained_zone_box(clRetainedUpperH1GapBox, true, clH1GapLeftTime[1], clZoneRightTime, clBreakoutZoneFittedMode ? clPreviousHourHigh[1] : h1UpperGapTop[1], clBreakoutZoneFittedMode ? h1UpperFittedBottom[1] : h1UpperGapBottom[1], clRetainedUpperBreakoutBg, clRetainedBreakoutBorder, clH1GapBorderWidth)
if h1LowerGapCleared
    clRetainedLowerH1GapBox := f_update_retained_zone_box(clRetainedLowerH1GapBox, true, clH1GapLeftTime[1], clZoneRightTime, clBreakoutZoneFittedMode ? h1LowerFittedTop[1] : h1LowerGapTop[1], clBreakoutZoneFittedMode ? clPreviousHourLow[1] : h1LowerGapBottom[1], clRetainedLowerBreakoutBg, clRetainedBreakoutBorder, clH1GapBorderWidth)
if fourHourUpperBreakoutCleared
    clRetainedUpperFourHourBreakoutBox := f_update_retained_zone_box(clRetainedUpperFourHourBreakoutBox, true, clFourHourBreakoutLeftTime[1], clZoneRightTime, clBreakoutZoneFittedMode ? clLatestClosed4HHigh[1] : fourHourUpperBreakoutTop[1], clBreakoutZoneFittedMode ? fourHourUpperFittedBottom[1] : fourHourUpperBreakoutBottom[1], clRetainedUpperBreakoutBg, clRetainedBreakoutBorder, clBreakoutBorderWidth)
if fourHourLowerBreakoutCleared
    clRetainedLowerFourHourBreakoutBox := f_update_retained_zone_box(clRetainedLowerFourHourBreakoutBox, true, clFourHourBreakoutLeftTime[1], clZoneRightTime, clBreakoutZoneFittedMode ? fourHourLowerFittedTop[1] : fourHourLowerBreakoutTop[1], clBreakoutZoneFittedMode ? clLatestClosed4HLow[1] : fourHourLowerBreakoutBottom[1], clRetainedLowerBreakoutBg, clRetainedBreakoutBorder, clBreakoutBorderWidth)

if upperStackActive
    if clBreakoutZoneFittedMode
        if not na(clUpperStackBox)
            box.delete(clUpperStackBox)
            clUpperStackBox := na
    else if clBreakoutZoneFloatingMode
        clUpperStackBox := f_update_zone_box_index(clUpperStackBox, bar_index - clFloatingWindowBarsBack, bar_index + clFloatingWindowBarsForward, upperStackTop, upperStackBottom, clStackUpperBg, clStackBorder, clStackBorderWidth)
    else if clBreakoutZoneAnchoredMode
        clUpperStackBox := f_update_zone_box(clUpperStackBox, upperStackLeftTime, upperStackRightTime, upperStackTop, upperStackBottom, clStackUpperBg, clStackBorder, clStackBorderWidth, clExtendStackZonesRight)
    if clShowStackLabels
        clUpperStackLabel := f_update_zone_label(clUpperStackLabel, clZoneRightTime, (upperStackTop + upperStackBottom) / 2.0, "Upper Daily Breakout", clStackLabelTextColor, f_zone_label_size(clStackLabelSizeInput))
    else
        if not na(clUpperStackLabel)
            label.delete(clUpperStackLabel)
            clUpperStackLabel := na
    if clShowPointsTillBreakLabels
        upperStackPointsX = clBreakoutZoneFloatingMode ? f_floating_points_label_x() : f_points_label_x(upperStackLeftBarIndex, upperStackRightBarIndex, clExtendStackZonesRight)
        upperStackPointsY = clBreakoutZoneFittedMode ? (clPreviousDayHigh + upperStackFittedBottom) / 2.0 : (upperStackTop + upperStackBottom) / 2.0
        clUpperStackPointsLabel := f_update_points_label(clUpperStackPointsLabel, upperStackPointsX, upperStackPointsY, f_zone_points_text(clBreakoutZoneFittedMode ? clPreviousDayHigh : upperStackTop, clBreakoutZoneFittedMode ? upperStackFittedBottom : upperStackBottom, "daily"), clPointsTillBreakLabelTextColor, f_zone_label_size(clPointsTillBreakLabelSizeInput))
    else
        if not na(clUpperStackPointsLabel)
            label.delete(clUpperStackPointsLabel)
            clUpperStackPointsLabel := na
    if clShowStackAnchorMarkers
        clPrevDayHighAnchorLabel := f_update_anchor_label(clPrevDayHighAnchorLabel, clPreviousDayHighTime, clPreviousDayHigh, "Prior Day High point", clStackLabelTextColor, label.style_label_down)
        clClosed4HHighAnchorLabel := f_update_anchor_label(clClosed4HHighAnchorLabel, clLatestClosed4HHighTime, clLatestClosed4HHigh, "Latest Closed 4H High point", clStackLabelTextColor, label.style_label_down)
    else
        if not na(clPrevDayHighAnchorLabel)
            label.delete(clPrevDayHighAnchorLabel)
            clPrevDayHighAnchorLabel := na
        if not na(clClosed4HHighAnchorLabel)
            label.delete(clClosed4HHighAnchorLabel)
            clClosed4HHighAnchorLabel := na
else
    if not na(clUpperStackBox)
        box.delete(clUpperStackBox)
        clUpperStackBox := na
    if not na(clUpperStackLabel)
        label.delete(clUpperStackLabel)
        clUpperStackLabel := na
    if not na(clUpperStackPointsLabel)
        label.delete(clUpperStackPointsLabel)
        clUpperStackPointsLabel := na
    if not na(clPrevDayHighAnchorLabel)
        label.delete(clPrevDayHighAnchorLabel)
        clPrevDayHighAnchorLabel := na
    if not na(clClosed4HHighAnchorLabel)
        label.delete(clClosed4HHighAnchorLabel)
        clClosed4HHighAnchorLabel := na

if lowerStackActive
    if clBreakoutZoneFittedMode
        if not na(clLowerStackBox)
            box.delete(clLowerStackBox)
            clLowerStackBox := na
    else if clBreakoutZoneFloatingMode
        clLowerStackBox := f_update_zone_box_index(clLowerStackBox, bar_index - clFloatingWindowBarsBack, bar_index + clFloatingWindowBarsForward, lowerStackTop, lowerStackBottom, clStackLowerBg, clStackBorder, clStackBorderWidth)
    else if clBreakoutZoneAnchoredMode
        clLowerStackBox := f_update_zone_box(clLowerStackBox, lowerStackLeftTime, lowerStackRightTime, lowerStackTop, lowerStackBottom, clStackLowerBg, clStackBorder, clStackBorderWidth, clExtendStackZonesRight)
