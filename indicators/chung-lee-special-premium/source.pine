var box clMonthlyLowerStackFittedExtensionBox = na
var box clUpperH1GapFittedExtensionBox = na
var box clLowerH1GapFittedExtensionBox = na
var box clUpperFourHourBreakoutFittedExtensionBox = na
var box clLowerFourHourBreakoutFittedExtensionBox = na

var label clUpperStackLabel = na
var label clLowerStackLabel = na
var label clWeeklyUpperStackLabel = na
var label clWeeklyLowerStackLabel = na
var label clMonthlyUpperStackLabel = na
var label clMonthlyLowerStackLabel = na
var label clUpperH1GapLabel = na
var label clLowerH1GapLabel = na
var label clUpperFourHourBreakoutLabel = na
var label clLowerFourHourBreakoutLabel = na
