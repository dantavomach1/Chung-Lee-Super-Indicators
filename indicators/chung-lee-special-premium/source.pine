else
    if not na(clLowerStackBox)
        box.delete(clLowerStackBox)
        clLowerStackBox := na
    if not na(clLowerStackLabel)
        label.delete(clLowerStackLabel)
        clLowerStackLabel := na
    if not na(clPrevDayLowAnchorLabel)
        label.delete(clPrevDayLowAnchorLabel)
        clPrevDayLowAnchorLabel := na
    if not na(clClosed4HLowAnchorLabel)
        label.delete(clClosed4HLowAnchorLabel)
        clClosed4HLowAnchorLabel := na

if weeklyUpperStackActive
    clWeeklyUpperStackBox := f_update_zone_box(clWeeklyUpperStackBox, weeklyUpperLeftTime, weeklyUpperRightTime, weeklyUpperStackTop, weeklyUpperStackBottom, clWeeklyStackUpperBg, clWeeklyStackBorder, clWeeklyDailyStackBorderWidth, clExtendWeeklyDailyStackZonesRight)
    if clShowWeeklyDailyStackLabels
        clWeeklyUpperStackLabel := f_update_zone_label(clWeeklyUpperStackLabel, clZoneRightTime, (weeklyUpperStackTop + weeklyUpperStackBottom) / 2.0, "Upper Weekly / Daily Stack", clWeeklyDailyStackLabelTextColor, f_zone_label_size(clWeeklyDailyStackLabelSizeInput))
    else
        if not na(clWeeklyUpperStackLabel)
            label.delete(clWeeklyUpperStackLabel)
