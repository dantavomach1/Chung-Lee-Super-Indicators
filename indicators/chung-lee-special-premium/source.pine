            clWeeklyLowerStackBox := na
    else if clBreakoutZoneFloatingMode
        clWeeklyLowerStackBox := f_update_zone_box_index(clWeeklyLowerStackBox, bar_index - clFloatingWindowBarsBack, bar_index + clFloatingWindowBarsForward, weeklyLowerStackTop, weeklyLowerStackBottom, clWeeklyStackLowerBg, clWeeklyStackBorder, clWeeklyDailyStackBorderWidth)
    else if clBreakoutZoneAnchoredMode
        clWeeklyLowerStackBox := f_update_zone_box(clWeeklyLowerStackBox, weeklyLowerLeftTime, weeklyLowerRightTime, weeklyLowerStackTop, weeklyLowerStackBottom, clWeeklyStackLowerBg, clWeeklyStackBorder, clWeeklyDailyStackBorderWidth, clExtendWeeklyDailyStackZonesRight)
    if clShowWeeklyDailyStackLabels
        clWeeklyLowerStackLabel := f_update_zone_label(clWeeklyLowerStackLabel, clZoneRightTime, (weeklyLowerStackTop + weeklyLowerStackBottom) / 2.0, "Lower Weekly Breakout", clWeeklyDailyStackLabelTextColor, f_zone_label_size(clWeeklyDailyStackLabelSizeInput))
    else
        if not na(clWeeklyLowerStackLabel)
            label.delete(clWeeklyLowerStackLabel)
            clWeeklyLowerStackLabel := na
    if clShowPointsTillBreakLabels
        weeklyLowerPointsX = clBreakoutZoneFloatingMode ? f_floating_points_label_x() : f_points_label_x(weeklyLowerLeftBarIndex, weeklyLowerRightBarIndex, clExtendWeeklyDailyStackZonesRight)
        weeklyLowerPointsY = clBreakoutZoneFittedMode ? (clPreviousWeekLow + weeklyLowerFittedTop) / 2.0 : (weeklyLowerStackTop + weeklyLowerStackBottom) / 2.0
        clWeeklyLowerStackPointsLabel := f_update_points_label(clWeeklyLowerStackPointsLabel, weeklyLowerPointsX, weeklyLowerPointsY, f_zone_points_text(clBreakoutZoneFittedMode ? weeklyLowerFittedTop : weeklyLowerStackTop, clBreakoutZoneFittedMode ? clPreviousWeekLow : weeklyLowerStackBottom, "weekly"), clPointsTillBreakLabelTextColor, f_zone_label_size(clPointsTillBreakLabelSizeInput))
    else
