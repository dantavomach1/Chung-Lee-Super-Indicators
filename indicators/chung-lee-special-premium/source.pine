    if clShowMonthlyDailyStackLabels
        clMonthlyUpperStackLabel := f_update_zone_label(clMonthlyUpperStackLabel, clZoneRightTime, (monthlyUpperStackTop + monthlyUpperStackBottom) / 2.0, "Upper Monthly / Daily Stack", clMonthlyDailyStackLabelTextColor, f_zone_label_size(clMonthlyDailyStackLabelSizeInput))
    else
        if not na(clMonthlyUpperStackLabel)
            label.delete(clMonthlyUpperStackLabel)
            clMonthlyUpperStackLabel := na
else
