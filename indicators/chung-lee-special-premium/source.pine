        clLowerStackLabel := f_update_zone_label(clLowerStackLabel, clZoneRightTime, (lowerStackTop + lowerStackBottom) / 2.0, "Lower Daily Breakout", clStackLabelTextColor, f_zone_label_size(clStackLabelSizeInput))
    else
        if not na(clLowerStackLabel)
            label.delete(clLowerStackLabel)
            clLowerStackLabel := na
    if clShowPointsTillBreakLabels
