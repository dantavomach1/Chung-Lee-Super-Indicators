//=================================================================================================================
// SECTION 2 – SHARED HELPER FUNCTIONS
//=================================================================================================================
openSession(inSession) =>
    var float result = na
    if inSession and not inSession[1]
        result := open
    result

closeSession(inSession) =>
    var float result = na
    if inSession
        result := close
    result

highSession(inSession) =>
    var float result = na
    if inSession and not inSession[1]
        result := high
    else if inSession
        result := math.max(result, high)
    result

lowSession(inSession) =>
    var float result = na
    if inSession and not inSession[1]
        result := low
    else if inSession
        result := math.min(result, low)
    result

openTimeSession(inSession) =>
    var int _openTime = na
    if inSession and not inSession[1]
        _openTime := time
    int result = _openTime

f_round_to_tick(v) => math.round(v / syminfo.mintick) * syminfo.mintick
f_fmt_pts(v) => str.tostring(f_round_to_tick(v), format.mintick) + "pts"
f_ampm(h) => h >= 12 ? "PM" : "AM"
f_h12(h) => h % 12 == 0 ? 12 : h % 12

f_time_range_label(_start, _end, _tz) =>
    h1 = hour(_start, _tz)
    h2 = hour(_end, _tz)
    a1 = f_ampm(h1)
    a2 = f_ampm(h2)
    s1 = str.tostring(f_h12(h1))
    s2 = str.tostring(f_h12(h2))
    a1 == a2 ? s1 + "-" + s2 + a2 : s1 + a1 + "-" + s2 + a2

f_dow(d) =>
    d == dayofweek.monday ? "Mon" :
     d == dayofweek.tuesday ? "Tue" :
     d == dayofweek.wednesday ? "Wed" :
     d == dayofweek.thursday ? "Thu" :
     d == dayofweek.friday ? "Fri" :
     d == dayofweek.saturday ? "Sat" : "Sun"

f_panel_position(_location) =>
    _location == "Top Left" ? position.top_left :
     _location == "Top Right" ? position.top_right :
     _location == "Bottom Left" ? position.bottom_left : position.bottom_right

f_htf_distance_table_position(_location) =>
    _location == "Top Center" ? position.top_center :
     _location == "Top Right" ? position.top_right :
     _location == "Top Left" ? position.top_left :
     _location == "Middle Right" ? position.middle_right : position.bottom_right

f_panel_text_size(_size) =>
    _size == "Tiny" ? size.tiny :
     _size == "Normal" ? size.normal :
     _size == "Large" ? size.large : size.small

f_zone_label_size(_size) =>
    _size == "Tiny" ? size.tiny :
     _size == "Normal" ? size.normal :
     _size == "Large" ? size.large : size.small

f_symbol_root() =>
    syminfo.root == "" ? str.upper(syminfo.ticker) : str.upper(syminfo.root)

f_money(_v) =>
    "$" + str.tostring(_v, "#,##0.00")

f_normalize_token(_s) =>
    str.upper(str.replace_all(_s, " ", ""))

f_zone_near(_price, _top, _bottom, _distance) =>
    zoneTop = math.max(_top, _bottom)
    zoneBottom = math.min(_top, _bottom)
    ready = not na(_price) and not na(zoneTop) and not na(zoneBottom) and not na(_distance)
    inside = ready and _price <= zoneTop and _price >= zoneBottom
    edgeDistance = ready ? (_price > zoneTop ? _price - zoneTop : _price < zoneBottom ? zoneBottom - _price : 0.0) : na
    ready and not inside and edgeDistance > 0 and edgeDistance <= _distance

f_zone_entered(_top, _bottom, _basis) =>
    zoneTop = math.max(_top, _bottom)
    zoneBottom = math.min(_top, _bottom)
    ready = not na(zoneTop) and not na(zoneBottom)
    ready and (_basis == "Wick Touch" ? (high >= zoneBottom and low <= zoneTop) : (close <= zoneTop and close >= zoneBottom))

f_zone_clear_above(_top, _basis) =>
    not na(_top) and (_basis == "Wick Touch" ? high >= _top : close > _top)

f_zone_clear_below(_bottom, _basis) =>
    not na(_bottom) and (_basis == "Wick Touch" ? low <= _bottom : close < _bottom)

f_update_zone_box(_box, _left, _right, _top, _bottom, _bgColor, _borderColor, _borderWidth, _extendRight) =>
    box result = _box
    if na(result)
        result := box.new(_left, _top, _right, _bottom, xloc=xloc.bar_time, extend=_extendRight ? extend.right : extend.none, bgcolor=_bgColor, border_color=_borderColor, border_width=_borderWidth)
    else
        box.set_left(result, _left)
        box.set_right(result, _right)
        box.set_top(result, _top)
        box.set_bottom(result, _bottom)
        box.set_bgcolor(result, _bgColor)
        box.set_border_color(result, _borderColor)
        box.set_border_width(result, _borderWidth)
        box.set_extend(result, _extendRight ? extend.right : extend.none)
    result

f_update_zone_label(_label, _x, _y, _text, _textColor, _size) =>
    label result = _label
    if na(result)
        result := label.new(_x, _y, _text, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.black, 100), textcolor=_textColor, size=_size)
    else
        label.set_x(result, _x)
        label.set_y(result, _y)
        label.set_text(result, _text)
        label.set_textcolor(result, _textColor)
        label.set_size(result, _size)
        label.set_color(result, color.new(color.black, 100))
        label.set_style(result, label.style_label_left)
    result

f_update_anchor_label(_label, _x, _y, _text, _textColor, _style) =>
    label result = _label
    if na(result)
        result := label.new(_x, _y, _text, xloc=xloc.bar_time, yloc=yloc.price, style=_style, color=color.new(color.black, 88), textcolor=_textColor, size=size.tiny)
    else
        label.set_x(result, _x)
        label.set_y(result, _y)
        label.set_text(result, _text)
        label.set_textcolor(result, _textColor)
        label.set_style(result, _style)
        label.set_color(result, color.new(color.black, 88))
        label.set_size(result, size.tiny)
    result

f_htf_distance_text(_level, _isHigh, _signed) =>
    if na(_level) or na(close)
        "—"
    else
        rawDistance = _signed ? (_isHigh ? _level - close : close - _level) : math.abs(_level - close)
        roundedDistance = int(math.round(rawDistance))
        _signed and roundedDistance > 0 ? "+" + str.tostring(roundedDistance) : str.tostring(roundedDistance)

baseOff = syminfo.mintick * LabelBaseOffsetTicks
gapOff  = syminfo.mintick * LabelSpacingTicks

//=================================================================================================================
// SECTION 3 – SESSION DEFINITIONS
//=================================================================================================================
InSession1 = not na(time(timeframe.period, "0000-0100,0200-0300,0400-0500,0600-0700,0800-0900,1000-1100,1200-1300,1400-1500,1600-1700,2000-2100,2200-2300", "America/New_York"))
InSession2 = not na(time(timeframe.period, "0100-0200,0300-0400,0500-0600,0700-0800,0900-1000,1100-1200,1300-1400,1500-1600,1700-1800,1900-2000,2100-2200,2300-0000", "America/New_York"))
InSession3 = not na(time(timeframe.period, "1800-1900", "America/New_York"))
InSession4 = not na(time(timeframe.period, "2200-0200,0600-1000,1400-1700", "America/New_York"))
InSession5 = not na(time(timeframe.period, "0200-0600,1800-2200", "America/New_York"))
InSession9 = not na(time(timeframe.period, "1000-1400", "America/New_York"))
InSession6 = not na(time(timeframe.period, "1800-1700:24", "America/New_York"))
InSession7 = not na(time(timeframe.period, "1800-1700:35", "America/New_York"))
InSession8 = not na(time(timeframe.period, "1800-1700:6", "America/New_York"))

//=================================================================================================================
// SECTION 4 – HOURLY OVERLAYS
//=================================================================================================================
var float hrOpen  = na
var float hrHigh  = na
var float hrLow   = na
var float hrClose = na
var int   hrStart = na

var box  hrBoxLive  = na
var line hrWickLive = na
var line hrTailLive = na

var label hrLblTimeLive = na
var label hrLblWWLive   = na
var label hrLblOCLive   = na

isPacificHour() => hour(time, tzOverlay)
isNewHour = (isPacificHour() != isPacificHour()[1]) or (time("D") != time("D")[1])

if allowHourlyOverlay and isNewHour and not na(hrOpen)
    box.new(hrStart, hrOpen, hrStart + 60 * 60 * 1000, hrClose, xloc=xloc.bar_time, border_color=hrOpen >= hrClose ? BullishCandleBorderColor : BearishCandleBorderColor, bgcolor=hrOpen >= hrClose ? BullishCandleColor : BearishCandleColor, border_width=CandleStickBorderWidth)
    line.new(hrStart + 30 * 60 * 1000, hrHigh, hrStart + 30 * 60 * 1000, math.max(hrOpen, hrClose), xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    line.new(hrStart + 30 * 60 * 1000, math.min(hrOpen, hrClose), hrStart + 30 * 60 * 1000, hrLow, xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    ww_hr_done = math.abs(hrHigh - hrLow)
    oc_hr_done = math.abs(hrClose - hrOpen)
    xHrDone = hrStart + 30 * 60 * 1000
    yWWDone = hrHigh + baseOff
    yOCDone = yWWDone - gapOff
    yTDone  = yWWDone + gapOff
    tHrDone = f_time_range_label(hrStart, hrStart + 60 * 60 * 1000, tzOverlay)
    if ShowLabel_Time
        label.new(xHrDone, yTDone, tHrDone, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_WW
        label.new(xHrDone, yWWDone, "W-W: " + f_fmt_pts(ww_hr_done), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_OC
        label.new(xHrDone, yOCDone, "O-C: " + f_fmt_pts(oc_hr_done), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    hrOpen := open
    hrHigh := high
    hrLow := low
    hrClose := close
    hrStart := time
else if allowHourlyOverlay
    if na(hrOpen)
        hrOpen := open
        hrHigh := high
        hrLow := low
        hrClose := close
        hrStart := time
    else
        hrHigh := math.max(hrHigh, high)
        hrLow := math.min(hrLow, low)
        hrClose := close

if allowHourlyOverlay and barstate.islast and not na(hrOpen)
    hrMid = hrStart + int((time - hrStart) / 2)
    if not na(hrBoxLive)
        box.delete(hrBoxLive)
    if not na(hrWickLive)
        line.delete(hrWickLive)
    if not na(hrTailLive)
        line.delete(hrTailLive)
    hrBoxLive := box.new(hrStart, hrOpen, time, hrClose, xloc=xloc.bar_time, border_color=hrOpen >= hrClose ? BullishCandleBorderColor : BearishCandleBorderColor, bgcolor=hrOpen >= hrClose ? BullishCandleColor : BearishCandleColor, border_width=CandleStickBorderWidth)
    hrWickLive := line.new(hrMid, hrHigh, hrMid, math.max(hrOpen, hrClose), xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    hrTailLive := line.new(hrMid, math.min(hrOpen, hrClose), hrMid, hrLow, xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    if not na(hrLblTimeLive)
        label.delete(hrLblTimeLive)
        hrLblTimeLive := na
    if not na(hrLblWWLive)
        label.delete(hrLblWWLive)
        hrLblWWLive := na
    if not na(hrLblOCLive)
        label.delete(hrLblOCLive)
        hrLblOCLive := na
    ww_hr = math.abs(hrHigh - hrLow)
    oc_hr = math.abs(hrClose - hrOpen)
    yWW = hrHigh + baseOff
    yOC = yWW - gapOff
    yT  = yWW + gapOff
    tHr = f_time_range_label(hrStart, hrStart + 60 * 60 * 1000, tzOverlay)
    if ShowLabel_Time
        hrLblTimeLive := label.new(hrMid, yT, tHr, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_WW
        hrLblWWLive := label.new(hrMid, yWW, "W-W: " + f_fmt_pts(ww_hr), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_OC
        hrLblOCLive := label.new(hrMid, yOC, "O-C: " + f_fmt_pts(oc_hr), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
else
    if not na(hrBoxLive)
        box.delete(hrBoxLive)
        hrBoxLive := na
    if not na(hrWickLive)
        line.delete(hrWickLive)
        hrWickLive := na
    if not na(hrTailLive)
        line.delete(hrTailLive)
        hrTailLive := na
    if not na(hrLblTimeLive)
        label.delete(hrLblTimeLive)
        hrLblTimeLive := na
    if not na(hrLblWWLive)
        label.delete(hrLblWWLive)
        hrLblWWLive := na
    if not na(hrLblOCLive)
        label.delete(hrLblOCLive)
        hrLblOCLive := na

//=================================================================================================================
// SECTION 5 – FOUR-HOUR OVERLAYS
//=================================================================================================================
var float fhOpen  = na
var float fhHigh  = na
var float fhLow   = na
var float fhClose = na
var int   fhStart = na

var box  fhBoxLive  = na
var line fhWickLive = na
var line fhTailLive = na

var label fhLblTimeLive = na
var label fhLblWWLive   = na
var label fhLblOCLive   = na

desiredStart = 15
currentHourPT = hour(time, tzOverlay)
prevHourPT    = hour(time[1], tzOverlay)
currentBlock  = math.floor(((currentHourPT - desiredStart + 24) % 24) / 4)
prevBlock     = math.floor(((prevHourPT - desiredStart + 24) % 24) / 4)
isNewFourHour = (currentBlock != prevBlock) or (time("D") != time("D")[1])

if allowFourHourOverlay and isNewFourHour and not na(fhOpen)
    box.new(fhStart, fhOpen, fhStart + 4 * 60 * 60 * 1000, fhClose, xloc=xloc.bar_time, border_color=fhOpen >= fhClose ? BullishCandleBorderColor : BearishCandleBorderColor, bgcolor=fhOpen >= fhClose ? BullishCandleColor : BearishCandleColor, border_width=CandleStickBorderWidth)
    line.new(fhStart + 2 * 60 * 60 * 1000, fhHigh, fhStart + 2 * 60 * 60 * 1000, math.max(fhOpen, fhClose), xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    line.new(fhStart + 2 * 60 * 60 * 1000, math.min(fhOpen, fhClose), fhStart + 2 * 60 * 60 * 1000, fhLow, xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    ww_fh_done = math.abs(fhHigh - fhLow)
    oc_fh_done = math.abs(fhClose - fhOpen)
    xFhDone    = fhStart + 2 * 60 * 60 * 1000
    yWWDone_fh = fhHigh + baseOff
    yOCDone_fh = yWWDone_fh - gapOff
    yTDone_fh  = yWWDone_fh + gapOff
    tFhDone    = f_time_range_label(fhStart, fhStart + 4 * 60 * 60 * 1000, tzOverlay)
    if ShowLabel_Time
        label.new(xFhDone, yTDone_fh, tFhDone, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_WW
        label.new(xFhDone, yWWDone_fh, "W-W: " + f_fmt_pts(ww_fh_done), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_OC
        label.new(xFhDone, yOCDone_fh, "O-C: " + f_fmt_pts(oc_fh_done), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    fhOpen := open
    fhHigh := high
    fhLow := low
    fhClose := close
    fhStart := time
else if allowFourHourOverlay
    if na(fhOpen)
        fhOpen := open
        fhHigh := high
        fhLow := low
        fhClose := close
        fhStart := time
    else
        fhHigh := math.max(fhHigh, high)
        fhLow := math.min(fhLow, low)
        fhClose := close

if allowFourHourOverlay and barstate.islast and not na(fhOpen)
    fhMid = fhStart + int((time - fhStart) / 2)
    if not na(fhBoxLive)
        box.delete(fhBoxLive)
    if not na(fhWickLive)
        line.delete(fhWickLive)
    if not na(fhTailLive)
        line.delete(fhTailLive)
    fhBoxLive := box.new(fhStart, fhOpen, time, fhClose, xloc=xloc.bar_time, border_color=fhOpen >= fhClose ? BullishCandleBorderColor : BearishCandleBorderColor, bgcolor=fhOpen >= fhClose ? BullishCandleColor : BearishCandleColor, border_width=CandleStickBorderWidth)
    fhWickLive := line.new(fhMid, fhHigh, fhMid, math.max(fhOpen, fhClose), xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    fhTailLive := line.new(fhMid, math.min(fhOpen, fhClose), fhMid, fhLow, xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    if not na(fhLblTimeLive)
        label.delete(fhLblTimeLive)
        fhLblTimeLive := na
    if not na(fhLblWWLive)
        label.delete(fhLblWWLive)
        fhLblWWLive := na
    if not na(fhLblOCLive)
        label.delete(fhLblOCLive)
        fhLblOCLive := na
    ww_fh = math.abs(fhHigh - fhLow)
    oc_fh = math.abs(fhClose - fhOpen)
    yWW_fh = fhHigh + baseOff
    yOC_fh = yWW_fh - gapOff
    yT_fh  = yWW_fh + gapOff
    tFh    = f_time_range_label(fhStart, fhStart + 4 * 60 * 60 * 1000, tzOverlay)
    if ShowLabel_Time
        fhLblTimeLive := label.new(fhMid, yT_fh, tFh, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_WW
        fhLblWWLive := label.new(fhMid, yWW_fh, "W-W: " + f_fmt_pts(ww_fh), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_OC
        fhLblOCLive := label.new(fhMid, yOC_fh, "O-C: " + f_fmt_pts(oc_fh), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
else
    if not na(fhBoxLive)
        box.delete(fhBoxLive)
        fhBoxLive := na
    if not na(fhWickLive)
        line.delete(fhWickLive)
        fhWickLive := na
    if not na(fhTailLive)
        line.delete(fhTailLive)
        fhTailLive := na
    if not na(fhLblTimeLive)
        label.delete(fhLblTimeLive)
        fhLblTimeLive := na
    if not na(fhLblWWLive)
        label.delete(fhLblWWLive)
        fhLblWWLive := na
    if not na(fhLblOCLive)
        label.delete(fhLblOCLive)
        fhLblOCLive := na

//=================================================================================================================
// SECTION 6 – DAILY OVERLAYS
//=================================================================================================================
var float dOpen  = na
var float dHigh  = na
var float dLow   = na
var float dClose = na
var int   dStart = na

var box  dBoxLive  = na
var line dWickLive = na
var line dTailLive = na

var label dLblTimeLive = na
var label dLblWWLive   = na
var label dLblOCLive   = na

isNewDay = time("D") != time("D")[1]

if allowDailyOverlay and isNewDay and not na(dOpen)
    box.new(dStart, dOpen, dStart + 24 * 60 * 60 * 1000, dClose, xloc=xloc.bar_time, border_color=dOpen >= dClose ? BullishCandleBorderColor : BearishCandleBorderColor, bgcolor=dOpen >= dClose ? BullishCandleColor : BearishCandleColor, border_width=CandleStickBorderWidth)
    line.new(dStart + 12 * 60 * 60 * 1000, dHigh, dStart + 12 * 60 * 60 * 1000, math.max(dOpen, dClose), xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    line.new(dStart + 12 * 60 * 60 * 1000, math.min(dOpen, dClose), dStart + 12 * 60 * 60 * 1000, dLow, xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    ww_d_done = math.abs(dHigh - dLow)
    oc_d_done = math.abs(dClose - dOpen)
    xDDone    = dStart + 12 * 60 * 60 * 1000
    yWWDone_d = dHigh + baseOff
    yOCDone_d = yWWDone_d - gapOff
    yTDone_d  = yWWDone_d + gapOff
    tDDone    = f_dow(dayofweek(dStart, tzOverlay)) + " " + str.format("{0,date,MMM d}", dStart)
    if ShowLabel_Time
        label.new(xDDone, yTDone_d, tDDone, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_WW
        label.new(xDDone, yWWDone_d, "W-W: " + f_fmt_pts(ww_d_done), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_OC
        label.new(xDDone, yOCDone_d, "O-C: " + f_fmt_pts(oc_d_done), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    dOpen := open
    dHigh := high
    dLow := low
    dClose := close
    dStart := time
else if allowDailyOverlay
    if na(dOpen)
        dOpen := open
        dHigh := high
        dLow := low
        dClose := close
        dStart := time
    else
        dHigh := math.max(dHigh, high)
        dLow := math.min(dLow, low)
        dClose := close

if allowDailyOverlay and barstate.islast and not na(dOpen)
    dMid = dStart + int((time - dStart) / 2)
    if not na(dBoxLive)
        box.delete(dBoxLive)
    if not na(dWickLive)
        line.delete(dWickLive)
    if not na(dTailLive)
        line.delete(dTailLive)
    dBoxLive := box.new(dStart, dOpen, time, dClose, xloc=xloc.bar_time, border_color=dOpen >= dClose ? BullishCandleBorderColor : BearishCandleBorderColor, bgcolor=dOpen >= dClose ? BullishCandleColor : BearishCandleColor, border_width=CandleStickBorderWidth)
    dWickLive := line.new(dMid, dHigh, dMid, math.max(dOpen, dClose), xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    dTailLive := line.new(dMid, math.min(dOpen, dClose), dMid, dLow, xloc=xloc.bar_time, color=WickColor, width=WickWidth)
    if not na(dLblTimeLive)
        label.delete(dLblTimeLive)
        dLblTimeLive := na
    if not na(dLblWWLive)
        label.delete(dLblWWLive)
        dLblWWLive := na
    if not na(dLblOCLive)
        label.delete(dLblOCLive)
        dLblOCLive := na
    ww_d = math.abs(dHigh - dLow)
    oc_d = math.abs(dClose - dOpen)
    yWW_d = dHigh + baseOff
    yOC_d = yWW_d - gapOff
    yT_d  = yWW_d + gapOff
    tD    = f_dow(dayofweek(dStart, tzOverlay)) + " " + str.format("{0,date,MMM d}", dStart)
    if ShowLabel_Time
        dLblTimeLive := label.new(dMid, yT_d, tD, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_WW
        dLblWWLive := label.new(dMid, yWW_d, "W-W: " + f_fmt_pts(ww_d), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
    if ShowLabel_OC
        dLblOCLive := label.new(dMid, yOC_d, "O-C: " + f_fmt_pts(oc_d), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=LabelBg, textcolor=LabelText, size=size.small)
else
    if not na(dBoxLive)
        box.delete(dBoxLive)
        dBoxLive := na
    if not na(dWickLive)
        line.delete(dWickLive)
        dWickLive := na
    if not na(dTailLive)
        line.delete(dTailLive)
        dTailLive := na
    if not na(dLblTimeLive)
        label.delete(dLblTimeLive)
        dLblTimeLive := na
    if not na(dLblWWLive)
        label.delete(dLblWWLive)
        dLblWWLive := na
    if not na(dLblOCLive)
        label.delete(dLblOCLive)
        dLblOCLive := na

//=================================================================================================================
// SECTION 6.5 – DAILY / 4H, WEEKLY / DAILY, MONTHLY / DAILY STACK ZONES, H1 SWEEP GAP ZONES, AND HTF TABLE
//=================================================================================================================
var float clCurDayHigh = na
var float clCurDayLow = na
var int clCurDayHighTime = na
var int clCurDayLowTime = na
var float clPreviousDayHigh = na
var float clPreviousDayLow = na
var int clPreviousDayHighTime = na
var int clPreviousDayLowTime = na
var bool clPrevDayHighTakenToday = false
var bool clPrevDayLowTakenToday = false

if na(clCurDayHigh)
    clCurDayHigh := high
    clCurDayLow := low
    clCurDayHighTime := time
    clCurDayLowTime := time
else if isNewDay
    clPreviousDayHigh := clCurDayHigh
    clPreviousDayLow := clCurDayLow
    clPreviousDayHighTime := clCurDayHighTime
    clPreviousDayLowTime := clCurDayLowTime
    clCurDayHigh := high
    clCurDayLow := low
    clCurDayHighTime := time
    clCurDayLowTime := time
    clPrevDayHighTakenToday := false
    clPrevDayLowTakenToday := false
else
    if high > clCurDayHigh
        clCurDayHigh := high
        clCurDayHighTime := time
    if low < clCurDayLow
        clCurDayLow := low
        clCurDayLowTime := time

if not na(clPreviousDayHigh) and high >= clPreviousDayHigh
    clPrevDayHighTakenToday := true

if not na(clPreviousDayLow) and low <= clPreviousDayLow
    clPrevDayLowTakenToday := true

clIsNewWeek = not na(time("W")[1]) and time("W") != time("W")[1]

var float clCurWeekHigh = na
var float clCurWeekLow = na
var int clCurWeekHighTime = na
var int clCurWeekLowTime = na
var float clPreviousWeekHigh = na
var float clPreviousWeekLow = na
var int clPreviousWeekHighTime = na
var int clPreviousWeekLowTime = na
var bool clPrevWeekHighTakenThisWeek = false
var bool clPrevWeekLowTakenThisWeek = false

if na(clCurWeekHigh)
    clCurWeekHigh := high
    clCurWeekLow := low
    clCurWeekHighTime := time
    clCurWeekLowTime := time
else if clIsNewWeek
    clPreviousWeekHigh := clCurWeekHigh
    clPreviousWeekLow := clCurWeekLow
    clPreviousWeekHighTime := clCurWeekHighTime
    clPreviousWeekLowTime := clCurWeekLowTime
    clCurWeekHigh := high
    clCurWeekLow := low
    clCurWeekHighTime := time
    clCurWeekLowTime := time
    clPrevWeekHighTakenThisWeek := false
    clPrevWeekLowTakenThisWeek := false
else
    if high > clCurWeekHigh
        clCurWeekHigh := high
        clCurWeekHighTime := time
    if low < clCurWeekLow
        clCurWeekLow := low
        clCurWeekLowTime := time

if not na(clPreviousWeekHigh) and high >= clPreviousWeekHigh
    clPrevWeekHighTakenThisWeek := true

if not na(clPreviousWeekLow) and low <= clPreviousWeekLow
    clPrevWeekLowTakenThisWeek := true

clIsNewMonth = not na(time("M")[1]) and time("M") != time("M")[1]

var float clCurMonthHigh = na
var float clCurMonthLow = na
var int clCurMonthHighTime = na
var int clCurMonthLowTime = na
var float clPreviousMonthHigh = na
var float clPreviousMonthLow = na
var int clPreviousMonthHighTime = na
var int clPreviousMonthLowTime = na
var bool clPrevMonthHighTakenThisMonth = false
var bool clPrevMonthLowTakenThisMonth = false

if na(clCurMonthHigh)
    clCurMonthHigh := high
    clCurMonthLow := low
    clCurMonthHighTime := time
    clCurMonthLowTime := time
else if clIsNewMonth
    clPreviousMonthHigh := clCurMonthHigh
    clPreviousMonthLow := clCurMonthLow
    clPreviousMonthHighTime := clCurMonthHighTime
    clPreviousMonthLowTime := clCurMonthLowTime
    clCurMonthHigh := high
    clCurMonthLow := low
    clCurMonthHighTime := time
    clCurMonthLowTime := time
    clPrevMonthHighTakenThisMonth := false
    clPrevMonthLowTakenThisMonth := false
else
    if high > clCurMonthHigh
        clCurMonthHigh := high
        clCurMonthHighTime := time
    if low < clCurMonthLow
        clCurMonthLow := low
        clCurMonthLowTime := time

if not na(clPreviousMonthHigh) and high >= clPreviousMonthHigh
    clPrevMonthHighTakenThisMonth := true

if not na(clPreviousMonthLow) and low <= clPreviousMonthLow
    clPrevMonthLowTakenThisMonth := true

var float clCur4HHigh = na
var float clCur4HLow = na
var int clCur4HHighTime = na
var int clCur4HLowTime = na
var float clLatestClosed4HHigh = na
var float clLatestClosed4HLow = na
var int clLatestClosed4HHighTime = na
var int clLatestClosed4HLowTime = na

if na(clCur4HHigh)
    clCur4HHigh := high
    clCur4HLow := low
    clCur4HHighTime := time
    clCur4HLowTime := time
else if isNewFourHour
    clLatestClosed4HHigh := clCur4HHigh
    clLatestClosed4HLow := clCur4HLow
    clLatestClosed4HHighTime := clCur4HHighTime
    clLatestClosed4HLowTime := clCur4HLowTime
    clCur4HHigh := high
    clCur4HLow := low
    clCur4HHighTime := time
    clCur4HLowTime := time
else
    if high > clCur4HHigh
        clCur4HHigh := high
        clCur4HHighTime := time
    if low < clCur4HLow
        clCur4HLow := low
        clCur4HLowTime := time

clPreviousHourHigh = request.security(syminfo.tickerid, "60", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
clPreviousHourLow = request.security(syminfo.tickerid, "60", low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
clCurrentHourHigh = request.security(syminfo.tickerid, "60", high, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
clCurrentHourLow = request.security(syminfo.tickerid, "60", low, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
clCurrentHourStartTime = request.security(syminfo.tickerid, "60", time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

clShowZonesAllowed = timeframe.isintraday
clBarMs = int(timeframe.in_seconds(timeframe.period) * 1000)
clZoneRightTime = time + clBarMs

clLatestClosedDailyHigh = clPreviousDayHigh
clLatestClosedDailyLow = clPreviousDayLow
clLatestClosedDailyHighTime = clPreviousDayHighTime
clLatestClosedDailyLowTime = clPreviousDayLowTime

clUpperStackDataReady = not na(clPreviousDayHigh) and not na(clPreviousDayHighTime) and not na(clLatestClosed4HHigh) and not na(clLatestClosed4HHighTime)
clLowerStackDataReady = not na(clPreviousDayLow) and not na(clPreviousDayLowTime) and not na(clLatestClosed4HLow) and not na(clLatestClosed4HLowTime)

upperStackTop = math.max(clPreviousDayHigh, clLatestClosed4HHigh)
upperStackBottom = math.min(clPreviousDayHigh, clLatestClosed4HHigh)
lowerStackTop = math.max(clPreviousDayLow, clLatestClosed4HLow)
lowerStackBottom = math.min(clPreviousDayLow, clLatestClosed4HLow)

upperStackLeftTime = clUpperStackDataReady ? math.min(clPreviousDayHighTime, clLatestClosed4HHighTime) : na
upperStackRightTime = clUpperStackDataReady ? math.max(clPreviousDayHighTime, clLatestClosed4HHighTime) : na
lowerStackLeftTime = clLowerStackDataReady ? math.min(clPreviousDayLowTime, clLatestClosed4HLowTime) : na
lowerStackRightTime = clLowerStackDataReady ? math.max(clPreviousDayLowTime, clLatestClosed4HLowTime) : na

upperStackActive = clShowZonesAllowed and clShowStackZones and clShowUpperStackZone and clUpperStackDataReady and not clPrevDayHighTakenToday and clLatestClosed4HHigh < clPreviousDayHigh
lowerStackActive = clShowZonesAllowed and clShowStackZones and clShowLowerStackZone and clLowerStackDataReady and not clPrevDayLowTakenToday and clLatestClosed4HLow > clPreviousDayLow

weeklyUpperStackDataReady = not na(clPreviousWeekHigh) and not na(clPreviousWeekHighTime) and not na(clLatestClosedDailyHigh) and not na(clLatestClosedDailyHighTime)
weeklyLowerStackDataReady = not na(clPreviousWeekLow) and not na(clPreviousWeekLowTime) and not na(clLatestClosedDailyLow) and not na(clLatestClosedDailyLowTime)

weeklyUpperStackTop = math.max(clPreviousWeekHigh, clLatestClosedDailyHigh)
weeklyUpperStackBottom = math.min(clPreviousWeekHigh, clLatestClosedDailyHigh)
weeklyLowerStackTop = math.max(clPreviousWeekLow, clLatestClosedDailyLow)
weeklyLowerStackBottom = math.min(clPreviousWeekLow, clLatestClosedDailyLow)

weeklyUpperLeftTime = weeklyUpperStackDataReady ? math.min(clPreviousWeekHighTime, clLatestClosedDailyHighTime) : na
weeklyUpperRightTime = weeklyUpperStackDataReady ? math.max(clPreviousWeekHighTime, clLatestClosedDailyHighTime) : na
weeklyLowerLeftTime = weeklyLowerStackDataReady ? math.min(clPreviousWeekLowTime, clLatestClosedDailyLowTime) : na
weeklyLowerRightTime = weeklyLowerStackDataReady ? math.max(clPreviousWeekLowTime, clLatestClosedDailyLowTime) : na

weeklyUpperStackActive = clShowZonesAllowed and clShowWeeklyDailyStackZones and clShowUpperWeeklyDailyStackZone and weeklyUpperStackDataReady and not clPrevWeekHighTakenThisWeek and clLatestClosedDailyHigh < clPreviousWeekHigh
weeklyLowerStackActive = clShowZonesAllowed and clShowWeeklyDailyStackZones and clShowLowerWeeklyDailyStackZone and weeklyLowerStackDataReady and not clPrevWeekLowTakenThisWeek and clLatestClosedDailyLow > clPreviousWeekLow

monthlyUpperStackDataReady = not na(clPreviousMonthHigh) and not na(clPreviousMonthHighTime) and not na(clLatestClosedDailyHigh) and not na(clLatestClosedDailyHighTime)
monthlyLowerStackDataReady = not na(clPreviousMonthLow) and not na(clPreviousMonthLowTime) and not na(clLatestClosedDailyLow) and not na(clLatestClosedDailyLowTime)

monthlyUpperStackTop = math.max(clPreviousMonthHigh, clLatestClosedDailyHigh)
monthlyUpperStackBottom = math.min(clPreviousMonthHigh, clLatestClosedDailyHigh)
monthlyLowerStackTop = math.max(clPreviousMonthLow, clLatestClosedDailyLow)
monthlyLowerStackBottom = math.min(clPreviousMonthLow, clLatestClosedDailyLow)

monthlyUpperLeftTime = monthlyUpperStackDataReady ? math.min(clPreviousMonthHighTime, clLatestClosedDailyHighTime) : na
monthlyUpperRightTime = monthlyUpperStackDataReady ? math.max(clPreviousMonthHighTime, clLatestClosedDailyHighTime) : na
monthlyLowerLeftTime = monthlyLowerStackDataReady ? math.min(clPreviousMonthLowTime, clLatestClosedDailyLowTime) : na
monthlyLowerRightTime = monthlyLowerStackDataReady ? math.max(clPreviousMonthLowTime, clLatestClosedDailyLowTime) : na

monthlyUpperStackActive = clShowZonesAllowed and clShowMonthlyDailyStackZones and clShowUpperMonthlyDailyStackZone and monthlyUpperStackDataReady and not clPrevMonthHighTakenThisMonth and clLatestClosedDailyHigh < clPreviousMonthHigh
monthlyLowerStackActive = clShowZonesAllowed and clShowMonthlyDailyStackZones and clShowLowerMonthlyDailyStackZone and monthlyLowerStackDataReady and not clPrevMonthLowTakenThisMonth and clLatestClosedDailyLow > clPreviousMonthLow

h1UpperGapActive = not na(clCurrentHourHigh) and not na(clPreviousHourHigh) and clCurrentHourHigh < clPreviousHourHigh
h1UpperGapTop = clPreviousHourHigh
h1UpperGapBottom = clCurrentHourHigh

h1LowerGapActive = not na(clCurrentHourLow) and not na(clPreviousHourLow) and clCurrentHourLow > clPreviousHourLow
h1LowerGapTop = clCurrentHourLow
h1LowerGapBottom = clPreviousHourLow

clUpperH1GapVisible = clShowZonesAllowed and clShowH1SweepGaps and clShowUpperH1SweepGap and h1UpperGapActive
clLowerH1GapVisible = clShowZonesAllowed and clShowH1SweepGaps and clShowLowerH1SweepGap and h1LowerGapActive
clH1GapLeftTime = nz(clCurrentHourStartTime, time)

var box clUpperStackBox = na
var box clLowerStackBox = na
var box clWeeklyUpperStackBox = na
var box clWeeklyLowerStackBox = na
var box clMonthlyUpperStackBox = na
var box clMonthlyLowerStackBox = na
var box clUpperH1GapBox = na
var box clLowerH1GapBox = na

var label clUpperStackLabel = na
var label clLowerStackLabel = na
var label clWeeklyUpperStackLabel = na
var label clWeeklyLowerStackLabel = na
var label clMonthlyUpperStackLabel = na
var label clMonthlyLowerStackLabel = na
var label clUpperH1GapLabel = na
var label clLowerH1GapLabel = na

var label clPrevDayHighAnchorLabel = na
var label clPrevDayLowAnchorLabel = na
var label clClosed4HHighAnchorLabel = na
var label clClosed4HLowAnchorLabel = na

var table clHtfDistanceTable = table.new(position.top_center, 3, 6, bgcolor=color.new(color.black, 100), frame_color=color.new(color.black, 100), frame_width=0, border_color=color.new(color.black, 100), border_width=0)

clStackUpperBg = color.new(clUpperStackFillColor, clStackFillTransparency)
clStackLowerBg = color.new(clLowerStackFillColor, clStackFillTransparency)
clStackBorder = color.new(clStackBorderColor, clStackBorderTransparency)
clWeeklyStackUpperBg = color.new(clUpperWeeklyDailyStackFillColor, clWeeklyDailyStackFillTransparency)
clWeeklyStackLowerBg = color.new(clLowerWeeklyDailyStackFillColor, clWeeklyDailyStackFillTransparency)
clWeeklyStackBorder = color.new(clWeeklyDailyStackBorderColor, clWeeklyDailyStackBorderTransparency)
clMonthlyStackUpperBg = color.new(clUpperMonthlyDailyStackFillColor, clMonthlyDailyStackFillTransparency)
clMonthlyStackLowerBg = color.new(clLowerMonthlyDailyStackFillColor, clMonthlyDailyStackFillTransparency)
clMonthlyStackBorder = color.new(clMonthlyDailyStackBorderColor, clMonthlyDailyStackBorderTransparency)
clH1UpperBg = color.new(clUpperH1GapFillColor, clH1GapFillTransparency)
clH1LowerBg = color.new(clLowerH1GapFillColor, clH1GapFillTransparency)
clH1Border = color.new(clH1GapBorderColor, clH1GapBorderTransparency)

if upperStackActive
    clUpperStackBox := f_update_zone_box(clUpperStackBox, upperStackLeftTime, upperStackRightTime, upperStackTop, upperStackBottom, clStackUpperBg, clStackBorder, clStackBorderWidth, clExtendStackZonesRight)
    if clShowStackLabels
        clUpperStackLabel := f_update_zone_label(clUpperStackLabel, clZoneRightTime, (upperStackTop + upperStackBottom) / 2.0, "Upper Stack Zone", clStackLabelTextColor, f_zone_label_size(clStackLabelSizeInput))
    else
        if not na(clUpperStackLabel)
            label.delete(clUpperStackLabel)
            clUpperStackLabel := na
    if clShowStackAnchorMarkers
        clPrevDayHighAnchorLabel := f_update_anchor_label(clPrevDayHighAnchorLabel, clPreviousDayHighTime, clPreviousDayHigh, "Prior Day High point", clStackLabelTextColor, label.style_label_down)
        clClosed4HHighAnchorLabel := f_update_anchor_label(clClosed4HHighAnchorLabel, clLatestClosed4HHighTime, clLatestClosed4HHigh, "Latest Closed 4H High point", clStackLabelTextColor, label.style_label_down)
    else
        if not na(clPrevDayHighAnchorLabel)
            label.delete(clPrevDayHighAnchorLabel)
            clPrevDayHighAnchorLabel := na
        if not na(clClosed4HHighAnchorLabel)
            label.delete(clClosed4HHighAnchorLabel)
            clClosed4HHighAnchorLabel := na
else
    if not na(clUpperStackBox)
        box.delete(clUpperStackBox)
        clUpperStackBox := na
    if not na(clUpperStackLabel)
        label.delete(clUpperStackLabel)
        clUpperStackLabel := na
    if not na(clPrevDayHighAnchorLabel)
        label.delete(clPrevDayHighAnchorLabel)
        clPrevDayHighAnchorLabel := na
    if not na(clClosed4HHighAnchorLabel)
        label.delete(clClosed4HHighAnchorLabel)
        clClosed4HHighAnchorLabel := na

if lowerStackActive
    clLowerStackBox := f_update_zone_box(clLowerStackBox, lowerStackLeftTime, lowerStackRightTime, lowerStackTop, lowerStackBottom, clStackLowerBg, clStackBorder, clStackBorderWidth, clExtendStackZonesRight)
    if clShowStackLabels
        clLowerStackLabel := f_update_zone_label(clLowerStackLabel, clZoneRightTime, (lowerStackTop + lowerStackBottom) / 2.0, "Lower Stack Zone", clStackLabelTextColor, f_zone_label_size(clStackLabelSizeInput))
    else
