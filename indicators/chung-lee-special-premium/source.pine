var label clClosed4HLowAnchorLabel = na

clUpperBreakoutBg = color.new(clUpperBreakoutFillColor, clBreakoutFillTransparency)
clLowerBreakoutBg = color.new(clLowerBreakoutFillColor, clBreakoutFillTransparency)
clBreakoutBorder = color.new(clBreakoutBorderColor, clBreakoutBorderTransparency)
clRetainedUpperBreakoutBg = color.new(clUpperBreakoutFillColor, math.min(clBreakoutFillTransparency + 6, 100))
clRetainedLowerBreakoutBg = color.new(clLowerBreakoutFillColor, math.min(clBreakoutFillTransparency + 6, 100))
clRetainedBreakoutBorder = color.new(clBreakoutBorderColor, math.min(clBreakoutBorderTransparency + 8, 100))
clStackUpperBg = clUpperBreakoutBg
clStackLowerBg = clLowerBreakoutBg
clStackBorder = clBreakoutBorder
clWeeklyStackUpperBg = clUpperBreakoutBg
clWeeklyStackLowerBg = clLowerBreakoutBg
clWeeklyStackBorder = clBreakoutBorder
clMonthlyStackUpperBg = clUpperBreakoutBg
clMonthlyStackLowerBg = clLowerBreakoutBg
clMonthlyStackBorder = clBreakoutBorder
clH1UpperBg = clUpperBreakoutBg
clH1LowerBg = clLowerBreakoutBg
clH1Border = clBreakoutBorder
clStackBorderWidth = clBreakoutBorderWidth
clWeeklyDailyStackBorderWidth = clBreakoutBorderWidth
clMonthlyDailyStackBorderWidth = clBreakoutBorderWidth
clH1GapBorderWidth = clBreakoutBorderWidth
clShowStackLabels = clShowBreakoutLabels
clShowWeeklyDailyStackLabels = clShowBreakoutLabels
clShowMonthlyDailyStackLabels = clShowBreakoutLabels
clShowH1GapLabels = clShowBreakoutLabels
clStackLabelTextColor = clBreakoutLabelTextColor
clWeeklyDailyStackLabelTextColor = clBreakoutLabelTextColor
clMonthlyDailyStackLabelTextColor = clBreakoutLabelTextColor
clH1GapLabelTextColor = clBreakoutLabelTextColor
clStackLabelSizeInput = clBreakoutLabelSizeInput
clWeeklyDailyStackLabelSizeInput = clBreakoutLabelSizeInput
clMonthlyDailyStackLabelSizeInput = clBreakoutLabelSizeInput
clH1GapLabelSizeInput = clBreakoutLabelSizeInput
clShowStackAnchorMarkers = clShowBreakoutAnchorMarkers
clExtendStackZonesRight = clExtendBreakoutZonesRight
clExtendWeeklyDailyStackZonesRight = clExtendBreakoutZonesRight
clExtendMonthlyDailyStackZonesRight = clExtendBreakoutZonesRight
clExtendH1GapsRight = clExtendBreakoutZonesRight

clKeepClearedHourlyActive = clKeepClearedBreakoutZones and clKeepClearedHourlyZones and clBreakoutRenderAllowed and clShowHourlyBreakoutZone
clKeepClearedFourHourActive = clKeepClearedBreakoutZones and clKeepClearedFourHourZones and clBreakoutRenderAllowed and clShowFourHourBreakoutZone
clKeepClearedDailyActive = clKeepClearedBreakoutZones and clKeepClearedDailyZones and clBreakoutRenderAllowed and clShowDailyBreakoutZone
clKeepClearedWeeklyActive = clKeepClearedBreakoutZones and clKeepClearedWeeklyZones and clBreakoutRenderAllowed and clShowWeeklyBreakoutZone
clKeepClearedMonthlyActive = clKeepClearedBreakoutZones and clKeepClearedMonthlyZones and clBreakoutRenderAllowed and clShowMonthlyBreakoutZone

var string clLastBreakoutZoneDisplayMode = clBreakoutZoneDisplayMode
if clBreakoutZoneDisplayMode != clLastBreakoutZoneDisplayMode
    if not na(clUpperStackBox)
        box.delete(clUpperStackBox)
        clUpperStackBox := na
    if not na(clLowerStackBox)
        box.delete(clLowerStackBox)
        clLowerStackBox := na
    if not na(clWeeklyUpperStackBox)
        box.delete(clWeeklyUpperStackBox)
        clWeeklyUpperStackBox := na
    if not na(clWeeklyLowerStackBox)
        box.delete(clWeeklyLowerStackBox)
