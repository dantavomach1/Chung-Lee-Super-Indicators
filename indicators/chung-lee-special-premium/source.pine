    if clShowMonthlyDailyStackLabels
        clMonthlyUpperStackLabel := f_update_zone_label(clMonthlyUpperStackLabel, clZoneRightTime, (monthlyUpperStackTop + monthlyUpperStackBottom) / 2.0, "Upper Monthly Breakout", clMonthlyDailyStackLabelTextColor, f_zone_label_size(clMonthlyDailyStackLabelSizeInput))
    else
