        clWeeklyUpperStackBox := na
    if not na(clWeeklyUpperStackLabel)
        label.delete(clWeeklyUpperStackLabel)
        clWeeklyUpperStackLabel := na

if weeklyLowerStackActive
    clWeeklyLowerStackBox := f_update_zone_box(clWeeklyLowerStackBox, weeklyLowerLeftTime, weeklyLowerRightTime, weeklyLowerStackTop, weeklyLowerStackBottom, clWeeklyStackLowerBg, clWeeklyStackBorder, clWeeklyDailyStackBorderWidth, clExtendWeeklyDailyStackZonesRight)
    if clShowWeeklyDailyStackLabels
