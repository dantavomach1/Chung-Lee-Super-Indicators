        clLowerH1GapBox := na
    if not na(clLowerH1GapLabel)
        label.delete(clLowerH1GapLabel)
        clLowerH1GapLabel := na

clZoneAtr = ta.atr(clZoneAtrLength)
clNearDistance = clNearMode == "Fixed Points" ? clNearDistancePoints : clNearMode == "Ticks" ? clNearDistanceTicks * syminfo.mintick : clNearDistanceAtrMultiplier * clZoneAtr

clStackAlertsOn = clEnableZoneAlerts and clEnableStackZoneAlerts
clWeeklyStackAlertsOn = clEnableZoneAlerts and clEnableWeeklyDailyStackZoneAlerts
clMonthlyStackAlertsOn = clEnableZoneAlerts and clEnableMonthlyDailyStackZoneAlerts
clH1AlertsOn = clEnableZoneAlerts and clEnableH1SweepGapAlerts

clStackUpperNearState = upperStackActive and f_zone_near(close, upperStackTop, upperStackBottom, clNearDistance)
clStackLowerNearState = lowerStackActive and f_zone_near(close, lowerStackTop, lowerStackBottom, clNearDistance)
clStackUpperEnteredState = upperStackActive and f_zone_entered(upperStackTop, upperStackBottom, clZoneAlertTriggerBasis)
clStackLowerEnteredState = lowerStackActive and f_zone_entered(lowerStackTop, lowerStackBottom, clZoneAlertTriggerBasis)
clStackUpperClearedState = upperStackActive and f_zone_clear_above(upperStackTop, clZoneAlertTriggerBasis)
clStackLowerClearedState = lowerStackActive and f_zone_clear_below(lowerStackBottom, clZoneAlertTriggerBasis)

clWeeklyStackUpperNearState = weeklyUpperStackActive and f_zone_near(close, weeklyUpperStackTop, weeklyUpperStackBottom, clNearDistance)
clWeeklyStackLowerNearState = weeklyLowerStackActive and f_zone_near(close, weeklyLowerStackTop, weeklyLowerStackBottom, clNearDistance)
clWeeklyStackUpperEnteredState = weeklyUpperStackActive and f_zone_entered(weeklyUpperStackTop, weeklyUpperStackBottom, clZoneAlertTriggerBasis)
clWeeklyStackLowerEnteredState = weeklyLowerStackActive and f_zone_entered(weeklyLowerStackTop, weeklyLowerStackBottom, clZoneAlertTriggerBasis)
clWeeklyStackUpperClearedState = weeklyUpperStackActive and f_zone_clear_above(weeklyUpperStackTop, clZoneAlertTriggerBasis)
clWeeklyStackLowerClearedState = weeklyLowerStackActive and f_zone_clear_below(weeklyLowerStackBottom, clZoneAlertTriggerBasis)

clMonthlyStackUpperNearState = monthlyUpperStackActive and f_zone_near(close, monthlyUpperStackTop, monthlyUpperStackBottom, clNearDistance)
clMonthlyStackLowerNearState = monthlyLowerStackActive and f_zone_near(close, monthlyLowerStackTop, monthlyLowerStackBottom, clNearDistance)
clMonthlyStackUpperEnteredState = monthlyUpperStackActive and f_zone_entered(monthlyUpperStackTop, monthlyUpperStackBottom, clZoneAlertTriggerBasis)
clMonthlyStackLowerEnteredState = monthlyLowerStackActive and f_zone_entered(monthlyLowerStackTop, monthlyLowerStackBottom, clZoneAlertTriggerBasis)
clMonthlyStackUpperClearedState = monthlyUpperStackActive and f_zone_clear_above(monthlyUpperStackTop, clZoneAlertTriggerBasis)
clMonthlyStackLowerClearedState = monthlyLowerStackActive and f_zone_clear_below(monthlyLowerStackBottom, clZoneAlertTriggerBasis)

clH1UpperNearState = clUpperH1GapVisible and f_zone_near(close, h1UpperGapTop, h1UpperGapBottom, clNearDistance)
clH1LowerNearState = clLowerH1GapVisible and f_zone_near(close, h1LowerGapTop, h1LowerGapBottom, clNearDistance)
clH1UpperEnteredState = clUpperH1GapVisible and f_zone_entered(h1UpperGapTop, h1UpperGapBottom, clZoneAlertTriggerBasis)
clH1LowerEnteredState = clLowerH1GapVisible and f_zone_entered(h1LowerGapTop, h1LowerGapBottom, clZoneAlertTriggerBasis)
clH1ValuesReady = clShowZonesAllowed and clShowH1SweepGaps and not na(clCurrentHourHigh) and not na(clCurrentHourLow) and not na(clPreviousHourHigh) and not na(clPreviousHourLow)
clH1UpperSweptState = clH1ValuesReady and clShowUpperH1SweepGap and clCurrentHourHigh >= clPreviousHourHigh
clH1LowerSweptState = clH1ValuesReady and clShowLowerH1SweepGap and clCurrentHourLow <= clPreviousHourLow

clStackUpperNear = clStackAlertsOn and clAlertStackNear and clStackUpperNearState and not clStackUpperNearState[1]
clStackUpperEntered = clStackAlertsOn and clAlertStackEntered and clStackUpperEnteredState and not clStackUpperEnteredState[1]
clStackUpperCleared = clStackAlertsOn and clAlertStackCleared and clStackUpperClearedState and not clStackUpperClearedState[1]
clStackLowerNear = clStackAlertsOn and clAlertStackNear and clStackLowerNearState and not clStackLowerNearState[1]
clStackLowerEntered = clStackAlertsOn and clAlertStackEntered and clStackLowerEnteredState and not clStackLowerEnteredState[1]
clStackLowerCleared = clStackAlertsOn and clAlertStackCleared and clStackLowerClearedState and not clStackLowerClearedState[1]

clWeeklyStackUpperNear = clWeeklyStackAlertsOn and clAlertWeeklyDailyStackNear and clWeeklyStackUpperNearState and not clWeeklyStackUpperNearState[1]
clWeeklyStackUpperEntered = clWeeklyStackAlertsOn and clAlertWeeklyDailyStackEntered and clWeeklyStackUpperEnteredState and not clWeeklyStackUpperEnteredState[1]
clWeeklyStackUpperCleared = clWeeklyStackAlertsOn and clAlertWeeklyDailyStackCleared and clWeeklyStackUpperClearedState and not clWeeklyStackUpperClearedState[1]
clWeeklyStackLowerNear = clWeeklyStackAlertsOn and clAlertWeeklyDailyStackNear and clWeeklyStackLowerNearState and not clWeeklyStackLowerNearState[1]
clWeeklyStackLowerEntered = clWeeklyStackAlertsOn and clAlertWeeklyDailyStackEntered and clWeeklyStackLowerEnteredState and not clWeeklyStackLowerEnteredState[1]
clWeeklyStackLowerCleared = clWeeklyStackAlertsOn and clAlertWeeklyDailyStackCleared and clWeeklyStackLowerClearedState and not clWeeklyStackLowerClearedState[1]

clMonthlyStackUpperNear = clMonthlyStackAlertsOn and clAlertMonthlyDailyStackNear and clMonthlyStackUpperNearState and not clMonthlyStackUpperNearState[1]
clMonthlyStackUpperEntered = clMonthlyStackAlertsOn and clAlertMonthlyDailyStackEntered and clMonthlyStackUpperEnteredState and not clMonthlyStackUpperEnteredState[1]
clMonthlyStackUpperCleared = clMonthlyStackAlertsOn and clAlertMonthlyDailyStackCleared and clMonthlyStackUpperClearedState and not clMonthlyStackUpperClearedState[1]
clMonthlyStackLowerNear = clMonthlyStackAlertsOn and clAlertMonthlyDailyStackNear and clMonthlyStackLowerNearState and not clMonthlyStackLowerNearState[1]
clMonthlyStackLowerEntered = clMonthlyStackAlertsOn and clAlertMonthlyDailyStackEntered and clMonthlyStackLowerEnteredState and not clMonthlyStackLowerEnteredState[1]
clMonthlyStackLowerCleared = clMonthlyStackAlertsOn and clAlertMonthlyDailyStackCleared and clMonthlyStackLowerClearedState and not clMonthlyStackLowerClearedState[1]

clH1UpperNear = clH1AlertsOn and clAlertH1GapNear and clH1UpperNearState and not clH1UpperNearState[1]
clH1UpperEntered = clH1AlertsOn and clAlertH1GapEntered and clH1UpperEnteredState and not clH1UpperEnteredState[1]
clH1UpperSwept = clH1AlertsOn and clAlertH1Swept and clH1UpperSweptState and not clH1UpperSweptState[1]
clH1LowerNear = clH1AlertsOn and clAlertH1GapNear and clH1LowerNearState and not clH1LowerNearState[1]
clH1LowerEntered = clH1AlertsOn and clAlertH1GapEntered and clH1LowerEnteredState and not clH1LowerEnteredState[1]
clH1LowerSwept = clH1AlertsOn and clAlertH1Swept and clH1LowerSweptState and not clH1LowerSweptState[1]

clHtfStackNear = clWeeklyStackUpperNear or clWeeklyStackLowerNear or clMonthlyStackUpperNear or clMonthlyStackLowerNear
clHtfStackEntered = clWeeklyStackUpperEntered or clWeeklyStackLowerEntered or clMonthlyStackUpperEntered or clMonthlyStackLowerEntered
clHtfStackCleared = clWeeklyStackUpperCleared or clWeeklyStackLowerCleared or clMonthlyStackUpperCleared or clMonthlyStackLowerCleared

alertcondition(clStackUpperNear, title="Stack Zone - Near Upper", message="Price is near the Daily / 4H Upper Stack Zone")
alertcondition(clStackUpperEntered, title="Stack Zone - Entered Upper", message="Daily / 4H Upper Stack Zone entered")
alertcondition(clStackUpperCleared, title="Stack Zone - Cleared Upper", message="Daily / 4H Upper Stack Zone cleared")
alertcondition(clStackLowerNear, title="Stack Zone - Near Lower", message="Price is near the Daily / 4H Lower Stack Zone")
alertcondition(clStackLowerEntered, title="Stack Zone - Entered Lower", message="Daily / 4H Lower Stack Zone entered")
alertcondition(clStackLowerCleared, title="Stack Zone - Cleared Lower", message="Daily / 4H Lower Stack Zone cleared")

alertcondition(clHtfStackNear, title="HTF Stack Zone - Near", message="Price is near a Weekly / Daily or Monthly / Daily Stack Zone")
alertcondition(clHtfStackEntered, title="HTF Stack Zone - Entered", message="Price entered a Weekly / Daily or Monthly / Daily Stack Zone")
alertcondition(clHtfStackCleared, title="HTF Stack Zone - Cleared", message="Price cleared a Weekly / Daily or Monthly / Daily Stack Zone")

alertcondition(clH1UpperNear, title="H1 Gap - Near Upper", message="Near Upper H1 Sweep Gap")
alertcondition(clH1UpperEntered, title="H1 Gap - Entered Upper", message="Upper H1 Sweep Gap entered")
alertcondition(clH1UpperSwept, title="H1 Gap - Swept Upper", message="Previous H1 High swept")
alertcondition(clH1LowerNear, title="H1 Gap - Near Lower", message="Near Lower H1 Sweep Gap")
alertcondition(clH1LowerEntered, title="H1 Gap - Entered Lower", message="Lower H1 Sweep Gap entered")
alertcondition(clH1LowerSwept, title="H1 Gap - Swept Lower", message="Previous H1 Low swept")

if clEnableDynamicZoneAlerts
    if clStackUpperNear
        alert("Near Daily / 4H Upper Stack Zone", alert.freq_once_per_bar)
    if clStackUpperEntered
        alert("Daily / 4H Upper Stack Zone entered", alert.freq_once_per_bar)
    if clStackUpperCleared
        alert("Daily / 4H Upper Stack Zone cleared", alert.freq_once_per_bar)
    if clStackLowerNear
        alert("Near Daily / 4H Lower Stack Zone", alert.freq_once_per_bar)
    if clStackLowerEntered
        alert("Daily / 4H Lower Stack Zone entered", alert.freq_once_per_bar)
    if clStackLowerCleared
        alert("Daily / 4H Lower Stack Zone cleared", alert.freq_once_per_bar)
    if clWeeklyStackUpperNear
        alert("Near Weekly / Daily Upper Stack Zone", alert.freq_once_per_bar)
    if clWeeklyStackUpperEntered
        alert("Weekly / Daily Upper Stack Zone entered", alert.freq_once_per_bar)
    if clWeeklyStackUpperCleared
        alert("Weekly / Daily Upper Stack Zone cleared", alert.freq_once_per_bar)
    if clWeeklyStackLowerNear
        alert("Near Weekly / Daily Lower Stack Zone", alert.freq_once_per_bar)
    if clWeeklyStackLowerEntered
        alert("Weekly / Daily Lower Stack Zone entered", alert.freq_once_per_bar)
    if clWeeklyStackLowerCleared
        alert("Weekly / Daily Lower Stack Zone cleared", alert.freq_once_per_bar)
    if clMonthlyStackUpperNear
        alert("Near Monthly / Daily Upper Stack Zone", alert.freq_once_per_bar)
    if clMonthlyStackUpperEntered
        alert("Monthly / Daily Upper Stack Zone entered", alert.freq_once_per_bar)
    if clMonthlyStackUpperCleared
        alert("Monthly / Daily Upper Stack Zone cleared", alert.freq_once_per_bar)
    if clMonthlyStackLowerNear
        alert("Near Monthly / Daily Lower Stack Zone", alert.freq_once_per_bar)
    if clMonthlyStackLowerEntered
        alert("Monthly / Daily Lower Stack Zone entered", alert.freq_once_per_bar)
    if clMonthlyStackLowerCleared
        alert("Monthly / Daily Lower Stack Zone cleared", alert.freq_once_per_bar)
    if clH1UpperNear
        alert("Near Upper H1 Sweep Gap", alert.freq_once_per_bar)
    if clH1UpperEntered
        alert("Upper H1 Sweep Gap entered", alert.freq_once_per_bar)
    if clH1UpperSwept
        alert("Previous H1 High swept", alert.freq_once_per_bar)
    if clH1LowerNear
        alert("Near Lower H1 Sweep Gap", alert.freq_once_per_bar)
    if clH1LowerEntered
        alert("Lower H1 Sweep Gap entered", alert.freq_once_per_bar)
    if clH1LowerSwept
        alert("Previous H1 Low swept", alert.freq_once_per_bar)

clHtfUseCurrentLevels = clHtfDistanceTableLevelSource == "Current Developing Period"
clHtfH1High = clHtfUseCurrentLevels ? clCurrentHourHigh : clPreviousHourHigh
clHtfH1Low = clHtfUseCurrentLevels ? clCurrentHourLow : clPreviousHourLow
clHtf4HHigh = clHtfUseCurrentLevels ? clCur4HHigh : clLatestClosed4HHigh
clHtf4HLow = clHtfUseCurrentLevels ? clCur4HLow : clLatestClosed4HLow
clHtfDayHigh = clHtfUseCurrentLevels ? clCurDayHigh : clPreviousDayHigh
clHtfDayLow = clHtfUseCurrentLevels ? clCurDayLow : clPreviousDayLow
clHtfWeekHigh = clHtfUseCurrentLevels ? clCurWeekHigh : clPreviousWeekHigh
clHtfWeekLow = clHtfUseCurrentLevels ? clCurWeekLow : clPreviousWeekLow
clHtfMonthHigh = clHtfUseCurrentLevels ? clCurMonthHigh : clPreviousMonthHigh
clHtfMonthLow = clHtfUseCurrentLevels ? clCurMonthLow : clPreviousMonthLow

if barstate.islast
    clHtfTableTextSize = f_panel_text_size(clHtfDistanceTableTextSizeInput)
    clHtfHiddenColor = color.new(color.black, 100)
    clHtfTableBg = color.new(clHtfDistanceTableBackgroundColor, clHtfDistanceTableTransparency)
    table.set_position(clHtfDistanceTable, f_htf_distance_table_position(clHtfDistanceTablePositionInput))

    if clShowHtfDistanceTable
        table.set_bgcolor(clHtfDistanceTable, clHtfTableBg)
        table.set_frame_color(clHtfDistanceTable, clHtfDistanceTableBorderColor)
        table.set_frame_width(clHtfDistanceTable, clHtfDistanceTableBorderWidth)
        table.set_border_color(clHtfDistanceTable, clHtfDistanceTableBorderColor)
        table.set_border_width(clHtfDistanceTable, clHtfDistanceTableBorderWidth)
    else
        table.set_bgcolor(clHtfDistanceTable, clHtfHiddenColor)
        table.set_frame_color(clHtfDistanceTable, clHtfHiddenColor)
        table.set_frame_width(clHtfDistanceTable, 0)
        table.set_border_color(clHtfDistanceTable, clHtfHiddenColor)
        table.set_border_width(clHtfDistanceTable, 0)

    for clHtfClearRow = 0 to 5
        table.cell(clHtfDistanceTable, 0, clHtfClearRow, "", text_color=clHtfHiddenColor, text_size=clHtfTableTextSize, bgcolor=clHtfHiddenColor)
        table.cell(clHtfDistanceTable, 1, clHtfClearRow, "", text_color=clHtfHiddenColor, text_size=clHtfTableTextSize, bgcolor=clHtfHiddenColor)
        table.cell(clHtfDistanceTable, 2, clHtfClearRow, "", text_color=clHtfHiddenColor, text_size=clHtfTableTextSize, bgcolor=clHtfHiddenColor)

    if clShowHtfDistanceTable
        table.cell(clHtfDistanceTable, 0, 0, "TF", text_color=clHtfDistanceTableHeaderTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 1, 0, "High", text_color=clHtfDistanceTableHeaderTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 2, 0, "Low", text_color=clHtfDistanceTableHeaderTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)

        table.cell(clHtfDistanceTable, 0, 1, "H1", text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 1, 1, f_htf_distance_text(clHtfH1High, true, clHtfDistanceShowSigned), text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 2, 1, f_htf_distance_text(clHtfH1Low, false, clHtfDistanceShowSigned), text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)

        table.cell(clHtfDistanceTable, 0, 2, "4H", text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 1, 2, f_htf_distance_text(clHtf4HHigh, true, clHtfDistanceShowSigned), text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 2, 2, f_htf_distance_text(clHtf4HLow, false, clHtfDistanceShowSigned), text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)

        table.cell(clHtfDistanceTable, 0, 3, "D", text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 1, 3, f_htf_distance_text(clHtfDayHigh, true, clHtfDistanceShowSigned), text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 2, 3, f_htf_distance_text(clHtfDayLow, false, clHtfDistanceShowSigned), text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)

        table.cell(clHtfDistanceTable, 0, 4, "W", text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 1, 4, f_htf_distance_text(clHtfWeekHigh, true, clHtfDistanceShowSigned), text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 2, 4, f_htf_distance_text(clHtfWeekLow, false, clHtfDistanceShowSigned), text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)

        table.cell(clHtfDistanceTable, 0, 5, "M", text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 1, 5, f_htf_distance_text(clHtfMonthHigh, true, clHtfDistanceShowSigned), text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)
        table.cell(clHtfDistanceTable, 2, 5, f_htf_distance_text(clHtfMonthLow, false, clHtfDistanceShowSigned), text_color=clHtfDistanceTableTextColor, text_size=clHtfTableTextSize, bgcolor=clHtfTableBg)

//=================================================================================================================================================================================
// SECTION 7 – MOVING AVERAGE SUITE
//=================================================================================================================================================================================
isLowTF = timeframe.isintraday and timeframe.multiplier <= 30

enableMA = input.bool(false, "Enable Moving Averages", group=groupMA, tooltip="Moving average stack.\n\nApplies one MA type and one source across up to ten lines.\nEach line has its own length and price offset.\nThe old Line Style control was removed because Pine plot lines cannot render true dashed or dotted styles.")
maType    = input.string("SMA", "MA Type", options=["SMA","EMA","SMMA (RMA)","WMA","VWMA"], group=groupMA)
maSource  = input.source(close, "Source", group=groupMA)
maColor   = input.color(#a58700, "Line Color", group=groupMA)
lineWidth = input.int(1, "Line Width", minval=1, maxval=5, group=groupMA)

fillEnable  = input.bool(false, "Fill Between MA 1 and MA 2", group=groupFA, tooltip="Visual fill and alert controls for the first two moving averages.")
fillColor   = input.color(color.new(#a58700, 80), "Fill Color", group=groupFA)
alertEnable = input.bool(false, "Enable MA 1 / MA 2 Alerts", group=groupFA)

showLine1  = input.bool(true, "Show MA 1", group=groupMA)
length1    = input.int(200, "MA 1 Length", group=groupMA)
offset1    = input.int(1, "MA 1 Price Offset", group=groupMA)

showLine2  = input.bool(true, "Show MA 2", group=groupMA)
length2    = input.int(200, "MA 2 Length", group=groupMA)
offset2    = input.int(2, "MA 2 Price Offset", group=groupMA)

showLine3  = input.bool(true, "Show MA 3", group=groupMA)
length3    = input.int(200, "MA 3 Length", group=groupMA)
offset3    = input.int(3, "MA 3 Price Offset", group=groupMA)

showLine4  = input.bool(true, "Show MA 4", group=groupMA)
length4    = input.int(200, "MA 4 Length", group=groupMA)
offset4    = input.int(4, "MA 4 Price Offset", group=groupMA)

showLine5  = input.bool(true, "Show MA 5", group=groupMA)
length5    = input.int(200, "MA 5 Length", group=groupMA)
offset5    = input.int(5, "MA 5 Price Offset", group=groupMA)

showLine6  = input.bool(true, "Show MA 6", group=groupMA)
length6    = input.int(200, "MA 6 Length", group=groupMA)
offset6    = input.int(6, "MA 6 Price Offset", group=groupMA)

showLine7  = input.bool(true, "Show MA 7", group=groupMA)
length7    = input.int(200, "MA 7 Length", group=groupMA)
offset7    = input.int(7, "MA 7 Price Offset", group=groupMA)

showLine8  = input.bool(true, "Show MA 8", group=groupMA)
length8    = input.int(200, "MA 8 Length", group=groupMA)
offset8    = input.int(8, "MA 8 Price Offset", group=groupMA)

showLine9  = input.bool(true, "Show MA 9", group=groupMA)
length9    = input.int(200, "MA 9 Length", group=groupMA)
offset9    = input.int(9, "MA 9 Price Offset", group=groupMA)

showLine10 = input.bool(true, "Show MA 10", group=groupMA)
length10   = input.int(200, "MA 10 Length", group=groupMA)
offset10   = input.int(10, "MA 10 Price Offset", group=groupMA)

f_ma(src, len) =>
    var float res = na
    if maType == "EMA"
        res := ta.ema(src, len)
    else if maType == "SMMA (RMA)"
        res := ta.rma(src, len)
    else if maType == "WMA"
        res := ta.wma(src, len)
    else if maType == "VWMA"
        res := ta.vwma(src, len)
    else
        res := ta.sma(src, len)
    res

ma1  = enableMA and isLowTF ? f_ma(maSource, length1) : na
ma2  = enableMA and isLowTF ? f_ma(maSource, length2) : na
ma3  = enableMA and isLowTF ? f_ma(maSource, length3) : na
ma4  = enableMA and isLowTF ? f_ma(maSource, length4) : na
ma5  = enableMA and isLowTF ? f_ma(maSource, length5) : na
ma6  = enableMA and isLowTF ? f_ma(maSource, length6) : na
ma7  = enableMA and isLowTF ? f_ma(maSource, length7) : na
ma8  = enableMA and isLowTF ? f_ma(maSource, length8) : na
ma9  = enableMA and isLowTF ? f_ma(maSource, length9) : na
ma10 = enableMA and isLowTF ? f_ma(maSource, length10) : na

p1  = plot(showLine1 ? ma1 + offset1 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 1")
p2  = plot(showLine2 ? ma2 + offset2 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 2")
p3  = plot(showLine3 ? ma3 + offset3 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 3")
p4  = plot(showLine4 ? ma4 + offset4 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 4")
p5  = plot(showLine5 ? ma5 + offset5 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 5")
p6  = plot(showLine6 ? ma6 + offset6 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 6")
p7  = plot(showLine7 ? ma7 + offset7 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 7")
p8  = plot(showLine8 ? ma8 + offset8 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 8")
p9  = plot(showLine9 ? ma9 + offset9 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 9")
p10 = plot(showLine10 ? ma10 + offset10 : na, color=maColor, linewidth=lineWidth, style=plot.style_line, title="MA 10")

fill(p1, p2, color=fillEnable ? fillColor : na)
alertcondition(alertEnable and ta.crossover(ma1, ma2), title="MA 1 Cross Above MA 2", message="MA 1 crossed above MA 2")
alertcondition(alertEnable and ta.crossunder(ma1, ma2), title="MA 1 Cross Below MA 2", message="MA 1 crossed below MA 2")

//=================================================================================================================================================================================
// SECTION 8 – BOLLINGER BANDS
//=================================================================================================================================================================================
showBollingerBand = input.bool(true, "Enable Bollinger Bands", group=groupBB, tooltip="Bollinger Band controls.\n\nUses a selectable basis type, source, and standard deviation multiplier.")
bbLength = input.int(1380, minval=1, title="MA Length", group=groupBB)
maType2  = input.string("SMA", title="MA Type", options=["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group=groupBB)
src2     = input.source(close, title="Source", group=groupBB)
mult     = input.float(2.0, minval=0.001, maxval=50, title="StdDev Multiplier", group=groupBB)
offsetBB = input.int(0, "Offset", minval=-500, maxval=500, group=groupBB)

bbBasisColor = input.color(color.new(#986300, 0), "Basis Color", group=groupBB)
bbUpperColor = input.color(color.new(color.black, 100), "Upper Band Color", group=groupBB)
bbLowerColor = input.color(color.new(color.black, 100), "Lower Band Color", group=groupBB)
bbFillColor  = input.color(color.rgb(183, 183, 183, 97), "Fill Color", group=groupBB)

ma_calc(_src, _len, _type) =>
    switch _type
        "SMA"        => ta.sma(_src, _len)
        "EMA"        => ta.ema(_src, _len)
        "SMMA (RMA)" => ta.rma(_src, _len)
        "WMA"        => ta.wma(_src, _len)
        "VWMA"       => ta.vwma(_src, _len)

basis = showBollingerBand ? ma_calc(src2, bbLength, maType2) : na
dev   = showBollingerBand ? mult * ta.stdev(src2, bbLength) : na
upper = showBollingerBand ? basis + dev : na
lower = showBollingerBand ? basis - dev : na

plot(basis, "BB Basis", color=bbBasisColor, offset=offsetBB)
pUpper = plot(upper, "BB Upper", color=bbUpperColor, linewidth=1, offset=offsetBB)
pLower = plot(lower, "BB Lower", color=bbLowerColor, linewidth=1, offset=offsetBB)
fill(pUpper, pLower, title="BB Fill", color=bbFillColor)

//=================================================================================================================================================================================
// SECTION 9 – SESSION HIGHLIGHTING
//=================================================================================================================================================================================
ShowSessions = input.bool(false, "Show Sessions", group=groupSessions, tooltip="World session highlighting.\n\nShow Sessions enables the feature.\nActivate High/Low Fill shades the tracked session range instead of using the chart background.")
bgColorToggle = input.bool(false, "Activate High/Low Fill", group=groupSessions)

LondonColor = input.color(color.new(color.green, 90), "London Color", group=groupSessions)
NYColor     = input.color(color.new(color.red, 90), "NY Color", group=groupSessions)
AsiaColor   = input.color(color.new(color.yellow, 90), "Tokyo/Asia Color", group=groupSessions)
SydneyColor = input.color(color.new(color.blue, 90), "Sydney Color", group=groupSessions)

resSession       = input.timeframe("D", "Session Resolution", options=["D", "W", "M"], group=groupSessions)
londonSessionStr = input.session("0300-1200:1234567", "London Session", group=groupSessions)
nySessionStr     = input.session("0800-1700:1234567", "New York Session", group=groupSessions)
tokyoSessionStr  = input.session("2000-0400:1234567", "Tokyo Session", group=groupSessions)
sydneySessionStr = input.session("1700-0200:1234567", "Sydney Session", group=groupSessions)

is_newbar(sess) =>
    t = time(resSession, sess, "America/New_York")
    (na(t[1]) and not na(t)) or (t[1] < t)

is_session(sess) =>
    not na(time(timeframe.period, sess, "America/New_York"))

LondonEnabled = input.bool(true, "London Session", group=groupSessions)
NYEnabled     = input.bool(true, "New York Session", group=groupSessions)
TokyoEnabled  = input.bool(true, "Tokyo Session", group=groupSessions)
SydneyEnabled = input.bool(true, "Sydney Session", group=groupSessions)

var float londonLow  = na
var float londonHigh = na
var float nyLow      = na
var float nyHigh     = na
var float tokyoLow   = na
var float tokyoHigh  = na
var float sydneyLow  = na
var float sydneyHigh = na

if is_session(londonSessionStr)
    if is_newbar(londonSessionStr)
        londonLow := low
        londonHigh := high
    else
        londonLow := math.min(londonLow[1], low)
        londonHigh := math.max(londonHigh[1], high)

if is_session(nySessionStr)
    if is_newbar(nySessionStr)
        nyLow := low
        nyHigh := high
    else
        nyLow := math.min(nyLow[1], low)
        nyHigh := math.max(nyHigh[1], high)

if is_session(tokyoSessionStr)
    if is_newbar(tokyoSessionStr)
        tokyoLow := low
        tokyoHigh := high
    else
        tokyoLow := math.min(tokyoLow[1], low)
        tokyoHigh := math.max(tokyoHigh[1], high)

if is_session(sydneySessionStr)
    if is_newbar(sydneySessionStr)
        sydneyLow := low
        sydneyHigh := high
    else
        sydneyLow := math.min(sydneyLow[1], low)
        sydneyHigh := math.max(sydneyHigh[1], high)

pLondonLow  = plot(londonLow, color=color.new(color.black, 100), title="London Low")
pLondonHigh = plot(londonHigh, color=color.new(color.black, 100), title="London High")
pNYLow      = plot(nyLow, color=color.new(color.black, 100), title="NY Low")
pNYHigh     = plot(nyHigh, color=color.new(color.black, 100), title="NY High")
pTokyoLow   = plot(tokyoLow, color=color.new(color.black, 100), title="Tokyo Low")
pTokyoHigh  = plot(tokyoHigh, color=color.new(color.black, 100), title="Tokyo High")
pSydneyLow  = plot(sydneyLow, color=color.new(color.black, 100), title="Sydney Low")
pSydneyHigh = plot(sydneyHigh, color=color.new(color.black, 100), title="Sydney High")

fill(pLondonLow, pLondonHigh, color=(is_session(londonSessionStr) and LondonEnabled and bgColorToggle and ShowSessions) ? LondonColor : na)
fill(pNYLow, pNYHigh, color=(is_session(nySessionStr) and NYEnabled and bgColorToggle and ShowSessions) ? NYColor : na)
fill(pTokyoLow, pTokyoHigh, color=(is_session(tokyoSessionStr) and TokyoEnabled and bgColorToggle and ShowSessions) ? AsiaColor : na)
fill(pSydneyLow, pSydneyHigh, color=(is_session(sydneySessionStr) and SydneyEnabled and bgColorToggle and ShowSessions) ? SydneyColor : na)

bgcolor((is_session(londonSessionStr) and LondonEnabled and not bgColorToggle and ShowSessions and isLowTimeframe240) ? LondonColor : na)
bgcolor((is_session(nySessionStr) and NYEnabled and not bgColorToggle and ShowSessions and isLowTimeframe240) ? NYColor : na)
bgcolor((is_session(tokyoSessionStr) and TokyoEnabled and not bgColorToggle and ShowSessions and isLowTimeframe240) ? AsiaColor : na)
bgcolor((is_session(sydneySessionStr) and SydneyEnabled and not bgColorToggle and ShowSessions and isLowTimeframe240) ? SydneyColor : na)

//=================================================================================================================
// SECTION 10 – FUTURES VALUE PANEL DATA
//=================================================================================================================
var futuresSymbols = array.from("MNQ","NQ","MES","ES","M2K","RTY","MYM","YM","BTC","MBT","ETH","MET","MGC","GC","SIL","SI","PA","PL","HG","MCL","CL","QM","NG","QG","RB","HO","ZN","ZB","ZF","ZT","UB","6E","M6E","6J","M6J","6B","M6B","6A","M6A","6C","6S")
var futuresTickVals = array.from(0.50,5.00,1.25,12.50,0.50,5.00,0.50,5.00,5.00,0.10,0.50,0.05,1.00,10.00,5.00,25.00,10.00,5.00,12.50,1.00,10.00,12.50,10.00,25.00,4.20,4.20,15.625,31.25,7.8125,15.625,31.25,6.25,1.25,6.25,1.25,6.25,1.25,10.00,1.00,10.00,12.50)
var futuresPointVals = array.from(2.00,20.00,5.00,50.00,5.00,50.00,0.50,5.00,5.00,0.10,0.50,0.05,10.00,100.00,1000.00,5000.00,100.00,50.00,25000.00,100.00,1000.00,12500.00,10000.00,25000.00,42000.00,42000.00,1000.00,1000.00,1000.00,1000.00,1000.00,125000.00,25000.00,125000.00,25000.00,62500.00,12500.00,100000.00,10000.00,100000.00,125000.00)
var compactCoreSymbols = array.from("MNQ","NQ","MES","ES","RTY","YM","BTC","MBT","MGC","GC","SI","HG","MCL","CL","NG")
var futuresTable = table.new(position.top_right, 3, 44, bgcolor=color.new(color.black, 100), frame_color=color.new(color.black, 100), frame_width=0, border_color=color.new(color.black, 100), border_width=0)

f_find_symbol_index(_symbol) =>
    int idx = -1
    for i = 0 to array.size(futuresSymbols) - 1
        if array.get(futuresSymbols, i) == _symbol
            idx := i
    idx

f_is_compact_symbol(_symbol) =>
    bool keep = false
    for i = 0 to array.size(compactCoreSymbols) - 1
        if array.get(compactCoreSymbols, i) == _symbol
            keep := true
    keep

f_symbol_in_custom_list(_symbol, _customList) =>
    bool found = false
    if _customList != ""
        tokenArray = str.split(_customList, ",")
        for i = 0 to array.size(tokenArray) - 1
            if f_normalize_token(array.get(tokenArray, i)) == _symbol
                found := true
    found

//=================================================================================================================
// SECTION 11 – FUTURES VALUE PANEL RENDERING
//=================================================================================================================
if barstate.islast
    panelTextSize = f_panel_text_size(futuresTextSizeInput)
    hiddenColor = color.new(color.black, 100)
    table.set_position(futuresTable, f_panel_position(futuresPanelLocation))

    if showFuturesValuePanel
        table.set_bgcolor(futuresTable, futuresPanelBgColor)
        table.set_frame_color(futuresTable, futuresBorderColor)
        table.set_frame_width(futuresTable, 1)
        table.set_border_color(futuresTable, futuresBorderColor)
        table.set_border_width(futuresTable, 1)
    else
        table.set_bgcolor(futuresTable, hiddenColor)
        table.set_frame_color(futuresTable, hiddenColor)
        table.set_frame_width(futuresTable, 0)
        table.set_border_color(futuresTable, hiddenColor)
        table.set_border_width(futuresTable, 0)

    for clearRow = 0 to 43
        table.cell(futuresTable, 0, clearRow, "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=hiddenColor)
        table.cell(futuresTable, 1, clearRow, "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=hiddenColor)
        table.cell(futuresTable, 2, clearRow, "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=hiddenColor)

    if showFuturesValuePanel
        currentRoot = f_symbol_root()
        currentTickValue = syminfo.mintick * syminfo.pointvalue
        currentPointValue = syminfo.pointvalue
        currentIsMapped = f_find_symbol_index(currentRoot) != -1
        showTickCol = futuresDisplayMode == "$ / Tick" or futuresDisplayMode == "Both"
        showPointCol = futuresDisplayMode == "$ / Point" or futuresDisplayMode == "Both"

        table.cell(futuresTable, 0, 0, "Symbol", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresHeaderBgColor)
        table.cell(futuresTable, 1, 0, showTickCol ? "$/Tick" : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresHeaderBgColor)
        table.cell(futuresTable, 2, 0, showPointCol ? "$/Point" : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresHeaderBgColor)

        row = 1
        currentRowBg = highlightCurrentSymbol ? color.new(#a58700, 75) : futuresPanelBgColor

        table.cell(futuresTable, 0, row, currentRoot + (currentIsMapped ? " (Current)" : " (Current*)"), text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=currentRowBg)
        table.cell(futuresTable, 1, row, showTickCol ? f_money(currentTickValue) : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=currentRowBg)
        table.cell(futuresTable, 2, row, showPointCol ? f_money(currentPointValue) : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=currentRowBg)
        row += 1

        for i = 0 to array.size(futuresSymbols) - 1
            if row <= 43
                sym = array.get(futuresSymbols, i)
                includeByCustom = futuresCustomList != "" ? f_symbol_in_custom_list(sym, futuresCustomList) : true
                includeByCompact = compactFuturesMode ? f_is_compact_symbol(sym) : true
                includeRow = includeByCustom and includeByCompact and sym != currentRoot
                if includeRow
                    tickVal = array.get(futuresTickVals, i)
                    pointVal = array.get(futuresPointVals, i)
                    table.cell(futuresTable, 0, row, sym, text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresPanelBgColor)
                    table.cell(futuresTable, 1, row, showTickCol ? f_money(tickVal) : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresPanelBgColor)
                    table.cell(futuresTable, 2, row, showPointCol ? f_money(pointVal) : "", text_color=futuresPanelTextColor, text_size=panelTextSize, bgcolor=futuresPanelBgColor)
                    row += 1
