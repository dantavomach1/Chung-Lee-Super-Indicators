//@version=6
// Yagami Momentum Matrix -- 5x Slow Stoch + 5x RSI + TTM Squeeze
//
// README:
// - Add this indicator to a lower pane.
// - Use the module toggles to mix Slow Stochastic, RSI, and TTM Squeeze layers.
// - Enable "Use real OHLC" when synthetic chart types should reference the underlying symbol's real bars.
// - Presets are soft overrides because Pine cannot mutate saved input defaults after load.
//
// Changelog:
// - 2026-05-15: Initial legendary multi Stoch/RSI/TTM Squeeze build.
indicator("Yagami Momentum Matrix -- 5x Slow Stoch + 5x RSI + TTM Squeeze", "YMM Stoch/RSI/Squeeze", overlay = false, max_labels_count = 500, max_lines_count = 500, dynamic_requests = true)

// -----------------------------------------------------------------------------
// 2. Global constants
// -----------------------------------------------------------------------------
const string SRC_GLOBAL = "Global source"
const string SRC_CLOSE = "Close"
const string SRC_HL2 = "HL2"
const string SRC_HLC3 = "HLC3"
const string SRC_OHLC4 = "OHLC4"
const string SRC_CUSTOM = "Custom"

const string ST_OHLC_GLOBAL = "Global OHLC"
const string ST_OHLC_MODULE = "Module timeframe OHLC"
const string ST_OHLC_REAL = "Real OHLC if global real OHLC is enabled"

const string MA_SMA = "SMA"
const string MA_EMA = "EMA"
const string MA_RMA = "RMA"
const string MA_SMMA = "SMMA"
const string MA_WMA = "WMA"
const string MA_VWMA = "VWMA"
const string MA_HMA = "HMA"

const string COLOR_STATIC = "Static"
const string COLOR_SLOPE = "Color by slope"
const string COLOR_ZONE = "Color by zone"
const string COLOR_REF = "Color by K above/below D"
const string COLOR_RSI_REF = "Color by RSI above/below signal"

const string LEVEL_8020 = "80/20"
const string LEVEL_7525 = "75/25"
const string LEVEL_7030 = "70/30"
const string LEVEL_CUSTOM = "Custom"

const string PRESET_CUSTOM = "Custom"
const string PRESET_CLASSIC = "Classic Stoch + RSI"
const string PRESET_SCALP = "Fast scalping"
const string PRESET_SWING = "Slow swing"
const string PRESET_SQUEEZE = "Squeeze breakout"
const string PRESET_MINIMAL = "Minimal clean"

const string MOMENTUM_LAZYBEAR = "LazyBear LR"
const string MOMENTUM_ROC = "ROC"
const string MOMENTUM_DIFF_MA = "Diff from MA"

const string H_SCALE_RAW = "Raw"
const string H_SCALE_CENTER = "Scaled to -50 to +50 around 50 baseline"
const string H_SCALE_AUTO = "Auto normalize to 0-100"
const string H_SCALE_FIXED = "Fixed multiplier mode"

const string H_PLACE_CENTER = "Centered on 50"
const string H_PLACE_LOWER = "Lower band around 0-25"
const string H_PLACE_UPPER = "Upper band around 75-100"
const string H_PLACE_RAW = "Raw separate scale"

const string TTF_CHART = "Chart timeframe"
const string TTF_HIGHER = "Higher timeframe"
const string TTF_BOTH = "Both aligned"

// -----------------------------------------------------------------------------
// 3. Helper functions
// -----------------------------------------------------------------------------
var string tableTextSize = size.tiny

f_safe_divide(numerator, denominator, fallback) =>
    na(denominator) or denominator == 0.0 ? fallback : numerator / denominator

f_clamp(value, minValue, maxValue) =>
    math.max(minValue, math.min(maxValue, value))

f_ma(src, len, maType) =>
    int l = math.max(len, 1)
    switch maType
        MA_SMA => ta.sma(src, l)
        MA_EMA => ta.ema(src, l)
        MA_RMA => ta.rma(src, l)
        MA_SMMA => ta.rma(src, l)
        MA_WMA => ta.wma(src, l)
        MA_VWMA => ta.vwma(src, l)
        MA_HMA =>
            int halfLen = math.max(1, int(math.floor(l / 2.0)))
            int sqrtLen = math.max(1, int(math.round(math.sqrt(l))))
            ta.wma(2.0 * ta.wma(src, halfLen) - ta.wma(src, l), sqrtLen)
        => ta.sma(src, l)

f_normalize(src, mode, minVal, maxVal) =>
    float normRange = math.max(maxVal - minVal, 1e-10)
    switch mode
        H_SCALE_RAW => src
        H_SCALE_AUTO => f_clamp(100.0 * (src - minVal) / normRange, 0.0, 100.0)
        H_SCALE_CENTER => f_clamp(100.0 * (src - minVal) / normRange - 50.0, -50.0, 50.0)
        => src

f_color_by_slope_or_zone(baseColor, value, prevValue, upper, lower, refValue, mode, zoneUpperColor, zoneLowerColor, neutralColor) =>
    switch mode
        COLOR_STATIC => baseColor
        COLOR_SLOPE => value >= prevValue ? baseColor : color.new(baseColor, 35)
        COLOR_ZONE => value >= upper ? zoneUpperColor : value <= lower ? zoneLowerColor : neutralColor
        COLOR_REF => value >= refValue ? baseColor : color.new(baseColor, 45)
        COLOR_RSI_REF => value >= refValue ? baseColor : color.new(baseColor, 45)
        => baseColor

f_symbol(useReal) =>
    useReal ? ticker.new(syminfo.prefix, syminfo.ticker) : syminfo.tickerid

f_resolve_tf(moduleTf, globalTf, useGlobalTf) =>
    string tfChoice = useGlobalTf ? globalTf : moduleTf
    tfChoice == "" ? timeframe.period : tfChoice

f_source_expr(sourceKind, customSource) =>
    switch sourceKind
        SRC_CLOSE => close
        SRC_HL2 => hl2
        SRC_HLC3 => hlc3
        SRC_OHLC4 => ohlc4
        SRC_CUSTOM => customSource
        => close

f_requested_source(moduleTf, globalTf, sourceMode, globalSourceKind, globalCustomSource, moduleCustomSource, useReal, allowLookahead) =>
    string tfUse = sourceMode == SRC_GLOBAL ? f_resolve_tf(moduleTf, globalTf, true) : f_resolve_tf(moduleTf, globalTf, false)
    string kindUse = sourceMode == SRC_GLOBAL ? globalSourceKind : sourceMode
    float customUse = sourceMode == SRC_GLOBAL ? globalCustomSource : moduleCustomSource
    float expr = f_source_expr(kindUse, customUse)
    string symbolUse = f_symbol(useReal)
    bool needsRequest = useReal or tfUse != timeframe.period
    needsRequest ? request.security(symbol = symbolUse, timeframe = tfUse, expression = expr, gaps = barmerge.gaps_off, lookahead = allowLookahead ? barmerge.lookahead_on : barmerge.lookahead_off) : expr

f_requested_ohlc(moduleTf, globalTf, sourceMode, useReal, allowLookahead) =>
    string tfUse = sourceMode == ST_OHLC_GLOBAL ? f_resolve_tf(moduleTf, globalTf, true) : f_resolve_tf(moduleTf, globalTf, false)
    string symbolUse = f_symbol(useReal)
    bool needsRequest = useReal or tfUse != timeframe.period
    if needsRequest
        request.security(symbol = symbolUse, timeframe = tfUse, expression = [open, high, low, close], gaps = barmerge.gaps_off, lookahead = allowLookahead ? barmerge.lookahead_on : barmerge.lookahead_off)
    else
        [open, high, low, close]

f_slow_stoch(srcHigh, srcLow, srcClose, length, smoothK, smoothD, maTypeK, maTypeD) =>
    float lowestLow = ta.lowest(srcLow, length)
    float highestHigh = ta.highest(srcHigh, length)
    float rawK = 100.0 * f_safe_divide(srcClose - lowestLow, highestHigh - lowestLow, 0.0)
    float k = f_ma(rawK, smoothK, maTypeK)
    float d = f_ma(k, smoothD, maTypeD)
    [k, d, rawK]

f_rsi(src, length, smoothType, smoothLength) =>
    float base = ta.rsi(src, length)
    float smoothed = smoothLength > 1 ? f_ma(base, smoothLength, smoothType) : base
    smoothed

f_ttm_squeeze(src, srcHigh, srcLow, srcClose, bbLen, bbMult, bbMaType, kcLen, kcMult, kcMaType, useTrueRange, momentumLen, momentumSmooth, momentumSmoothType, momentumMode) =>
    float bbBasis = f_ma(src, bbLen, bbMaType)
    float bbDev = bbMult * ta.stdev(src, bbLen)
    float upperBB = bbBasis + bbDev
    float lowerBB = bbBasis - bbDev

    float kcBasis = f_ma(src, kcLen, kcMaType)
    float rangeSrc = useTrueRange ? ta.tr(true) : srcHigh - srcLow
    float rangeMA = f_ma(rangeSrc, kcLen, kcMaType)
    float upperKC = kcBasis + rangeMA * kcMult
    float lowerKC = kcBasis - rangeMA * kcMult

    bool squeezeOn = lowerBB > lowerKC and upperBB < upperKC
    bool squeezeOff = lowerBB < lowerKC and upperBB > upperKC
    bool noSqueeze = not squeezeOn and not squeezeOff

    float avgHLCS = (ta.highest(srcHigh, momentumLen) + ta.lowest(srcLow, momentumLen) + ta.sma(srcClose, momentumLen)) / 3.0
    float lazyBear = ta.linreg(srcClose - avgHLCS, momentumLen, 0)
    float rocMode = ta.roc(srcClose, momentumLen)
    float diffMaMode = srcClose - f_ma(src, momentumLen, momentumSmoothType)
    float momentumRaw = switch momentumMode
        MOMENTUM_ROC => rocMode
        MOMENTUM_DIFF_MA => diffMaMode
        => lazyBear
    float momentumSmoothOut = momentumSmooth > 1 ? f_ma(momentumRaw, momentumSmooth, momentumSmoothType) : momentumRaw
    float bbWidth = upperBB - lowerBB
    float kcWidth = upperKC - lowerKC
    [squeezeOn, squeezeOff, noSqueeze, momentumRaw, momentumSmoothOut, bbWidth, kcWidth, bbBasis, upperBB, lowerBB, upperKC, lowerKC]

f_state_color(state, active) =>
    color base = switch state
        "OB" => color.red
        "OS" => color.lime
        "Bull" => color.teal
        "Bear" => color.maroon
        "Bull Cross" => color.green
        "Bear Cross" => color.red
        "Squeeze On" => color.orange
        "Squeeze Off" => color.aqua
        "No Squeeze" => color.silver
        "Fired Bull" => color.green
        "Fired Bear" => color.red
        "Strong Bull" => color.lime
        "Strong Bear" => color.red
        "OFF" => color.gray
        "Neutral" => color.gray
        => color.gray
    active ? color.new(base, 0) : color.new(base, 65)

f_fmt_num(value) =>
    na(value) ? "-" : str.tostring(value, "#.##")

f_fmt_int(value) =>
    na(value) ? "-" : str.tostring(value)

f_cross_text(up, down) =>
    up ? "BULL" : down ? "BEAR" : "-"

f_update_last_label(array<label> labelArr, int idx, bool show, float y, string txt, color txtColor, color bgColor) =>
    label lbl = array.get(labelArr, idx)
    if show and not na(y)
        if na(lbl)
            lbl := label.new(bar_index, y, txt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_right, color = bgColor, textcolor = txtColor, size = size.tiny)
            array.set(labelArr, idx, lbl)
        else
            label.set_xy(lbl, bar_index, y)
            label.set_text(lbl, txt)
            label.set_textcolor(lbl, txtColor)
            label.set_color(lbl, bgColor)
    else if not na(lbl)
        label.delete(lbl)
        array.set(labelArr, idx, na)

f_table_cell(tableId, col, row, txt, txtColor, bgColor) =>
    table.cell(tableId, col, row, txt, text_color = txtColor, bgcolor = bgColor, text_halign = text.align_left, text_size = tableTextSize)

f_write_row(tableId, row, name, primary, secondary, state, cross, extra, active, dimInactive) =>
    color textColor = active ? chart.fg_color : color.new(chart.fg_color, dimInactive ? 55 : 25)
    color rowColor = f_state_color(state, active)
    f_table_cell(tableId, 0, row, name, textColor, rowColor)
    f_table_cell(tableId, 1, row, primary, textColor, rowColor)
    f_table_cell(tableId, 2, row, secondary, textColor, rowColor)
    f_table_cell(tableId, 3, row, state, textColor, rowColor)
    f_table_cell(tableId, 4, row, cross, textColor, rowColor)
    f_table_cell(tableId, 5, row, extra, textColor, rowColor)

f_blank_row(tableId, row) =>
    color blankBg = color.new(color.black, 100)
    color blankText = color.new(chart.fg_color, 100)
    f_table_cell(tableId, 0, row, "", blankText, blankBg)
    f_table_cell(tableId, 1, row, "", blankText, blankBg)
    f_table_cell(tableId, 2, row, "", blankText, blankBg)
    f_table_cell(tableId, 3, row, "", blankText, blankBg)
    f_table_cell(tableId, 4, row, "", blankText, blankBg)
    f_table_cell(tableId, 5, row, "", blankText, blankBg)

f_emit_signal_label(show, condition, y, txt, isUp, bgColor, txtColor) =>
    if show and condition and not na(y)
        label.new(bar_index, y, txt, xloc = xloc.bar_index, yloc = yloc.price, style = isUp ? label.style_label_up : label.style_label_down, color = bgColor, textcolor = txtColor, size = size.tiny)

f_calc_stoch(enabled, moduleTf, sourceMode, length, smoothK, smoothD, maTypeK, maTypeD, upper, lower, mid, colorMode, baseKColor, baseDColor, fillBaseColor, lineTransp, fillTransp, globalTf, useReal, allowLookahead, minimalModeFlag) =>
    if enabled
        [_, srcHigh, srcLow, srcClose] = f_requested_ohlc(moduleTf, globalTf, sourceMode, sourceMode == ST_OHLC_REAL ? useReal : false, allowLookahead)
        [k, d, rawK] = f_slow_stoch(srcHigh, srcLow, srcClose, length, smoothK, smoothD, maTypeK, maTypeD)
        bool crossUp = ta.crossover(k, d)
        bool crossDown = ta.crossunder(k, d)
        bool exitOS = ta.crossover(k, lower)
        bool exitOB = ta.crossunder(k, upper)
        bool bullSignal = k > d or exitOS or ta.crossover(k, mid)
        bool bearSignal = k < d or exitOB or ta.crossunder(k, mid)
        string state = k >= upper ? "OB" : k <= lower ? "OS" : k > d ? "Bull" : k < d ? "Bear" : "Neutral"
        color kDyn = f_color_by_slope_or_zone(baseKColor, k, nz(k[1], k), upper, lower, d, colorMode, color.red, color.lime, baseKColor)
        color dDyn = f_color_by_slope_or_zone(baseDColor, d, nz(d[1], d), upper, lower, k, colorMode, color.red, color.lime, baseDColor)
        color fillDyn = color.new(fillBaseColor, fillTransp)
        color bgDyn = minimalModeFlag ? na : state == "OB" ? color.new(color.red, 92) : state == "OS" ? color.new(color.lime, 92) : na
        [k, d, rawK, state, bullSignal, bearSignal, crossUp, crossDown, exitOS, exitOB, color.new(kDyn, lineTransp), color.new(dDyn, lineTransp), fillDyn, bgDyn]
    else
        [na, na, na, "OFF", false, false, false, false, false, false, color.new(baseKColor, 100), color.new(baseDColor, 100), color.new(fillBaseColor, 100), na]

f_calc_rsi(enabled, moduleTf, sourceMode, sourceCustom, length, smoothEnabled, smoothLength, smoothType, signalEnabled, signalLength, signalType, upper, lower, mid, extremeUpper, extremeLower, colorMode, baseRsiColor, baseSignalColor, fillBaseColor, lineTransp, fillTransp, globalTf, globalSourceKind, globalCustomSource, useReal, allowLookahead, minimalModeFlag) =>
    if enabled
        float src = f_requested_source(moduleTf, globalTf, sourceMode, globalSourceKind, globalCustomSource, sourceCustom, useReal, allowLookahead)
        float baseRsi = ta.rsi(src, length)
        float rsi = smoothEnabled ? f_rsi(src, length, smoothType, smoothLength) : baseRsi
        float signal = signalEnabled ? f_ma(rsi, signalLength, signalType) : na
        bool crossAboveSignal = signalEnabled and ta.crossover(rsi, signal)
        bool crossBelowSignal = signalEnabled and ta.crossunder(rsi, signal)
        bool crossAboveLower = ta.crossover(rsi, lower)
        bool crossBelowUpper = ta.crossunder(rsi, upper)
        bool crossAboveMid = ta.crossover(rsi, mid)
        bool crossBelowMid = ta.crossunder(rsi, mid)
        bool enterOB = ta.crossover(rsi, upper)
        bool exitOB = ta.crossunder(rsi, upper)
        bool enterOS = ta.crossunder(rsi, lower)
        bool exitOS = ta.crossover(rsi, lower)
        bool bullSignal = signalEnabled ? (rsi > signal or crossAboveMid or crossAboveLower) : (rsi > mid or crossAboveMid or crossAboveLower)
        bool bearSignal = signalEnabled ? (rsi < signal or crossBelowMid or crossBelowUpper) : (rsi < mid or crossBelowMid or crossBelowUpper)
        string state = rsi >= extremeUpper ? "OB" : rsi <= extremeLower ? "OS" : signalEnabled and rsi > signal ? "Bull" : signalEnabled and rsi < signal ? "Bear" : rsi >= mid ? "Bull" : "Bear"
        float colorRef = signalEnabled ? signal : rsi
        float colorRefPrev = signalEnabled ? nz(signal[1], signal) : nz(rsi[1], rsi)
        color rsiDyn = f_color_by_slope_or_zone(baseRsiColor, rsi, nz(rsi[1], rsi), upper, lower, colorRef, colorMode, color.red, color.lime, baseRsiColor)
        color sigDyn = f_color_by_slope_or_zone(baseSignalColor, nz(signal, rsi), colorRefPrev, upper, lower, rsi, colorMode, color.red, color.lime, baseSignalColor)
        color fillDyn = color.new(fillBaseColor, fillTransp)
        color bgDyn = minimalModeFlag ? na : rsi >= extremeUpper ? color.new(color.red, 92) : rsi <= extremeLower ? color.new(color.lime, 92) : rsi >= upper ? color.new(color.red, 95) : rsi <= lower ? color.new(color.lime, 95) : na
        [rsi, signal, state, bullSignal, bearSignal, crossAboveSignal, crossBelowSignal, crossAboveLower, crossBelowUpper, crossAboveMid, crossBelowMid, enterOB, exitOB, enterOS, exitOS, color.new(rsiDyn, lineTransp), color.new(sigDyn, lineTransp), fillDyn, bgDyn]
    else
        [na, na, "OFF", false, false, false, false, false, false, false, false, false, false, false, false, color.new(baseRsiColor, 100), color.new(baseSignalColor, 100), color.new(fillBaseColor, 100), na]

f_calc_ttm(enabled, moduleTf, sourceMode, sourceCustom, bbLen, bbMult, bbMaType, kcLen, kcMult, kcMaType, useTrueRange, momentumLen, momentumSmooth, momentumSmoothType, momentumMode, histScalingMode, histMultiplier, baseline, placement, globalTf, globalSourceKind, globalCustomSource, useReal, allowLookahead) =>
    if enabled
        float src = f_requested_source(moduleTf, globalTf, sourceMode, globalSourceKind, globalCustomSource, sourceCustom, useReal, allowLookahead)
        string ttmOhlcMode = sourceMode == SRC_GLOBAL ? ST_OHLC_GLOBAL : ST_OHLC_MODULE
        [_, srcHigh, srcLow, srcClose] = f_requested_ohlc(moduleTf, globalTf, ttmOhlcMode, useReal, allowLookahead)
        [squeezeOn, squeezeOff, noSqueeze, momentumRaw, momentumSmoothValue, bbWidth, kcWidth, bbBasis, upperBB, lowerBB, upperKC, lowerKC] = f_ttm_squeeze(src, srcHigh, srcLow, srcClose, bbLen, bbMult, bbMaType, kcLen, kcMult, kcMaType, useTrueRange, momentumLen, momentumSmooth, momentumSmoothType, momentumMode)
        [squeezeOn, squeezeOff, noSqueeze, momentumRaw, momentumSmoothValue, bbWidth, kcWidth, bbBasis, upperBB, lowerBB, upperKC, lowerKC]
    else
        [false, false, false, na, na, na, na, na, na, na, na, na]

f_ttm_display(momentumSmoothValue, momentumLen, histScalingMode, histMultiplier, baseline, placement) =>
    float histAutoLow = ta.lowest(momentumSmoothValue, math.max(5, momentumLen * 2))
    float histAutoHigh = ta.highest(momentumSmoothValue, math.max(5, momentumLen * 2))
    float histNormalized = f_normalize(momentumSmoothValue, H_SCALE_AUTO, histAutoLow, histAutoHigh)
    float histSeries = switch histScalingMode
        H_SCALE_RAW => momentumSmoothValue
        H_SCALE_CENTER => baseline + f_clamp(momentumSmoothValue * histMultiplier, -50.0, 50.0)
        H_SCALE_AUTO => histNormalized
        H_SCALE_FIXED => baseline + momentumSmoothValue * histMultiplier
        => baseline + momentumSmoothValue * histMultiplier
    float placementOffset = switch placement
        H_PLACE_CENTER => 0.0
        H_PLACE_LOWER => -37.5
        H_PLACE_UPPER => 37.5
        H_PLACE_RAW => 0.0
        => 0.0
    float histPlot = histSeries + placementOffset
    float dotY = switch placement
        H_PLACE_LOWER => 12.5
        H_PLACE_UPPER => 87.5
        H_PLACE_RAW => baseline
        => baseline
    [histPlot, dotY]

// -----------------------------------------------------------------------------
// 4. Global source / timeframe inputs
// -----------------------------------------------------------------------------
sourceGroup = "Source / Timeframe"
globalSourceKind = input.string(SRC_CLOSE, "Global source", options = [SRC_CLOSE, SRC_HL2, SRC_HLC3, SRC_OHLC4, SRC_CUSTOM], group = sourceGroup, inline = "gsrc")
globalCustomSource = input.source(close, "Global custom source", group = sourceGroup, inline = "gsrc")
globalTimeframeOverride = input.timeframe("", "Global timeframe override; blank = chart timeframe", group = sourceGroup)
useRealOhlc = input.bool(false, "Use real OHLC on synthetic charts", group = sourceGroup)
allowLookaheadTest = input.bool(false, "Advanced: allow lookahead for testing only", group = sourceGroup, tooltip = "Testing only. This can repaint because it allows future values in security requests.")

// -----------------------------------------------------------------------------
// 5. Global visual / level inputs
// -----------------------------------------------------------------------------
visualGroup = "Levels / Grid"
presetMode = input.string(PRESET_CUSTOM, "Preset mode", options = [PRESET_CUSTOM, PRESET_CLASSIC, PRESET_SCALP, PRESET_SWING, PRESET_SQUEEZE, PRESET_MINIMAL], group = visualGroup)
minimalMode = input.bool(false, "Minimal / Clean Mode", group = visualGroup)
diagnosticMode = input.bool(false, "Diagnostic Mode", group = visualGroup)
showTable = input.bool(true, "Show dashboard table", group = visualGroup)
showOnlyActiveModules = input.bool(true, "Show only active modules in table", group = visualGroup)
dimInactiveModules = input.bool(true, "Dim inactive modules", group = visualGroup)
showRightLabels = input.bool(false, "Show last-value labels on the right", group = visualGroup)
highlightConsensus = input.bool(false, "Highlight strongest oscillator consensus", group = visualGroup)

showGlobalLevels = input.bool(true, "Show global levels", group = visualGroup, inline = "lvl1")
globalLevelPreset = input.string(LEVEL_7525, "Preset", options = [LEVEL_8020, LEVEL_7525, LEVEL_7030, LEVEL_CUSTOM], group = visualGroup, inline = "lvl1")
globalUpperLevelInput = input.float(75.0, "Upper", minval = 0, maxval = 100, group = visualGroup, inline = "lvl2")
globalMiddleLevelInput = input.float(50.0, "Middle", minval = 0, maxval = 100, group = visualGroup, inline = "lvl2")
globalLowerLevelInput = input.float(25.0, "Lower", minval = 0, maxval = 100, group = visualGroup, inline = "lvl2")
showObZone = input.bool(true, "Show overbought zone", group = visualGroup, inline = "lvl3")
showNeutralZone = input.bool(true, "Show neutral zone", group = visualGroup, inline = "lvl3")
showOsZone = input.bool(true, "Show oversold zone", group = visualGroup, inline = "lvl3")
levelUpperColor = input.color(color.new(color.red, 0), "Upper line color", group = visualGroup, inline = "lvl4")
levelMiddleColor = input.color(color.new(color.gray, 0), "Middle line color", group = visualGroup, inline = "lvl4")
levelLowerColor = input.color(color.new(color.lime, 0), "Lower line color", group = visualGroup, inline = "lvl4")
levelLineTransp = input.int(20, "Line transparency", minval = 0, maxval = 100, group = visualGroup, inline = "lvl5")
obZoneColor = input.color(color.new(color.red, 0), "OB zone", group = visualGroup, inline = "lvl5")
neutralZoneColor = input.color(color.new(color.gray, 0), "Neutral zone", group = visualGroup, inline = "lvl5")
osZoneColor = input.color(color.new(color.lime, 0), "OS zone", group = visualGroup, inline = "lvl5")
zoneFillTransp = input.int(92, "Zone transparency", minval = 0, maxval = 100, group = visualGroup, inline = "lvl6")

masterGroup = "Master Toggles"
enableStochastics = input.bool(true, "Enable Stochastics", group = masterGroup)
enableRsis = input.bool(true, "Enable RSIs", group = masterGroup)
enableTtmSqueeze = input.bool(true, "Enable TTM Squeeze", group = masterGroup)

// -----------------------------------------------------------------------------
// 6. Slow Stochastic inputs
// -----------------------------------------------------------------------------
stoch1Group = "Stoch 1"
stoch1Enable = input.bool(true, "Enable", group = stoch1Group, inline = "s1a")
stoch1Timeframe = input.timeframe("", "Timeframe", group = stoch1Group, inline = "s1a")
stoch1SourceMode = input.string(ST_OHLC_GLOBAL, "Source mode", options = [ST_OHLC_GLOBAL, ST_OHLC_MODULE, ST_OHLC_REAL], group = stoch1Group)
stoch1Length = input.int(10, "Length", minval = 1, group = stoch1Group, inline = "s1b")
stoch1SmoothK = input.int(6, "Smooth K", minval = 1, group = stoch1Group, inline = "s1b")
