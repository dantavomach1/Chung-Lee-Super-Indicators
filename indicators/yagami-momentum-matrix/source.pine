confluenceBearColor = input.color(color.red, "Bear color", group = confluenceGroup, inline = "c3")
confluenceMarkerTransp = input.int(0, "Marker transp", minval = 0, maxval = 100, group = confluenceGroup, inline = "c3")

// -----------------------------------------------------------------------------
// 10. Table / label settings
// -----------------------------------------------------------------------------
tableGroup = "Dashboard"
dashboardPosition = input.string("top_right", "Position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = tableGroup)
dashboardTextSize = input.string("tiny", "Text size", options = ["tiny", "small", "normal"], group = tableGroup)

// -----------------------------------------------------------------------------
// 10. Data preparation
// -----------------------------------------------------------------------------
string resolvedGlobalTf = f_resolve_tf("", globalTimeframeOverride, true)
bool presetIsMinimal = presetMode == PRESET_MINIMAL
bool presetIsClassic = presetMode == PRESET_CLASSIC
bool presetIsScalp = presetMode == PRESET_SCALP
bool presetIsSwing = presetMode == PRESET_SWING
bool presetIsSqueeze = presetMode == PRESET_SQUEEZE
bool effectiveMinimalMode = minimalMode or presetIsMinimal
bool effectiveShowLabels = showRightLabels and not effectiveMinimalMode
bool effectiveShowTable = showTable or diagnosticMode
bool effectiveShowConfluence = showConfluenceSignals
bool effectiveShowCompressionBg = ttmShowCompressionBg or presetIsSqueeze
bool effectivePulseBg = ttmPulseBars > 0 and effectiveShowCompressionBg
bool effectiveHighlightConsensus = highlightConsensus or presetIsSqueeze
bool stoch1On = enableStochastics and stoch1Enable
bool stoch2On = enableStochastics and stoch2Enable
bool stoch3On = enableStochastics and stoch3Enable
bool stoch4On = enableStochastics and stoch4Enable
bool stoch5On = enableStochastics and stoch5Enable
bool rsi1On = enableRsis and rsi1Enable
bool rsi2On = enableRsis and rsi2Enable
bool rsi3On = enableRsis and rsi3Enable
bool rsi4On = enableRsis and rsi4Enable
bool rsi5On = enableRsis and rsi5Enable
bool ttmOn = enableTtmSqueeze and ttmEnable

float levelUpper = switch globalLevelPreset
    LEVEL_8020 => 80.0
    LEVEL_7030 => 70.0
    LEVEL_7525 => 75.0
    => globalUpperLevelInput

float levelMiddle = switch globalLevelPreset
    LEVEL_8020 => 50.0
    LEVEL_7030 => 50.0
    LEVEL_7525 => 50.0
    => globalMiddleLevelInput

float levelLower = switch globalLevelPreset
    LEVEL_8020 => 20.0
    LEVEL_7030 => 30.0
    LEVEL_7525 => 25.0
    => globalLowerLevelInput

string tablePos = switch dashboardPosition
    "top_left" => position.top_left
    "bottom_right" => position.bottom_right
    "bottom_left" => position.bottom_left
    => position.top_right

tableTextSize := switch dashboardTextSize
    "small" => size.small
    "normal" => size.normal
    => size.tiny

var table dashboardTbl = table.new(tablePos, 6, 16, frame_color = color.new(color.gray, 70), frame_width = 1, border_color = color.new(color.gray, 80), bgcolor = color.new(color.black, 84))
var array<label> rightLabels = array.new<label>(11)

// Core series requested on the chart timeframe or the user-selected global override.
// These are reused by module blocks when the per-module timeframe is blank.
float chartSourceClose = close
float chartSourceHigh = high
float chartSourceLow = low
float chartSourceOpen = open

