ttmPlacement = input.string(H_PLACE_CENTER, "Vertical placement", options = [H_PLACE_CENTER, H_PLACE_LOWER, H_PLACE_UPPER, H_PLACE_RAW], group = ttmGroup)
// Pine scripts share one lower-pane scale, so "Raw separate scale" is a best-effort offset rather than a true independent axis.
ttmShowHistogram = input.bool(true, "Show histogram", group = ttmGroup, inline = "t1g")
ttmShowDots = input.bool(true, "Show squeeze dots", group = ttmGroup, inline = "t1g")
ttmShowBaseline = input.bool(true, "Show baseline line", group = ttmGroup, inline = "t1g")
ttmShowCompressionBg = input.bool(false, "Show compression background", group = ttmGroup, inline = "t1h")
