ttmTimeframe = input.timeframe("", "Timeframe", group = ttmGroup, inline = "t1a")
ttmSourceMode = input.string(SRC_GLOBAL, "Source", options = [SRC_GLOBAL, SRC_CLOSE, SRC_HL2, SRC_HLC3, SRC_OHLC4, SRC_CUSTOM], group = ttmGroup)
