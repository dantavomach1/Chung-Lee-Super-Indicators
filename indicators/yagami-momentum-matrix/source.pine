[rsi3Value, rsi3SignalValue, rsi3State, rsi3BullSignal, rsi3BearSignal, rsi3CrossAboveSignal, rsi3CrossBelowSignal, rsi3CrossAboveLower, rsi3CrossBelowUpper, rsi3CrossAboveMid, rsi3CrossBelowMid, rsi3EnterOB, rsi3ExitOB, rsi3EnterOS, rsi3ExitOS, rsi3RsiLineColor, rsi3SignalLineColor, rsi3FillPlotColor, rsi3BgColor] = f_calc_rsi(rsi3On, rsi3Timeframe, rsi3SourceMode, rsi3CustomSource, rsi3Length, rsi3SmoothEnabled, rsi3SmoothLength, rsi3SmoothType, rsi3SignalEnabled, rsi3SignalLength, rsi3SignalType, rsi3Upper, rsi3Lower, rsi3Mid, rsi3ExtremeUpper, rsi3ExtremeLower, rsi3ColorMode, rsi3Color, rsi3SignalColor, rsi3FillColor, rsi3LineTransp, rsi3FillTransp, resolvedGlobalTf, globalSourceKind, globalCustomSource, useRealOhlc, allowLookaheadTest, effectiveMinimalMode)
[rsi4Value, rsi4SignalValue, rsi4State, rsi4BullSignal, rsi4BearSignal, rsi4CrossAboveSignal, rsi4CrossBelowSignal, rsi4CrossAboveLower, rsi4CrossBelowUpper, rsi4CrossAboveMid, rsi4CrossBelowMid, rsi4EnterOB, rsi4ExitOB, rsi4EnterOS, rsi4ExitOS, rsi4RsiLineColor, rsi4SignalLineColor, rsi4FillPlotColor, rsi4BgColor] = f_calc_rsi(rsi4On, rsi4Timeframe, rsi4SourceMode, rsi4CustomSource, rsi4Length, rsi4SmoothEnabled, rsi4SmoothLength, rsi4SmoothType, rsi4SignalEnabled, rsi4SignalLength, rsi4SignalType, rsi4Upper, rsi4Lower, rsi4Mid, rsi4ExtremeUpper, rsi4ExtremeLower, rsi4ColorMode, rsi4Color, rsi4SignalColor, rsi4FillColor, rsi4LineTransp, rsi4FillTransp, resolvedGlobalTf, globalSourceKind, globalCustomSource, useRealOhlc, allowLookaheadTest, effectiveMinimalMode)
[rsi5Value, rsi5SignalValue, rsi5State, rsi5BullSignal, rsi5BearSignal, rsi5CrossAboveSignal, rsi5CrossBelowSignal, rsi5CrossAboveLower, rsi5CrossBelowUpper, rsi5CrossAboveMid, rsi5CrossBelowMid, rsi5EnterOB, rsi5ExitOB, rsi5EnterOS, rsi5ExitOS, rsi5RsiLineColor, rsi5SignalLineColor, rsi5FillPlotColor, rsi5BgColor] = f_calc_rsi(rsi5On, rsi5Timeframe, rsi5SourceMode, rsi5CustomSource, rsi5Length, rsi5SmoothEnabled, rsi5SmoothLength, rsi5SmoothType, rsi5SignalEnabled, rsi5SignalLength, rsi5SignalType, rsi5Upper, rsi5Lower, rsi5Mid, rsi5ExtremeUpper, rsi5ExtremeLower, rsi5ColorMode, rsi5Color, rsi5SignalColor, rsi5FillColor, rsi5LineTransp, rsi5FillTransp, resolvedGlobalTf, globalSourceKind, globalCustomSource, useRealOhlc, allowLookaheadTest, effectiveMinimalMode)

// -----------------------------------------------------------------------------
// 13. TTM calculations
// -----------------------------------------------------------------------------
[ttmSqOnChart, ttmSqOffChart, ttmNoSqChart, ttmMomRawChart, ttmMomSmoothChart, ttmBbWidthChart, ttmKcWidthChart, ttmBbBasisChart, ttmUpperBBChart, ttmLowerBBChart, ttmUpperKCChart, ttmLowerKCChart] = f_calc_ttm(ttmOn, ttmTimeframe, ttmSourceMode, ttmCustomSource, ttmBbLen, ttmBbMult, ttmBbMaType, ttmKcLen, ttmKcMult, ttmKcMaType, ttmUseTrueRange, ttmMomentumLen, ttmMomentumSmoothLen, ttmMomentumSmoothType, ttmMomentumMode, ttmHistogramScaling, ttmHistogramMultiplier, ttmBaseline, ttmPlacement, resolvedGlobalTf, globalSourceKind, globalCustomSource, useRealOhlc, allowLookaheadTest)

string ttmSourceKindResolved = ttmSourceMode == SRC_GLOBAL ? globalSourceKind : ttmSourceMode
float ttmCustomResolved = ttmSourceMode == SRC_GLOBAL ? globalCustomSource : ttmCustomSource
bool ttmNeedHtf = ttmOn and ttmMtfMode != TTF_CHART and ttmHigherTf != ""
bool ttmUseHtfOnly = ttmMtfMode == TTF_HIGHER
bool ttmUseBoth = ttmMtfMode == TTF_BOTH
[ttmSqOnHtf, ttmSqOffHtf, ttmNoSqHtf, ttmHigherMomRaw, ttmHigherMomSmooth, ttmHigherBbWidth, ttmHigherKcWidth, _, _, _, _, _] = if ttmNeedHtf
    request.security(symbol = f_symbol(useRealOhlc), timeframe = ttmHigherTf, expression = f_ttm_squeeze(f_source_expr(ttmSourceKindResolved, ttmCustomResolved), high, low, close, ttmBbLen, ttmBbMult, ttmBbMaType, ttmKcLen, ttmKcMult, ttmKcMaType, ttmUseTrueRange, ttmMomentumLen, ttmMomentumSmoothLen, ttmMomentumSmoothType, ttmMomentumMode), gaps = barmerge.gaps_off, lookahead = allowLookaheadTest ? barmerge.lookahead_on : barmerge.lookahead_off)
else
    [false, false, false, na, na, na, na, na, na, na, na, na]

bool ttmSelectedSqOn = ttmUseHtfOnly and ttmNeedHtf ? ttmSqOnHtf : ttmUseBoth and ttmNeedHtf ? (ttmSqOnChart and ttmSqOnHtf) : ttmSqOnChart
bool ttmSelectedSqOff = ttmUseHtfOnly and ttmNeedHtf ? ttmSqOffHtf : ttmUseBoth and ttmNeedHtf ? (ttmSqOffChart and ttmSqOffHtf) : ttmSqOffChart
bool ttmSelectedNoSq = not ttmSelectedSqOn and not ttmSelectedSqOff
float ttmSelectedMomRaw = ttmUseHtfOnly and ttmNeedHtf ? ttmHigherMomRaw : ttmMomRawChart
float ttmSelectedMomSmooth = ttmUseHtfOnly and ttmNeedHtf ? ttmHigherMomSmooth : ttmMomSmoothChart
float ttmSelectedBbWidth = ttmUseHtfOnly and ttmNeedHtf ? ttmHigherBbWidth : ttmBbWidthChart
float ttmSelectedKcWidth = ttmUseHtfOnly and ttmNeedHtf ? ttmHigherKcWidth : ttmKcWidthChart
float ttmDisplayBaseline = ttmHistogramScaling == H_SCALE_RAW ? 0.0 : ttmBaseline
[ttmHistPlot, ttmDotY] = f_ttm_display(ttmSelectedMomSmooth, ttmMomentumLen, ttmHistogramScaling, ttmHistogramMultiplier, ttmDisplayBaseline, ttmPlacement)
color ttmHistRawColor = ttmSelectedMomSmooth >= ttmDisplayBaseline ? (ttmSelectedMomSmooth > nz(ttmSelectedMomSmooth[1], ttmSelectedMomSmooth) ? ttmHistPosRiseColor : ttmHistPosFallColor) : (ttmSelectedMomSmooth < nz(ttmSelectedMomSmooth[1], ttmSelectedMomSmooth) ? ttmHistNegFallColor : ttmHistNegRiseColor)
color ttmHistPlotColor = color.new(ttmHistRawColor, ttmHistTransp)
color ttmDotPlotColor = ttmSelectedSqOn ? ttmDotOnColor : ttmSelectedSqOff ? ttmDotOffColor : ttmDotNoneColor
bool ttmPrevSqOn = ttmSelectedSqOn[1]
bool ttmSqueezeStart = ttmSelectedSqOn and not ttmPrevSqOn
bool ttmSqueezeRelease = not ttmSelectedSqOn and ttmPrevSqOn
bool ttmFireBull = ttmSqueezeRelease and ttmSelectedMomSmooth > ttmDisplayBaseline
bool ttmFireBear = ttmSqueezeRelease and ttmSelectedMomSmooth < ttmDisplayBaseline
float ttmCompressionHeat = ttmSelectedKcWidth > 0.0 ? f_clamp(100.0 * (1.0 - ttmSelectedBbWidth / ttmSelectedKcWidth), 0.0, 100.0) : 0.0
var int ttmDurationBars = 0
ttmDurationBars := ttmOn and ttmSelectedSqOn ? nz(ttmDurationBars[1]) + 1 : 0
int ttmBarsSinceRelease = ta.barssince(ttmSqueezeRelease)
string ttmState = ttmSelectedSqOn ? "Squeeze On" : ttmFireBull ? "Fired Bull" : ttmFireBear ? "Fired Bear" : ttmSelectedSqOff ? "Squeeze Off" : "No Squeeze"

// -----------------------------------------------------------------------------
// 14. Plotting
// -----------------------------------------------------------------------------
// Pine plots do not support a true dashed/styled line API. Width and alpha
// controls are used instead, which keeps the chart readable and avoids hacks.

// Global levels and soft oscillator grid.
pUpper = plot(showGlobalLevels ? levelUpper : na, title = "Upper", color = color.new(levelUpperColor, levelLineTransp), linewidth = 1)
pMiddle = plot(showGlobalLevels ? levelMiddle : na, title = "Middle", color = color.new(levelMiddleColor, levelLineTransp), linewidth = 1)
pLower = plot(showGlobalLevels ? levelLower : na, title = "Lower", color = color.new(levelLowerColor, levelLineTransp), linewidth = 1)

// Stochastic modules.
pStoch1K = plot(stoch1On and stoch1PlotK ? stoch1K : na, title = "Stoch 1 K", color = stoch1KLineColor, linewidth = stoch1KWidth, style = plot.style_line)
pStoch1D = plot(stoch1On and stoch1PlotD ? stoch1D : na, title = "Stoch 1 D", color = stoch1DLineColor, linewidth = stoch1DWidth, style = plot.style_line)

pStoch2K = plot(stoch2On and stoch2PlotK ? stoch2K : na, title = "Stoch 2 K", color = stoch2KLineColor, linewidth = stoch2KWidth, style = plot.style_line)
pStoch2D = plot(stoch2On and stoch2PlotD ? stoch2D : na, title = "Stoch 2 D", color = stoch2DLineColor, linewidth = stoch2DWidth, style = plot.style_line)

pStoch3K = plot(stoch3On and stoch3PlotK ? stoch3K : na, title = "Stoch 3 K", color = stoch3KLineColor, linewidth = stoch3KWidth, style = plot.style_line)
pStoch3D = plot(stoch3On and stoch3PlotD ? stoch3D : na, title = "Stoch 3 D", color = stoch3DLineColor, linewidth = stoch3DWidth, style = plot.style_line)

pStoch4K = plot(stoch4On and stoch4PlotK ? stoch4K : na, title = "Stoch 4 K", color = stoch4KLineColor, linewidth = stoch4KWidth, style = plot.style_line)
pStoch4D = plot(stoch4On and stoch4PlotD ? stoch4D : na, title = "Stoch 4 D", color = stoch4DLineColor, linewidth = stoch4DWidth, style = plot.style_line)

pStoch5K = plot(stoch5On and stoch5PlotK ? stoch5K : na, title = "Stoch 5 K", color = stoch5KLineColor, linewidth = stoch5KWidth, style = plot.style_line)
pStoch5D = plot(stoch5On and stoch5PlotD ? stoch5D : na, title = "Stoch 5 D", color = stoch5DLineColor, linewidth = stoch5DWidth, style = plot.style_line)

// RSI modules.
pRsi1 = plot(rsi1On and rsi1Plot ? rsi1Value : na, title = "RSI 1", color = rsi1RsiLineColor, linewidth = rsi1Width, style = plot.style_line)
pRsi1Sig = plot(rsi1On and rsi1PlotSignal ? rsi1SignalValue : na, title = "RSI 1 Signal", color = rsi1SignalLineColor, linewidth = rsi1SignalWidth, style = plot.style_line)

pRsi2 = plot(rsi2On and rsi2Plot ? rsi2Value : na, title = "RSI 2", color = rsi2RsiLineColor, linewidth = rsi2Width, style = plot.style_line)
pRsi2Sig = plot(rsi2On and rsi2PlotSignal ? rsi2SignalValue : na, title = "RSI 2 Signal", color = rsi2SignalLineColor, linewidth = rsi2SignalWidth, style = plot.style_line)

pRsi3 = plot(rsi3On and rsi3Plot ? rsi3Value : na, title = "RSI 3", color = rsi3RsiLineColor, linewidth = rsi3Width, style = plot.style_line)
pRsi3Sig = plot(rsi3On and rsi3PlotSignal ? rsi3SignalValue : na, title = "RSI 3 Signal", color = rsi3SignalLineColor, linewidth = rsi3SignalWidth, style = plot.style_line)

pRsi4 = plot(rsi4On and rsi4Plot ? rsi4Value : na, title = "RSI 4", color = rsi4RsiLineColor, linewidth = rsi4Width, style = plot.style_line)
pRsi4Sig = plot(rsi4On and rsi4PlotSignal ? rsi4SignalValue : na, title = "RSI 4 Signal", color = rsi4SignalLineColor, linewidth = rsi4SignalWidth, style = plot.style_line)

pRsi5 = plot(rsi5On and rsi5Plot ? rsi5Value : na, title = "RSI 5", color = rsi5RsiLineColor, linewidth = rsi5Width, style = plot.style_line)
pRsi5Sig = plot(rsi5On and rsi5PlotSignal ? rsi5SignalValue : na, title = "RSI 5 Signal", color = rsi5SignalLineColor, linewidth = rsi5SignalWidth, style = plot.style_line)

// TTM squeeze histogram, dots, and squeeze-release labels.
plot(ttmOn and ttmShowBaseline ? ttmDisplayBaseline : na, title = "TTM Baseline", color = color.new(color.gray, 60), linewidth = 1)
plot(ttmOn and ttmShowHistogram ? ttmHistPlot : na, title = "TTM Histogram", style = plot.style_columns, color = ttmHistPlotColor, linewidth = 2)
plot(ttmOn and ttmShowDots ? ttmDotY : na, title = "TTM Squeeze Dots", style = plot.style_circles, color = ttmDotPlotColor, linewidth = 4)

// Confluence engine and consensus highlight.
int stochBullCount = (stoch1On and stoch1BullSignal ? 1 : 0) + (stoch2On and stoch2BullSignal ? 1 : 0) + (stoch3On and stoch3BullSignal ? 1 : 0) + (stoch4On and stoch4BullSignal ? 1 : 0) + (stoch5On and stoch5BullSignal ? 1 : 0)
int stochBearCount = (stoch1On and stoch1BearSignal ? 1 : 0) + (stoch2On and stoch2BearSignal ? 1 : 0) + (stoch3On and stoch3BearSignal ? 1 : 0) + (stoch4On and stoch4BearSignal ? 1 : 0) + (stoch5On and stoch5BearSignal ? 1 : 0)
int rsiBullCount = (rsi1On and rsi1BullSignal ? 1 : 0) + (rsi2On and rsi2BullSignal ? 1 : 0) + (rsi3On and rsi3BullSignal ? 1 : 0) + (rsi4On and rsi4BullSignal ? 1 : 0) + (rsi5On and rsi5BullSignal ? 1 : 0)
int rsiBearCount = (rsi1On and rsi1BearSignal ? 1 : 0) + (rsi2On and rsi2BearSignal ? 1 : 0) + (rsi3On and rsi3BearSignal ? 1 : 0) + (rsi4On and rsi4BearSignal ? 1 : 0) + (rsi5On and rsi5BearSignal ? 1 : 0)
int consensusScore = stochBullCount + rsiBullCount - stochBearCount - rsiBearCount
bool bullConfluence = effectiveShowConfluence and stochBullCount >= bullStochRequired and rsiBullCount >= bullRsiRequired and (not requireBullTtmFire or ttmFireBull)
bool bearConfluence = effectiveShowConfluence and stochBearCount >= bearStochRequired and rsiBearCount >= bearRsiRequired and (not requireBearTtmFire or ttmFireBear)
color stochBgActive = stoch1On and stoch1ShowBg and not effectiveMinimalMode and not na(stoch1BgColor) ? stoch1BgColor : stoch2On and stoch2ShowBg and not effectiveMinimalMode and not na(stoch2BgColor) ? stoch2BgColor : stoch3On and stoch3ShowBg and not effectiveMinimalMode and not na(stoch3BgColor) ? stoch3BgColor : stoch4On and stoch4ShowBg and not effectiveMinimalMode and not na(stoch4BgColor) ? stoch4BgColor : stoch5On and stoch5ShowBg and not effectiveMinimalMode and not na(stoch5BgColor) ? stoch5BgColor : na
color rsiBgActive = rsi1On and rsi1ShowBg and not effectiveMinimalMode and not na(rsi1BgColor) ? rsi1BgColor : rsi2On and rsi2ShowBg and not effectiveMinimalMode and not na(rsi2BgColor) ? rsi2BgColor : rsi3On and rsi3ShowBg and not effectiveMinimalMode and not na(rsi3BgColor) ? rsi3BgColor : rsi4On and rsi4ShowBg and not effectiveMinimalMode and not na(rsi4BgColor) ? rsi4BgColor : rsi5On and rsi5ShowBg and not effectiveMinimalMode and not na(rsi5BgColor) ? rsi5BgColor : na
color compressionBg = ttmOn and effectiveShowCompressionBg and ttmSelectedSqOn ? color.new(ttmPulseColor, ttmPulseTransp) : na
color pulseBg = ttmOn and effectivePulseBg and ta.barssince(ttmSqueezeRelease) <= ttmPulseBars ? color.new(ttmPulseColor, ttmPulseTransp) : na
color consensusBg = effectiveHighlightConsensus and consensusScore >= 4 ? color.new(color.lime, 94) : effectiveHighlightConsensus and consensusScore <= -4 ? color.new(color.red, 94) : na
color compositeBg = not na(consensusBg) ? consensusBg : not na(pulseBg) ? pulseBg : not na(compressionBg) ? compressionBg : not na(stochBgActive) ? stochBgActive : rsiBgActive
bgcolor(compositeBg)
f_emit_signal_label(stoch1On and stoch1ShowMarkers and not effectiveMinimalMode, stoch1CrossUp, stoch1K, "S1", true, stoch1KLineColor, color.white)
f_emit_signal_label(stoch1On and stoch1ShowMarkers and not effectiveMinimalMode, stoch1CrossDown, stoch1K, "S1", false, stoch1DLineColor, color.white)
f_emit_signal_label(stoch2On and stoch2ShowMarkers and not effectiveMinimalMode, stoch2CrossUp, stoch2K, "S2", true, stoch2KLineColor, color.white)
f_emit_signal_label(stoch2On and stoch2ShowMarkers and not effectiveMinimalMode, stoch2CrossDown, stoch2K, "S2", false, stoch2DLineColor, color.white)
f_emit_signal_label(stoch3On and stoch3ShowMarkers and not effectiveMinimalMode, stoch3CrossUp, stoch3K, "S3", true, stoch3KLineColor, color.white)
f_emit_signal_label(stoch3On and stoch3ShowMarkers and not effectiveMinimalMode, stoch3CrossDown, stoch3K, "S3", false, stoch3DLineColor, color.white)
f_emit_signal_label(stoch4On and stoch4ShowMarkers and not effectiveMinimalMode, stoch4CrossUp, stoch4K, "S4", true, stoch4KLineColor, color.white)
f_emit_signal_label(stoch4On and stoch4ShowMarkers and not effectiveMinimalMode, stoch4CrossDown, stoch4K, "S4", false, stoch4DLineColor, color.white)
f_emit_signal_label(stoch5On and stoch5ShowMarkers and not effectiveMinimalMode, stoch5CrossUp, stoch5K, "S5", true, stoch5KLineColor, color.white)
f_emit_signal_label(stoch5On and stoch5ShowMarkers and not effectiveMinimalMode, stoch5CrossDown, stoch5K, "S5", false, stoch5DLineColor, color.white)
f_emit_signal_label(rsi1On and rsi1ShowMarkers and not effectiveMinimalMode, rsi1CrossAboveSignal, rsi1Value, "R1", true, rsi1RsiLineColor, color.white)
f_emit_signal_label(rsi1On and rsi1ShowMarkers and not effectiveMinimalMode, rsi1CrossBelowSignal, rsi1Value, "R1", false, rsi1SignalLineColor, color.white)
f_emit_signal_label(rsi2On and rsi2ShowMarkers and not effectiveMinimalMode, rsi2CrossAboveSignal, rsi2Value, "R2", true, rsi2RsiLineColor, color.white)
f_emit_signal_label(rsi2On and rsi2ShowMarkers and not effectiveMinimalMode, rsi2CrossBelowSignal, rsi2Value, "R2", false, rsi2SignalLineColor, color.white)
f_emit_signal_label(rsi3On and rsi3ShowMarkers and not effectiveMinimalMode, rsi3CrossAboveSignal, rsi3Value, "R3", true, rsi3RsiLineColor, color.white)
f_emit_signal_label(rsi3On and rsi3ShowMarkers and not effectiveMinimalMode, rsi3CrossBelowSignal, rsi3Value, "R3", false, rsi3SignalLineColor, color.white)
f_emit_signal_label(rsi4On and rsi4ShowMarkers and not effectiveMinimalMode, rsi4CrossAboveSignal, rsi4Value, "R4", true, rsi4RsiLineColor, color.white)
f_emit_signal_label(rsi4On and rsi4ShowMarkers and not effectiveMinimalMode, rsi4CrossBelowSignal, rsi4Value, "R4", false, rsi4SignalLineColor, color.white)
f_emit_signal_label(rsi5On and rsi5ShowMarkers and not effectiveMinimalMode, rsi5CrossAboveSignal, rsi5Value, "R5", true, rsi5RsiLineColor, color.white)
f_emit_signal_label(rsi5On and rsi5ShowMarkers and not effectiveMinimalMode, rsi5CrossBelowSignal, rsi5Value, "R5", false, rsi5SignalLineColor, color.white)
f_emit_signal_label(ttmOn and ttmShowReleaseLabels, ttmFireBull, ttmDotY, "BULL", true, ttmDotOnColor, color.white)
f_emit_signal_label(ttmOn and ttmShowReleaseLabels, ttmFireBear, ttmDotY, "BEAR", false, ttmDotOffColor, color.white)

// -----------------------------------------------------------------------------
// 15. Table / dashboard
// -----------------------------------------------------------------------------
if barstate.islast
    if effectiveShowTable
        f_table_cell(dashboardTbl, 0, 0, "Module", chart.fg_color, color.new(color.black, 65))
        f_table_cell(dashboardTbl, 1, 0, "Value 1", chart.fg_color, color.new(color.black, 65))
        f_table_cell(dashboardTbl, 2, 0, "Value 2", chart.fg_color, color.new(color.black, 65))
        f_table_cell(dashboardTbl, 3, 0, "State", chart.fg_color, color.new(color.black, 65))
        f_table_cell(dashboardTbl, 4, 0, "Cross", chart.fg_color, color.new(color.black, 65))
        f_table_cell(dashboardTbl, 5, 0, "Extra", chart.fg_color, color.new(color.black, 65))

        int dashRow = 1
        if stoch1Enable or not showOnlyActiveModules
            string stoch1TableState = stoch1Enable ? (stoch1CrossUp ? "Bull Cross" : stoch1CrossDown ? "Bear Cross" : stoch1State) : "OFF"
            string stoch1Extra = stoch1Enable ? "raw " + f_fmt_num(stoch1Raw) : "disabled"
            f_write_row(dashboardTbl, dashRow, "S1", stoch1Enable ? f_fmt_num(stoch1K) : "-", stoch1Enable ? f_fmt_num(stoch1D) : "-", stoch1TableState, f_cross_text(stoch1CrossUp, stoch1CrossDown), stoch1Extra, stoch1Enable, dimInactiveModules)
            dashRow += 1
        if stoch2Enable or not showOnlyActiveModules
            string stoch2TableState = stoch2Enable ? (stoch2CrossUp ? "Bull Cross" : stoch2CrossDown ? "Bear Cross" : stoch2State) : "OFF"
            string stoch2Extra = stoch2Enable ? "raw " + f_fmt_num(stoch2Raw) : "disabled"
            f_write_row(dashboardTbl, dashRow, "S2", stoch2Enable ? f_fmt_num(stoch2K) : "-", stoch2Enable ? f_fmt_num(stoch2D) : "-", stoch2TableState, f_cross_text(stoch2CrossUp, stoch2CrossDown), stoch2Extra, stoch2Enable, dimInactiveModules)
            dashRow += 1
        if stoch3Enable or not showOnlyActiveModules
            string stoch3TableState = stoch3Enable ? (stoch3CrossUp ? "Bull Cross" : stoch3CrossDown ? "Bear Cross" : stoch3State) : "OFF"
            string stoch3Extra = stoch3Enable ? "raw " + f_fmt_num(stoch3Raw) : "disabled"
            f_write_row(dashboardTbl, dashRow, "S3", stoch3Enable ? f_fmt_num(stoch3K) : "-", stoch3Enable ? f_fmt_num(stoch3D) : "-", stoch3TableState, f_cross_text(stoch3CrossUp, stoch3CrossDown), stoch3Extra, stoch3Enable, dimInactiveModules)
            dashRow += 1
        if stoch4Enable or not showOnlyActiveModules
            string stoch4TableState = stoch4Enable ? (stoch4CrossUp ? "Bull Cross" : stoch4CrossDown ? "Bear Cross" : stoch4State) : "OFF"
            string stoch4Extra = stoch4Enable ? "raw " + f_fmt_num(stoch4Raw) : "disabled"
            f_write_row(dashboardTbl, dashRow, "S4", stoch4Enable ? f_fmt_num(stoch4K) : "-", stoch4Enable ? f_fmt_num(stoch4D) : "-", stoch4TableState, f_cross_text(stoch4CrossUp, stoch4CrossDown), stoch4Extra, stoch4Enable, dimInactiveModules)
            dashRow += 1
        if stoch5Enable or not showOnlyActiveModules
            string stoch5TableState = stoch5Enable ? (stoch5CrossUp ? "Bull Cross" : stoch5CrossDown ? "Bear Cross" : stoch5State) : "OFF"
            string stoch5Extra = stoch5Enable ? "raw " + f_fmt_num(stoch5Raw) : "disabled"
            f_write_row(dashboardTbl, dashRow, "S5", stoch5Enable ? f_fmt_num(stoch5K) : "-", stoch5Enable ? f_fmt_num(stoch5D) : "-", stoch5TableState, f_cross_text(stoch5CrossUp, stoch5CrossDown), stoch5Extra, stoch5Enable, dimInactiveModules)
            dashRow += 1

        if rsi1Enable or not showOnlyActiveModules
            string rsi1TableState = rsi1Enable ? (rsi1CrossAboveSignal ? "Bull Cross" : rsi1CrossBelowSignal ? "Bear Cross" : rsi1State) : "OFF"
            string rsi1Extra = rsi1Enable ? "ext " + f_fmt_num(rsi1ExtremeUpper) + "/" + f_fmt_num(rsi1ExtremeLower) : "disabled"
            f_write_row(dashboardTbl, dashRow, "R1", rsi1Enable ? f_fmt_num(rsi1Value) : "-", rsi1Enable ? f_fmt_num(rsi1SignalValue) : "-", rsi1TableState, f_cross_text(rsi1CrossAboveSignal, rsi1CrossBelowSignal), rsi1Extra, rsi1Enable, dimInactiveModules)
            dashRow += 1
        if rsi2Enable or not showOnlyActiveModules
            string rsi2TableState = rsi2Enable ? (rsi2CrossAboveSignal ? "Bull Cross" : rsi2CrossBelowSignal ? "Bear Cross" : rsi2State) : "OFF"
            string rsi2Extra = rsi2Enable ? "ext " + f_fmt_num(rsi2ExtremeUpper) + "/" + f_fmt_num(rsi2ExtremeLower) : "disabled"
            f_write_row(dashboardTbl, dashRow, "R2", rsi2Enable ? f_fmt_num(rsi2Value) : "-", rsi2Enable ? f_fmt_num(rsi2SignalValue) : "-", rsi2TableState, f_cross_text(rsi2CrossAboveSignal, rsi2CrossBelowSignal), rsi2Extra, rsi2Enable, dimInactiveModules)
            dashRow += 1
        if rsi3Enable or not showOnlyActiveModules
            string rsi3TableState = rsi3Enable ? (rsi3CrossAboveSignal ? "Bull Cross" : rsi3CrossBelowSignal ? "Bear Cross" : rsi3State) : "OFF"
            string rsi3Extra = rsi3Enable ? "ext " + f_fmt_num(rsi3ExtremeUpper) + "/" + f_fmt_num(rsi3ExtremeLower) : "disabled"
            f_write_row(dashboardTbl, dashRow, "R3", rsi3Enable ? f_fmt_num(rsi3Value) : "-", rsi3Enable ? f_fmt_num(rsi3SignalValue) : "-", rsi3TableState, f_cross_text(rsi3CrossAboveSignal, rsi3CrossBelowSignal), rsi3Extra, rsi3Enable, dimInactiveModules)
            dashRow += 1
        if rsi4Enable or not showOnlyActiveModules
            string rsi4TableState = rsi4Enable ? (rsi4CrossAboveSignal ? "Bull Cross" : rsi4CrossBelowSignal ? "Bear Cross" : rsi4State) : "OFF"
            string rsi4Extra = rsi4Enable ? "ext " + f_fmt_num(rsi4ExtremeUpper) + "/" + f_fmt_num(rsi4ExtremeLower) : "disabled"
            f_write_row(dashboardTbl, dashRow, "R4", rsi4Enable ? f_fmt_num(rsi4Value) : "-", rsi4Enable ? f_fmt_num(rsi4SignalValue) : "-", rsi4TableState, f_cross_text(rsi4CrossAboveSignal, rsi4CrossBelowSignal), rsi4Extra, rsi4Enable, dimInactiveModules)
            dashRow += 1
        if rsi5Enable or not showOnlyActiveModules
            string rsi5TableState = rsi5Enable ? (rsi5CrossAboveSignal ? "Bull Cross" : rsi5CrossBelowSignal ? "Bear Cross" : rsi5State) : "OFF"
            string rsi5Extra = rsi5Enable ? "ext " + f_fmt_num(rsi5ExtremeUpper) + "/" + f_fmt_num(rsi5ExtremeLower) : "disabled"
            f_write_row(dashboardTbl, dashRow, "R5", rsi5Enable ? f_fmt_num(rsi5Value) : "-", rsi5Enable ? f_fmt_num(rsi5SignalValue) : "-", rsi5TableState, f_cross_text(rsi5CrossAboveSignal, rsi5CrossBelowSignal), rsi5Extra, rsi5Enable, dimInactiveModules)
            dashRow += 1

        if ttmShowInDashboard or diagnosticMode
            string ttmCrossTxt = ttmFireBull ? "FIRE BULL" : ttmFireBear ? "FIRE BEAR" : ttmSelectedSqOn ? "ON" : ttmSelectedSqOff ? "OFF" : "-"
            string ttmCounterText = ttmShowDurationCounter ? " / dur " + f_fmt_int(ttmDurationBars) + " / since " + f_fmt_int(ttmBarsSinceRelease) : ""
            string ttmExtra = "heat " + f_fmt_num(ttmCompressionHeat) + "%" + ttmCounterText
            f_write_row(dashboardTbl, dashRow, "TTM", f_fmt_num(ttmSelectedMomSmooth), f_fmt_num(ttmSelectedMomRaw), ttmState, ttmCrossTxt, ttmExtra, ttmEnable, dimInactiveModules)
            dashRow += 1

        string consensusState = consensusScore >= 4 ? "Strong Bull" : consensusScore <= -4 ? "Strong Bear" : consensusScore > 0 ? "Bull" : consensusScore < 0 ? "Bear" : "Neutral"
        f_write_row(dashboardTbl, dashRow, "Consensus", str.tostring(consensusScore), "S" + str.tostring(stochBullCount - stochBearCount) + " / R" + str.tostring(rsiBullCount - rsiBearCount), consensusState, bullConfluence ? "BULL" : bearConfluence ? "BEAR" : "-", "TTM fire " + (ttmFireBull ? "bull" : ttmFireBear ? "bear" : "none"), true, dimInactiveModules)
        dashRow += 1

        while dashRow < 16
            f_blank_row(dashboardTbl, dashRow)
            dashRow += 1
    else
        int blankRow = 0
        while blankRow < 16
            f_blank_row(dashboardTbl, blankRow)
            blankRow += 1

    // Right-side labels are updated only on the last bar so they do not spam objects.
    if effectiveShowLabels
        f_update_last_label(rightLabels, 0, stoch1Enable, stoch1K, "S1 K " + f_fmt_num(stoch1K) + " / D " + f_fmt_num(stoch1D), color.white, stoch1KLineColor)
        f_update_last_label(rightLabels, 1, stoch2Enable, stoch2K, "S2 K " + f_fmt_num(stoch2K) + " / D " + f_fmt_num(stoch2D), color.white, stoch2KLineColor)
        f_update_last_label(rightLabels, 2, stoch3Enable, stoch3K, "S3 K " + f_fmt_num(stoch3K) + " / D " + f_fmt_num(stoch3D), color.white, stoch3KLineColor)
        f_update_last_label(rightLabels, 3, stoch4Enable, stoch4K, "S4 K " + f_fmt_num(stoch4K) + " / D " + f_fmt_num(stoch4D), color.white, stoch4KLineColor)
        f_update_last_label(rightLabels, 4, stoch5Enable, stoch5K, "S5 K " + f_fmt_num(stoch5K) + " / D " + f_fmt_num(stoch5D), color.white, stoch5KLineColor)
        f_update_last_label(rightLabels, 5, rsi1Enable, rsi1Value, "R1 " + f_fmt_num(rsi1Value) + " / S " + f_fmt_num(rsi1SignalValue), color.white, rsi1RsiLineColor)
        f_update_last_label(rightLabels, 6, rsi2Enable, rsi2Value, "R2 " + f_fmt_num(rsi2Value) + " / S " + f_fmt_num(rsi2SignalValue), color.white, rsi2RsiLineColor)
        f_update_last_label(rightLabels, 7, rsi3Enable, rsi3Value, "R3 " + f_fmt_num(rsi3Value) + " / S " + f_fmt_num(rsi3SignalValue), color.white, rsi3RsiLineColor)
        f_update_last_label(rightLabels, 8, rsi4Enable, rsi4Value, "R4 " + f_fmt_num(rsi4Value) + " / S " + f_fmt_num(rsi4SignalValue), color.white, rsi4RsiLineColor)
        f_update_last_label(rightLabels, 9, rsi5Enable, rsi5Value, "R5 " + f_fmt_num(rsi5Value) + " / S " + f_fmt_num(rsi5SignalValue), color.white, rsi5RsiLineColor)
        f_update_last_label(rightLabels, 10, ttmEnable, ttmHistPlot, "TTM " + f_fmt_num(ttmSelectedMomSmooth) + " / " + (ttmSelectedSqOn ? "ON" : ttmSelectedSqOff ? "OFF" : "NONE") + (ttmShowDurationCounter ? " / dur " + f_fmt_int(ttmDurationBars) : ""), color.white, ttmDotPlotColor)
    else
        int labelIdx = 0
        while labelIdx < 11
            f_update_last_label(rightLabels, labelIdx, false, na, "", color.white, color.new(color.black, 100))
            labelIdx += 1
