ttmHistPosFallColor = input.color(color.aqua, "Positive falling", group = ttmGroup, inline = "t1j")
ttmHistNegFallColor = input.color(color.red, "Negative falling", group = ttmGroup, inline = "t1j")
ttmHistNegRiseColor = input.color(color.orange, "Negative rising", group = ttmGroup, inline = "t1j")
ttmHistTransp = input.int(0, "Histogram transp", minval = 0, maxval = 100, group = ttmGroup, inline = "t1k")
